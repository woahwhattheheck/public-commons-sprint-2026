{
  "schema": "commons.pmrs-cloud-native-contract.v1",
  "command": {
    "required": [
      "id",
      "kind",
      "arguments"
    ],
    "id": "canonical UUIDv4",
    "digest": "sha256(original pmrs.canonical.wire UTF-8)",
    "kinds": {
      "capture": [
        "connection",
        "profile"
      ],
      "mapping": [
        "source_id",
        "profile"
      ],
      "reconcile": [
        "mapping_id"
      ],
      "target-review": [
        "connection",
        "reconciliation_id",
        "profile"
      ],
      "deliver": [
        "connection",
        "review_id"
      ],
      "recover": [
        "delivery_id"
      ],
      "continue-delivery": [
        "delivery_id"
      ],
      "export": []
    }
  },
  "wrapperStates": [
    "QUEUED",
    "RUNNING",
    "COMPLETE",
    "FAILED",
    "CANCELLED",
    "INTERRUPTED"
  ],
  "deliveryKind": "target-delivery",
  "deliveryStateRequiresReview": "AWAITING_OPERATOR",
  "deliveryRetryEvent": {
    "kind": "PROVIDER_REJECTED",
    "status": 429,
    "deadline": "event.at + retry_after seconds, or actual Retry-After HTTP-date"
  },
  "entrySchema": "commons.pmrs-local-entry.v1",
  "nativeRoutes": {
    "state": "GET /api/state",
    "submit": "POST /api/actions",
    "command": "GET /api/actions/{id}",
    "delivery": "GET /api/operations/{id}",
    "record": "GET /api/records/{sha}",
    "totals": "GET /api/records/{sha}/totals?offset=&limit=",
    "findings": "GET /api/records/{sha}/findings?offset=&limit=",
    "ownership": "GET /api/records/{sha}/delivery"
  },
  "localProviderBearer": "Read only from original private loopback entry; never present in connector definitions",
  "supportedOriginalSchema": "Original29-file source plus21-file AL/browser closure; source identities in sources.json"
}
