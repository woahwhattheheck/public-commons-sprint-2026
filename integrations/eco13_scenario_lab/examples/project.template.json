{
  "schema": 1,
  "project_id": "upper-savannah",
  "setup_id": "original-setup-id",
  "currency": "USD",
  "source_manifest": {
    "original_project_manifest": "Retain the complete original provenance here"
  },
  "native": {
    "python": "/existing/native/venv/bin/python",
    "invest_version": "3.15.0"
  },
  "lulc_path": "data/lulc.tif",
  "parcels_path": "data/parcels.gpkg",
  "parcel_id_field": "parcel_id",
  "pixel_rule": "center",
  "models": {
    "ndr": {
      "args": {
        "lulc_path": "data/lulc.tif",
        "watersheds_path": "data/watersheds.gpkg",
        "dem_path": "data/dem.tif",
        "runoff_proxy_path": "data/precipitation.tif",
        "biophysical_table_path": "data/biophysical_ndr.csv",
        "calc_n": true,
        "calc_p": true,
        "threshold_flow_accumulation": 1000,
        "k_param": 2.0,
        "subsurface_critical_length_n": 150.0,
        "subsurface_eff_n": 0.5
      },
      "result": {
        "id_field": "ws_id"
      }
    },
    "sdr": {
      "args": {
        "lulc_path": "data/lulc.tif",
        "watersheds_path": "data/watersheds.gpkg",
        "dem_path": "data/dem.tif",
        "erosivity_path": "data/erosivity.tif",
        "erodibility_path": "data/erodibility.tif",
        "biophysical_table_path": "data/biophysical_sdr.csv",
        "threshold_flow_accumulation": 1000,
        "k_param": 2.0,
        "sdr_max": 0.8,
        "ic_0_param": 0.5
      },
      "result": {
        "id_field": "ws_id"
      }
    },
    "annual_water_yield": {
      "args": {
        "lulc_path": "data/lulc.tif",
        "watersheds_path": "data/watersheds.gpkg",
        "depth_to_root_rest_layer_path": "data/root_restriction_depth.tif",
        "precipitation_path": "data/precipitation.tif",
        "pawc_path": "data/pawc.tif",
        "eto_path": "data/eto.tif",
        "biophysical_table_path": "data/biophysical_awy.csv",
        "seasonality_constant": 5.0
      },
      "result": {
        "id_field": "ws_id"
      }
    }
  },
  "scenarios": [
    {
      "id": "restoration-area-a",
      "cost_cents": 100000,
      "interventions": [
        {
          "parcel_ids": [
            "REPLACE-WITH-ACTUAL-PARCEL-ID"
          ],
          "to_code": 41,
          "from_codes": [
            81,
