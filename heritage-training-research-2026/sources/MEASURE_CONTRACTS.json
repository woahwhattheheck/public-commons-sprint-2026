        "S13"
      ],
      "metrics": [
        "leavers",
        "completers",
        "achievers",
        "retention_rate",
        "pass_rate",
        "achievement_rate"
      ],
      "grain": [
        "time_period",
        "geographic_level",
        "country_code",
        "provision_type",
        "age_band",
        "regulated_qualification",
        "sector_subject_area_t1",
        "qualification_type",
        "learning_aim_title_plus_aim_reference",
        "level"
      ],
      "population": "education and training individual qualification aims meeting this release's QAR business rules",
      "unitByMetric": {
        "leavers": "aims",
        "completers": "aims",
        "achievers": "aims",
        "retention_rate": "percent",
        "pass_rate": "percent",
        "achievement_rate": "percent"
      },
      "coverage": [
        "2022/23",
        "2023/24",
        "2024/25"
      ],
      "cohortRule": "hybrid end year: later expected end year, actual end year or reporting year; apply actual business-rule exclusions",
      "formulas": {
        "retention_rate": "completers / leavers *100",
        "pass_rate": "achievers / completers *100",
        "achievement_rate": "achievers / leavers *100"
      },
      "rounding": {
        "volume": "nearest10",
        "rate": "one decimal from unrounded volumes"
      },
      "notSupported": [
        "provider",
        "site",
        "unique_people"
      ],
      "ratePolicy": "Use the published rate; do not reconstruct it from rounded displayed counts."
    },
