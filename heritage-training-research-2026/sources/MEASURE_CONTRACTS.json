    ],
    "requireExplicit": [
      "nonoverlappingPartitionDeclaration",
      "completeSourceRowKeys"
    ],
    "reject": [
      "Total plus children",
      "overlapping age or subject slices",
      "standard totals allocated to options",
      "provider totals allocated to sites",
      "different-period start/achievement ratios",
      "inference of suppressed cells"
