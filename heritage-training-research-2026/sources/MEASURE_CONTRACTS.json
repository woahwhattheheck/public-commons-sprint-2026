{
  "schema": "commons.uid370.measure-contracts.v1",
  "contracts": [
    {
      "id": "ofqual_certificates",
      "sources": [
        "S09",
        "S10"
      ],
      "metric": "certificates",
      "grain": [
        "qualification_number",
        "recognition_number",
        "quarter",
        "country"
      ],
      "population": "qualifications included in Ofqual's England quarterly certificate release",
      "unit": "certificates",
      "period": "calendar quarter from original column",
      "cohortRule": "certificate issuance in that quarter; not a learner start cohort",
      "rounding": "nearest5; source true zero retained",
      "rawIdentity": [
        "Qualification Number",
        "Recognition Number"
      ],
      "wideQuarterHeader": "Year.Quarter",
      "countryMeaning": "country of primary assessment as described in metadata",
      "tokens": {
        "0": {
          "status": "observed_zero",
          "numericValue": 0
        },
        "Fewer than 5": {
          "status": "disclosed_small_count",
          "numericValue": null,
          "lowerInclusive": 1,
          "upperInclusive": 4
        },
        "": {
          "status": "missing",
          "numericValue": null
        }
      },
      "numericInterpretation": "Positive numerals retain rounded_published_count status; do not infer exact underlying counts.",
      "metadataConflict": "CSVW lists0 in null values while its description identifies true zero; this intake explicitly preserves zero and records issueI02.",
      "notSupported": [
        "unique_people",
        "provider",
        "site",
        "completion_rate",
        "heritage_option"
      ]
    },
    {
      "id": "fe_aim_qar",
