{
  "schema": "commons.uid370.entity-and-field-contract.v1",
  "keyPolicy": "Keys above are proposed receiver composite keys. Preserve actual source constraints, all columns and duplicate diagnostics; do not silently assert uniqueness where the received file contradicts a proposed key.",
  "tables": [
    {
      "entity": "source_edition",
      "key": [
        "sourceId",
        "editionId"
      ],
      "fields": [
        "sourceId",
        "editionId",
        "publisher",
        "sourceUrl",
        "resolvedUrl",
        "filename",
        "mediaType",
        "bytes",
        "sha256",
        "capturedAt",
        "publishedAtRaw",
        "effectiveFromRaw",
        "effectiveToRaw",
        "coverageStart",
        "coverageEnd",
        "releaseStatus",
        "licence",
        "originalHeader",
        "pagination",
        "sourceLocator"
      ],
      "rules": [
        "Original bytes immutable.",
        "Capture and publication/effective periods are separate.",
        "A source register observation can have no original-byte hash; never promote it to a downloaded dataset."
      ]
    },
    {
      "entity": "qualification",
      "key": [
        "authority",
        "qualificationNumber"
      ],
      "fields": [
        "authority",
        "qualificationNumber",
        "qualificationNumberNoObliques",
        "title",
        "organisationRecognitionNumber",
        "status",
        "level",
        "type",
        "ssa",
        "offeredInEngland",
        "operationalStartDate",
        "operationalEndDate",
        "certificationEndDate",
        "linkToSpecification",
        "lastUpdatedDate",
        "sourceEditionId",
        "regulationStartDate",
        "reviewDate",
        "totalCredits",
        "tqt",
        "glh",
        "minimumGLH",
        "maximumGLH"
      ],
      "source": "S05",
      "rules": [
        "Retain string IDs and finalX.",
        "Original casing/envelope retained; adapter maps actual observed schema.",
        "A changed title does not change the qualification identity.",
        "Retain date-time offsets and nulls exactly; lastUpdatedDate is not a qualification-content version or provider start date.",
        "Preserve GLH, minimumGLH and maximumGLH as distinct source fields even where their actual values differ."
      ],
      "actualReceivedSources": [
        "S35",
        "S36"
      ]
    },
    {
      "entity": "qualification_content_version",
      "key": [
        "qualificationKey",
        "contentVersionId"
      ],
      "fields": [
        "qualificationKey",
        "contentVersionId",
        "sourceEditionId",
        "specificationVersionRaw",
        "effectiveFrom",
        "effectiveTo",
        "unitReferences",
        "pathway",
        "rulesOfCombination",
        "mandatoryOptional",
        "heritageReviewIds"
      ],
      "rules": [
        "The downloaded specification's own version is separate from the register lastUpdatedDate.",
        "Content review binds this exact version."
      ]
    },
    {
      "entity": "awarding_organisation",
      "key": [
        "authority",
        "recognitionNumber"
      ],
      "fields": [
        "authority",
        "recognitionNumber",
        "name",
        "legalName",
        "acronym",
        "ofqualOrganisationStatus",
        "ofqualRecognisedOn",
        "ofqualRecognisedTo",
        "lastUpdatedDate",
        "sourceEditionId",
        "successorRelationshipIds"
      ],
      "source": "S05",
      "rules": [
        "Retain prior organisation identities and dated succession rather than rewriting certificate history."
      ]
    },
    {
      "entity": "LARS_LearningDelivery",
      "key": [
        "sourceEditionId",
        "LearnAimRef"
      ],
      "nativeFields": [
        "LearnAimRef",
        "LearnAimRefTitle",
        "LearnAimRefType",
        "LearningDeliveryGenre",
        "SourceSystemRef",
        "SourceURLRef",
        "SourceURLLinkType",
        "AwardOrgCode",
        "AwardOrgAimRef",
        "NotionalNVQLevel",
        "NotionalNVQLevelv2",
        "OperationalStartDate",
        "OperationalEndDate",
        "CertificationEndDate",
        "RgltnStartDate",
        "EffectiveFrom",
        "EffectiveTo",
        "OfQualOfferedEngland"
      ],
      "source": "S07",
      "rules": [
        "Retain all original columns beyond the selected mapping.",
        "Genre and source authority control identity matching."
      ]
    },
    {
      "entity": "LARS_Validity",
      "key": [
        "sourceEditionId",
        "LearnAimRef",
        "ValidityCategory",
        "StartDate"
      ],
      "nativeFields": [
        "LearnAimRef",
        "ValidityCategory",
        "StartDate",
        "LastNewStartDate",
        "EndDate"
      ],
      "source": "S07",
      "rules": [
        "Multiple categories/intervals are separate records; no timeless funded boolean."
      ]
    },
    {
      "entity": "LARS_Funding",
      "key": [
        "sourceEditionId",
        "LearnAimRef",
        "FundingCategory",
        "EffectiveFrom"
      ],
      "nativeFields": [
        "LearnAimRef",
        "FundingCategory",
        "EffectiveFrom",
        "EffectiveTo",
        "RateWeighted",
        "RateUnWeighted",
        "WeightingFactor",
        "AdultSkillsFundingBand",
        "FundedGuidedLearningHours"
      ],
      "source": "S07",
      "rules": [
        "Preserve original rates as decimal strings with their published unit/context."
      ]
    },
    {
      "entity": "LARS_DevolvedFunding",
      "key": [
        "sourceEditionId",
        "LearnAimRef",
        "SourceOfFunding",
        "DevolvedFundingCategory",
        "EffectiveFrom"
      ],
      "nativeFields": [
        "LearnAimRef",
        "SourceOfFunding",
        "DevolvedFundingCategory",
        "EffectiveFrom",
        "EffectiveTo",
        "RateWeighted",
        "RateUplift",
        "RateUnWeighted",
        "SpecialistUplift"
      ],
      "source": "S07",
      "rules": [
        "Devolved route and authority are part of the identity.",
        "The PDF uses both table spellings; bind to the actual downloaded member/header, retaining its original name."
      ],
      "documentTableAliases": [
        "LARS_DevolvedFunding",
        "LARS_Devolved_Funding"
      ]
    },
    {
      "entity": "LARS_Standard",
      "key": [
        "sourceEditionId",
        "StandardCode",
        "Version"
      ],
      "nativeFields": [
        "StandardCode",
        "Version",
        "ApprenticeshipStandardTypeCode",
        "StandardName",
        "StandardSectorCode",
        "NotionalEndLevel",
        "EffectiveFrom",
        "LastDateStarts",
        "EffectiveTo",
        "Reference",
        "UrlLink",
        "SectorSubjectAreaTier1",
        "SectorSubjectAreaTier2"
      ],
      "source": "S07",
      "rules": [
        "LARS version integer and Skills England published version string need an evidenced relationship; do not equate their formatting."
      ]
    },
    {
      "entity": "LARS_StandardAims",
      "key": [
        "sourceEditionId",
        "StandardCode",
        "LearnAimRef"
      ],
      "nativeFields": [
        "StandardCode",
        "LearnAimRef",
        "EffectiveFrom",
        "EffectiveTo",
        "StandardComponentType"
      ],
      "source": "S07",
      "rules": [
        "StandardComponentType resolves through LARS_ApprenticeshipComponentType_Lookup. This relationship does not show which aims a learner took."
      ]
    },
    {
      "entity": "LARS_StandardValidity",
      "key": [
        "sourceEditionId",
        "StandardCode",
        "ValidityCategory",
        "StartDate"
      ],
      "nativeFields": [
        "StandardCode",
        "ValidityCategory",
        "StartDate",
        "LastNewStartDate",
        "EndDate"
      ],
      "source": "S07"
    },
    {
      "entity": "LARS_Version",
      "key": [
        "sourceEditionId"
      ],
      "nativeFields": [
        "MajorNumber",
        "MinorNumber",
        "MaintenanceNumber",
        "MainDataSchemaName",
        "RefDataSchemaName",
        "ActivationDate",
        "ExpiryDate",
        "Description"
      ],
      "source": "S07",
      "rules": [
        "Also retain complete DataGeneration and original reference tables."
      ]
    },
    {
      "entity": "standard_version",
      "key": [
        "authority",
        "reference",
        "version"
      ],
      "fields": [
        "authority",
        "reference",
        "version",
        "title",
        "status",
        "earliestStartDate",
        "latestStartDate",
        "larsStandardCode",
        "publishedUpdatedAt",
        "optionIds",
        "sourceEditionId"
      ],
      "source": "S28",
      "rules": [
        "Historical start eligibility and current availability are different questions.",
        "A null end date means not set in source, not guaranteed perpetual availability."
      ]
    },
    {
      "entity": "occupation_option",
      "key": [
        "authority",
        "stdCode",
        "sourceEditionId"
      ],
      "nativeFields": [
        "stdCode",
        "name",
        "status",
        "statusName",
        "versionNo",
        "statusLastUpdated",
        "level",
        "products",
        "soc",
        "ssa"
      ],
      "fields": [
        "standardRelationships",
        "optionScope",
        "sourceEditionId"
      ],
      "source": "S25",
      "rules": [
        "OCC identifier and ST product reference are distinct.",
        "Retain option-specific mapping and any many-to-many hierarchy."
      ]
    },
    {
      "entity": "provider",
      "key": [
        "namespace",
        "providerId"
      ],
      "fields": [
        "namespace",
        "providerId",
        "ukprn",
        "legalName",
        "tradingName",
        "registeredAddress",
        "sourceEditionId",
        "identityStatus",
        "successorRelationships"
      ],
      "sources": [
        "S21",
        "S34"
      ],
      "rules": [
        "Do not merge legal entities by similar name.",
        "Registered address is not a delivery site."
      ]
    },
    {
      "entity": "site",
      "key": [
        "siteId"
      ],
      "fields": [
        "siteId",
        "providerId",
        "siteName",
        "addressRaw",
        "postcodeRaw",
        "postcodeKind",
        "deliveryMode",
        "effectiveFrom",
        "effectiveTo",
        "locationSourceEditionId",
        "geographySourceEditionId",
        "geographyCode",
        "matchStatus"
      ],
      "sources": [
        "S23",
        "S24"
      ],
      "rules": [
        "Separate locally evidenced identity from postcode.",
        "ZZ99 9ZZ is a remote sentinel; provider fallback postcode remains labelled."
      ]
    },
    {
      "entity": "offering",
      "key": [
        "offeringId",
        "editionId"
      ],
      "fields": [
        "offeringId",
        "editionId",
        "providerId",
        "siteId",
        "qualificationKey",
        "qualificationVersionId",
        "standardReference",
        "standardVersion",
        "occupationOption",
        "deliveryMode",
        "role",
        "startsFrom",
        "startsTo",
        "availabilityStatus",
        "intakeDate",
        "confirmedByRole",
        "confirmationDate",
        "sourceEditionId",
        "locator",
        "placesValueRaw",
        "placesStatus",
        "feeRaw",
        "feeCurrency",
        "feeBasis"
      ],
      "rules": [
        "Need actual offer evidence at this grain.",
        "No learner demand, capacity or funded eligibility inferred from a listing."
      ]
    },
    {
      "entity": "measure",
      "key": [
        "sourceEditionId",
        "nativeRowKey",
        "metric"
      ],
      "fields": [
        "sourceEditionId",
        "nativeRowKey",
        "metric",
        "population",
        "entityScope",
        "qualificationKey",
        "standardReference",
        "standardVersion",
        "occupationOption",
        "providerId",
        "siteId",
        "periodRaw",
        "coverageStart",
        "coverageEnd",
        "cohortRule",
        "geography",
        "dimensionSelection",
        "rawValue",
        "status",
        "numericValue",
        "unit",
        "rounding",
        "suppressionRule",
        "provisionalFinal",
        "denominatorMetric",
        "partitionDeclarationId"
      ],
      "rules": [
        "Retain all source dimensions in nativeRowKey.",
        "Do not populate dimensions not published by source."
      ]
    },
    {
      "entity": "heritage_review",
      "key": [
        "reviewId"
      ],
      "fields": [
        "reviewId",
        "targetIdentity",
        "targetVersion",
        "sourceEditionIds",
        "sourceLocators",
        "materialSnapshot",
        "materialSha256",
        "decision",
        "mandatoryOptional",
        "taughtAssessed",
        "scopeFractionRaw",
        "rationale",
        "reviewer",
        "reviewedAt",
        "supersedes"
      ],
      "rules": [
        "Actual decision remains empty until deliberately authored.",
        "Material change makes historical review stale, not deleted."
      ]
    },
    {
      "entity": "coverage_observation",
      "key": [
        "coverageId"
      ],
      "fields": [
        "coverageId",
        "scopeId",
        "dimension",
        "candidateDenominator",
        "observedNumerator",
        "sourceEditionIds",
        "status",
        "searchOrRequest",
        "reason",
        "asOf",
        "followupOwnerRole"
      ],
      "rules": [
        "Not observed is distinct from explicit zero/none.",
        "Show denominator and sampling/response coverage."
      ]
    },
    {
      "entity": "LARS_StandardFunding",
      "key": [
        "sourceEditionId",
        "StandardCode",
        "FundingCategory",
        "EffectiveFrom"
      ],
      "nativeFields": [
        "StandardCode",
        "FundingCategory",
        "EffectiveFrom",
        "EffectiveTo",
        "BandNumber",
        "CoreGovContributionCap",
        "1618Incentive",
        "SmallBusinessIncentive",
        "AchievementIncentive",
        "FundableWithoutEmployer"
      ],
      "source": "S07",
      "rules": [
        "Preserve source-defined historic/non-used fields; a cap or incentive is not an actual paid amount."
      ]
    },
    {
      "entity": "LARS_DataGeneration",
      "key": [
        "sourceEditionId"
      ],
      "nativeFields": [
        "DataGeneratedOn",
        "Description",
        "Comment"
      ],
      "source": "S07",
      "rules": [
        "Source generation has no built-in record change history; retain each whole acquired edition."
      ]
    },
    {
      "entity": "LARS_FrameworkAims",
      "key": [
        "sourceEditionId",
        "FworkCode",
        "ProgType",
        "PwayCode",
        "LearnAimRef"
      ],
      "nativeFields": [
        "FworkCode",
        "ProgType",
        "PwayCode",
        "LearnAimRef",
        "EffectiveFrom",
        "EffectiveTo",
        "FrameworkComponentType"
      ],
      "source": "S07",
      "rules": [
        "Keep original framework identity and historical periods; do not invent an ST reference for a framework."
      ]
    },
    {
      "entity": "LARS_ApprenticeshipFunding",
      "key": [
        "sourceEditionId",
        "ApprenticeshipType",
        "ApprenticeshipCode",
        "ProgType",
        "PwayCode",
        "FundingCategory",
        "EffectiveFrom"
      ],
      "nativeFields": [
        "ApprenticeshipType",
        "ApprenticeshipCode",
        "ProgType",
        "PwayCode",
        "FundingCategory",
        "EffectiveFrom",
        "EffectiveTo",
        "BandNumber",
        "CoreGovContributionCap",
        "1618Incentive",
        "MaxEmployerLevyCap",
        "Duration",
        "CareLeaverAdditionalPayment",
        "FundableWithoutEmployer"
      ],
      "source": "S07",
      "rules": [
        "STD and FWK are distinct source types. Documented standard rows use ProgType25/PwayCode0.",
        "CoreGovContributionCap is documented unused/zero in this table; do not interpret it as unfunded delivery.",
        "Retain all original additional-payment/foundation/reserved columns and their actual header spelling.",
        "Published cap/rate fields do not establish an actual payment."
      ]
    }
  ]
}
