          "description": "Status of needs you would like to find.",
          "required": false,
          "schema": {
            "title": "listNeedsParamNeedStatus",
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "pending"
            ]
          }
        },
        {
          "in": "query",
          "name": "since_id",
          "required": false,
          "schema": {
