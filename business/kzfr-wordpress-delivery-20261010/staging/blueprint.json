{
  "landingPage": "/",
  "login": true,
  "steps": [
    {
      "step": "installTheme",
      "themeData": {
        "resource": "wordpress.org/themes",
        "slug": "twentytwentyone"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "kzfr-editorial-bridge/kzfr-editorial-bridge.php"
    },
    {
      "step": "activateTheme",
      "themeFolderName": "kzfr-community-radio"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "KZFR engineering staging",
        "blogdescription": "Independent local delivery candidate",
        "timezone_string": "America/Los_Angeles",
        "permalink_structure": "/%postname%/",
        "blog_public": "0"
      }
    }
  ]
}
