{
  "label": "Full Jaffle commissioning",
  "connection": {
    "id": "jaffle-commissioning",
    "origin": "http://127.0.0.1:8080",
    "projectUuid": "",
    "tokenEnv": "LIGHTDASH_API_KEY",
    "allowHttp": true,
    "source": null,
    "runtime": {
      "node": "/usr/bin/node",
      "cliEntry": "/opt/lightdash-cli/node_modules/@lightdash/cli/dist/index.js",
      "python": "/usr/bin/python3",
      "dbt": "/opt/dbt/bin/dbt"
    },
    "environment": {
      "PGHOST": "PGHOST",
      "PGPORT": "PGPORT",
      "PGUSER": "PGUSER",
      "PGPASSWORD": "PGPASSWORD",
      "PGDATABASE": "PGDATABASE",
      "SEED_SCHEMA": "SEED_SCHEMA"
    }
  },
  "editionSettings": {
    "projectDir": "dbt",
    "profilesDir": "profiles",
    "profile": "jaffle_shop",
    "target": "jaffle",
    "includeProfileFiles": true
  }
}
