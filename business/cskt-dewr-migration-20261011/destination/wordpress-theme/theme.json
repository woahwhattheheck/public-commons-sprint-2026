{
  "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "layout": {
      "contentSize": "50rem",
      "wideSize": "76rem"
    },
    "color": {
      "custom": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "gradients": [],
      "palette": [
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#202020"
        },
        {
          "slug": "muted",
          "name": "Muted text",
          "color": "#5b5b5b"
        },
        {
          "slug": "line",
          "name": "Rule",
          "color": "#c7c7c7"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#f4f4f4"
        },
        {
          "slug": "paper",
          "name": "Paper",
          "color": "#ffffff"
        }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System",
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "normal",
          "name": "Normal",
          "size": "1rem"
        },
        {
          "slug": "lead",
          "name": "Lead",
          "size": "1.2rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.5rem"
        }
      ]
    },
    "spacing": {
      "units": [
        "rem",
        "em",
        "%",
        "px"
      ],
      "blockGap": true
    }
  },
  "styles": {
    "color": {
      "text": "var:preset|color|ink",
      "background": "var:preset|color|paper"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "1rem",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|ink"
        }
      },
      "button": {
        "border": {
          "radius": "0"
        },
        "color": {
          "text": "var:preset|color|paper",
          "background": "var:preset|color|ink"
        }
      },
      "heading": {
        "typography": {
          "lineHeight": "1.2",
          "fontWeight": "650"
        }
      }
    }
  }
}
