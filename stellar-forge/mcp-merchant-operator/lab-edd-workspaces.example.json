      "approvalMode": "operator",
      "transport": {
        "mode": "explicit-connect",
        "origin": "https://jobs-merchant.example",
        "proxyEnv": "SF_JOBS_CHECKOUT_PROXY"
      },
      "temporaryDirectory": "/srv/starforge/lab-native-scratch",
      "requestTimeoutMs": 60000,
      "transferTimeoutMs": 3600000,
      "checkoutTimeoutMs": 360000,
      "maxConcurrent": 2
    }
  }
