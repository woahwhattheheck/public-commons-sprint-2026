{
  "schema": "stellar-forge.lab-edd-workspace-connection.v1",
  "workspaces": {
    "laboratory": {
      "label": "Laboratory review",
      "directory": "/srv/starforge/lab-customer",
      "merchant": "laboratory",
      "origin": "https://jobs-merchant.example",
      "functionId": "laboratoryReview",
      "runtimeDirectory": "/srv/starforge/source/stellar/scf-starforge-20261009/sf88-operator-buyer-cli",
      "operatorProfile": "/srv/starforge/original-operator/profile.json",
      "approvalMode": "operator",
      "transport": {
        "mode": "explicit-connect",
        "origin": "https://jobs-merchant.example",
        "proxyEnv": "SF_JOBS_CHECKOUT_PROXY"
      },
      "temporaryDirectory": "/srv/starforge/lab-native-scratch",
      "requestTimeoutMs": 60000,
      "transferTimeoutMs": 3600000,
      "checkoutTimeoutMs": 360000,
      "maxConcurrent": 2
    },
    "receiver": {
      "label": "Independent laboratory receiver",
      "directory": "/srv/starforge/lab-receiver",
