,"reference":"https://www.epa.gov/sites/default/files/2016-06/documents/chapter_8_may_2016_508.pdf","source_date":"2016-05","location":"Section 8.4.5","notes":"Sample handling procedures, preservation, holding time and custody records connect field collection to laboratory work.","accessed_at":"2026-10-12T23:42:08Z"},{"id":"epa-wqx-concepts","kind":"guidance","label":"EPA WQX concepts and definitions","reference":"https://www.epa.gov/waterdata/concepts-and-definitions-storage-and-retrieval-and-water-quality-exchange","source_date":null,"location":"Organizations, projects, locations, activities and results","notes":"Activities are separately identified sampling or field actions at locations; results attach to activities and retain analytical metadata.","accessed_at":"2026-10-12T23:42:08Z"},{"id":"epa-wqx-upload","kind":"guidance","label":"EPA water-quality upload with WQX","reference":"https://www.epa.gov/waterdata/water-quality-data-upload-wqx","source_date":"2025-12-11","location":"Data preparation and data requirements","notes":"Unique entity IDs, consistent names, domain values and validated templates are prerequisites to a separate WQX publication adapter.","accessed_at":"2026-10-12T23:42:08Z"},{"id":"epa-wqx-nutrients","kind":"guidance","label":"EPA WQX nutrient best practices","reference":"https://www.epa.gov/sites/default/files/2017-06/documents/wqx_nutrient_best_practices_guide.pdf","source_date":"2017-06-02","location":"Method speciation and sample fraction","notes":"Nutrient results need explicit chemical basis and filtration information; identical names or units alone do not establish equivalence.","accessed_at":"2026-10-12T23:42:08Z"},{"id":"epa-wqx-limits","kind":"guidance","label":"EPA WQX detection limits best practices","reference":"https://www.epa.gov/system/files/documents/2025-09/wqxdetectionlimitsbestpracticesguide_final.pdf","source_date":"2025-09-09","location":"Censored data and detection/quantitation limits","notes":"A reported detection condition and its limit belong with the original result.","accessed_at":"2026-10-12T23:42:08Z"},{"id":"nrcs-buffer","kind":"guidance","label":"NRCS Riparian Forest Buffer, practice 391","reference":"https://www.nrcs.usda.gov/resources/guides-and-instructions/riparian-forest-buffer-ac-391-conservation-practice-standard","source_date":"2020-10","location":"Practice page and local design document routing","notes":"Site design uses the applicable local Field Office Technical Guide; national practice references identify the method family.","accessed_at":"2026-10-12T23:42:08Z"},{"id":"nrcs-access","kind":"guidance","label":"NRCS Access Control, practice 472","reference":"https://www.nrcs.usda.gov/resources/guides-and-instructions/access-control-ac-472-conservation-practice-standard","source_date":null,"location":"Practice page and local design document routing","notes":"The local Field Office Technical Guide supplies applicable practice design information.","accessed_at":"2026-10-12T23:42:08Z"},{"id":"nrcs-filter","kind":"guidance","label":"NRCS Filter Strip, practice 393","reference":"https://www.nrcs.usda.gov/resources/guides-and-instructions/filter-strip-ac-393-conservation-practice-standard","source_date":"2026","location":"Practice page and local design document routing","notes":"Filter-strip practice references are a starting point for a locally specified design.","accessed_at":"2026-10-12T23:42:08Z"}],"instantiation":{"plan_schema":"upstate.implementation-plan/v1","id_policy":"Create a unique task id per plan/method instance; translate every depends_on entry from template ids to instantiated task ids.","task_core_fields":["id","title","candidate_id","phase","assignee","status","duration_days","start_not_before","depends_on","progress_pct","notes","evidence_refs"],"optional_template_metadata":["method_id","method_version","task_template_id","deliverables","form_ids"],"milestone_policy":"Milestone templates describe outputs attached to their task. They do not create numeric outcomes until an operator records the actual quantity.","monitoring_policy":"Create monitoring_plans and sites before scheduling visits. Instantiate field_forms as visit/activity notes or additive form_responses while observations use the canonical result contract."}}
