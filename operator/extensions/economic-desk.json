{
  "schema": "upstate.operator-extension/v1",
  "id": "economic-desk",
  "title": "Economic desk",
  "version": "1",
  "order": 65,
  "assets": [
    "economic_desk.mjs",
    "economic_desk.css",
    "economic_cost_worksheet.mjs",
    "economic_implementation.mjs"
  ],
  "backend": {
    "module": "economic_workbench",
    "factory": {
      "handler": "EconomicWorkbench",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "economic.edition.build",
      "economic.draft.save"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/economic-desk/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/economic-desk/source",
        "operation": "source",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/economic-desk/edition",
        "operation": "edition",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/economic-desk/draft",
        "operation": "draft",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/economic-desk/open",
        "operation": "open",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/economic-desk/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "items": [
      {
        "kind": "economic-editions",
        "operation": "edition",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "kind": "economic-drafts",
        "operation": "draft",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "economic_editions",
      "handler": "overview",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    },
    "file_routes": [
      {
        "path": "/api/file/economic-desk/{workspace_key}/{edition_id}",
        "handler": "preview",
        "args": [
          "route.workspace_key",
          "route.edition_id"
        ],
        "response": "ticket_policy_pair"
      }
    ]
  },
  "client": {
    "module": "/web/economic_desk.mjs",
    "factory": "attachEconomicDesk",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "toast",
      "refreshState",
      "navigate"
    ],
    "styles": [
      "/web/economic_desk.css"
    ],
    "view": {
      "id": "economic-desk",
      "title": "Economic desk",
      "after": "decisions"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
