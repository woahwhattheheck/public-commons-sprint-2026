{
  "schema": "upstate.operator-extension/v1",
  "id": "conservation-catalog",
  "title": "Conservation candidate catalog",
  "version": "1",
  "order": 86,
  "backend": {
    "module": "conservation_catalog",
    "factory": {
      "handler": "ConservationCatalog",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "conservation.catalog.prepare",
      "conservation.catalog.select",
      "conservation.catalog.plan.save",
      "conservation.catalog.export"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/conservation-catalog/study",
        "operation": "study",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/conservation-catalog/status",
        "operation": "status",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/conservation-catalog/query",
        "operation": "query",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/conservation-catalog/candidate",
        "operation": "candidate",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/conservation-catalog/selection",
        "operation": "selection",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    }
  }
}
