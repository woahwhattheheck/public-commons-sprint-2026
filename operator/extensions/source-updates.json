{
  "schema": "upstate.operator-extension/v1",
  "id": "source-updates",
  "title": "Source updates",
  "version": "9",
  "order": 25,
  "assets": [
    "source-refresh.html",
    "source-refresh.mjs",
    "source-refresh.css",
    "source-refresh-nav.mjs"
  ],
  "backend": {
    "module": "source_refresh",
    "actions": [
      "source.refresh.plan",
      "source.refresh.apply",
      "source.refresh.landcover"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "operator",
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/source-refresh",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/source-refresh/plan",
        "operation": "plan",
        "handler": "read",
        "args": [
          "workspace",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/source-refresh/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "workspace",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/source-refresh/report",
        "operation": "report",
        "handler": "read",
        "args": [
          "workspace",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "source_updates",
      "handler": "updates",
      "args": [
        "workspace"
      ]
    },
    "verify_workspace": {
      "module": "model.source_refresh_receiving",
      "handler": "verify_all",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/source-refresh.mjs",
    "factory": "createSourceRefresh",
    "requires": [
      "api",
      "getState",
      "getWorkspace",
      "refresh"
    ],
    "view": {
      "id": "source-updates",
      "title": "Source updates",
      "after": "sources"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
