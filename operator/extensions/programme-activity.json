{
  "schema": "upstate.operator-extension/v1",
  "id": "programme-activity",
  "title": "Programme execution activity",
  "version": "1",
  "order": 42,
  "requires_actions": [
    "compute.programme.run"
  ],
  "backend": {
    "module": "programme_activity",
    "factory": {
      "handler": "ProgrammeActivity",
      "args": [
        "operator",
        "fault"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/programme-activity/detail",
        "operation": "activity",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ]
  }
}
