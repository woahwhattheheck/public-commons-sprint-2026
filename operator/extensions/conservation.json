{
  "schema": "upstate.operator-extension/v1",
  "id": "conservation",
  "title": "Conservation plans",
  "version": "5",
  "order": 50,
  "assets": [
    "retained_desks.mjs",
    "conservation.mjs",
    "conservation.css",
    "conservation_optimization_bridge.mjs",
    "conservation_optimization.mjs",
    "conservation_optimization.css"
  ],
  "backend": {
    "module": "conservation",
    "factory": {
      "name": "Conservation",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "conservation.prepare",
      "conservation.build",
      "conservation.plan.save",
      "conservation.export",
      "conservation.scenario.create",
      "conservation.criteria.prepare",
      "conservation.experiment.prepare",
      "conservation.sources.capture",
      "conservation.report.source.prepare"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/conservation/overview",
        "operation": "overview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/conservation/study",
        "operation": "study",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/conservation/plan",
        "operation": "plan",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/conservation/source-capture",
        "operation": "source-capture",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/conservation/report-source",
        "operation": "report-source",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    }
  },
  "client": {
    "module": "/web/retained_desks.mjs",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "openForm",
      "submitAction",
      "detail",
      "fileList",
      "showTask",
      "openItem",
      "toast",
      "refreshState",
      "navigate",
      "closeDetail"
    ],
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    },
    "dispatch": "dispatch",
    "task_actions": "taskActions",
    "factory": "attachConservationDesk",
    "styles": [
      "/web/conservation.css",
      "/web/conservation_optimization.css"
    ],
    "view": {
      "id": "conservation",
      "title": "Conservation plans",
      "after": "experiments"
    },
    "action_prefixes": [
      "conservation-",
      "portfolio-optimization-"
    ]
  }
}
