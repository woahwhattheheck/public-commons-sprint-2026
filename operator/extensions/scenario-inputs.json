{
  "schema": "upstate.operator-extension/v1",
  "id": "scenario-inputs",
  "title": "Model input changes",
  "version": "1.1.0",
  "order": 46,
  "assets": [
    "scenario-inputs.mjs",
    "scenario-inputs.css"
  ],
  "backend": {
    "module": "scenario_inputs",
    "actions": [
      "scenario.inputs.compare"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "operator",
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/scenario-inputs/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/scenario-inputs/report",
        "operation": "report",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "operator",
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/scenario-inputs.mjs",
    "factory": "createScenarioInputs",
    "requires": [
      "api",
      "getState",
      "getWorkspace"
    ],
    "view": {
      "id": "scenario-inputs",
      "title": "Model input changes",
      "after": "scenario-footprint"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
