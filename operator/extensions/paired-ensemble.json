{
  "schema": "upstate.operator-extension/v1",
  "id": "paired-ensemble",
  "title": "Paired raster analysis",
  "version": "1.3.0",
  "order": 55,
  "assets": [
    "paired_ensemble_desk.mjs",
    "paired_ensemble_desk.css",
    "paired_ensemble.html",
    "paired_ensemble.mjs",
    "paired_ensemble.css",
    "paired_ensemble_host.mjs",
    "paired_ensemble_host.css"
  ],
  "backend": {
    "module": "paired_ensemble_service",
    "factory": {
      "handler": "PairedEnsembleService",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "paired_ensemble.build",
      "paired_ensemble.resume",
      "paired_ensemble.export",
      "paired_ensemble.receive"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/paired-ensemble/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/paired-ensemble/inspect",
        "operation": "inspect",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/paired-ensemble/cohort",
        "operation": "cohort",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/paired-ensemble/selection",
        "operation": "selection",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/paired-ensemble/progress",
        "operation": "progress",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/paired-ensemble/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/paired-ensemble/pause",
        "operation": "pause",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/paired-ensemble/edition",
        "operation": "edition",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/paired-ensemble/view",
        "operation": "view",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/paired-ensemble/view",
        "operation": "view.save",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "file_routes": [
      {
        "path": "/api/file/paired-ensemble/{workspace_key}/{ensemble_id}/{member_path...}",
        "handler": "member",
        "args": [
          "route.workspace_key",
          "route.ensemble_id",
          "route.member_path"
        ],
        "response": "ticket_policy_pair"
      }
    ],
    "items": [
      {
        "kind": "paired_ensemble_products",
        "operation": "inspect",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "paired_ensemble_products",
      "handler": "overview",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "module": "paired_ensemble_service",
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/paired_ensemble_desk.mjs",
    "factory": "attachPairedEnsembles",
    "requires": [
      "getState",
      "api",
      "refresh",
      "toast",
      "showTask",
      "openItem",
      "navigate"
    ],
    "styles": [
      "/web/paired_ensemble_desk.css"
    ],
    "view": {
      "id": "paired-ensemble",
      "title": "Paired raster analysis",
      "after": "ensembles"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
