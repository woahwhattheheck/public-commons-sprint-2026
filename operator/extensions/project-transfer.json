{
  "schema": "upstate.operator-extension/v1",
  "id": "project-transfer",
  "title": "Transfer and restore",
  "version": "2.1",
  "order": 90,
  "assets": [
    "project_transfer_desk.mjs",
    "project_transfer.css"
  ],
  "backend": {
    "module": "project_transfer",
    "factory": {
      "handler": "ProjectTransfers",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "project.transfer.capture",
      "project.transfer.capture-study",
      "project.transfer.accept",
      "project.transfer.receive",
      "project.transfer.parts",
      "project.transfer.archive",
      "project.transfer.restore",
      "project.transfer.report",
      "project.transfer.inspect",
      "project.transfer.diff"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/project-transfers/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/project-transfers/snapshot",
        "operation": "snapshot",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/project-transfers/progress",
        "operation": "progress",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/project-transfers/tasks",
        "operation": "tasks",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    }
  },
  "client": {
    "module": "/web/project_transfer_desk.mjs",
    "factory": "createProjectTransferDesk",
    "requires": [
      "api",
      "getState",
      "getWorkspace",
      "refreshState",
      "navigate",
      "showTask",
      "selectWorkspace",
      "openParameterStudy"
    ],
    "styles": [
      "/web/project_transfer.css"
    ],
    "view": {
      "id": "project-transfer",
      "title": "Transfer and restore",
      "after": "study-transfer"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
