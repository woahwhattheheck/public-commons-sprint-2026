{
  "schema": "upstate.operator-extension/v1",
  "id": "assessment-context",
  "title": "Assessment geographic context",
  "version": "1.4.0",
  "order": 67,
  "assets": [
    "assessment_context.mjs",
    "assessment_context.css"
  ],
  "backend": {
    "module": "assessment_context",
    "factory": {
      "handler": "AssessmentContext",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "assessment.context.build",
      "assessment.context.receive",
      "assessment.context.parcels",
      "assessment.context.receive_parcels",
      "assessment.context.report"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/assessment-context/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/assessment-context/options",
        "operation": "options",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/assessment-context/edition",
        "operation": "edition",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/assessment-context/parcels",
        "operation": "parcels",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "items": [
      {
        "kind": "assessment-contexts",
        "handler": "item",
        "args": [
          "workspace_key",
          "payload"
        ]
      },
      {
        "kind": "assessment-parcel-contexts",
        "handler": "parcel_item",
        "args": [
          "workspace_key",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "assessment_contexts",
      "handler": "state",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/assessment_context.mjs",
    "factory": "attachAssessmentContext",
    "requires": [
      "api",
      "getState",
      "getWorkspace",
      "refresh",
      "toast",
      "showTask",
      "navigate",
      "closeDetail",
      "openDelivery",
      "openScientificReport"
    ],
    "styles": [
      "/web/assessment_context.css"
    ],
    "view": {
      "id": "assessment-context",
      "title": "Assessment context",
      "after": "station-geography"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    },
    "task_actions": "taskActions",
    "dispatch": "dispatch",
    "action_prefixes": [
      "assessment-context-result-",
      "assessment-context-report-"
    ]
  }
}
