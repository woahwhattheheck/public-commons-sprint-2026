{
  "schema": "upstate.operator-extension/v1",
  "id": "native-run-desk",
  "title": "Native run desk",
  "version": "1",
  "order": 40,
  "assets": [
    "run_workbench.mjs",
    "run_workbench.css"
  ],
  "requires_actions": [
    "run.prepare",
    "run.start",
    "run.compare"
  ],
  "client": {
    "module": "/web/run_workbench.mjs",
    "factory": "attachRunWorkbench",
    "requires": [
      "getState",
      "api",
      "refreshState",
      "openItem",
      "showTask",
      "showRunLog",
      "openDelivery",
      "toast"
    ],
    "styles": [
      "/web/run_workbench.css"
    ],
    "view": {
      "id": "run-desk",
      "title": "Native run desk",
      "after": "runs"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    },
    "action_prefixes": [
      "run-desk-"
    ],
    "dispatch": "dispatch"
  }
}
