{
  "schema": "upstate.operator-extension/v1",
  "id": "gwma-study",
  "title": "Pathogen study",
  "version": "1",
  "order": 75,
  "assets": [
    "gwma_study.mjs",
    "gwma_study.css",
    "decision_transfer.mjs"
  ],
  "backend": {
    "module": "gwma_study_operator",
    "actions": [
      "gwma.study.save",
      "gwma.mapping.save",
      "gwma.intake",
      "gwma.review.save",
      "gwma.contract.save",
      "gwma.plan.save",
      "gwma.handover.build"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "operator",
        "workspace_key",
        "action",
        "payload"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/gwma/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/gwma/item",
        "operation": "item",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/gwma/rows",
        "operation": "rows",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "gwma_study",
      "handler": "overview",
      "args": [
        "operator",
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "operator",
        "task"
      ]
    },
    "verify_workspace": {
      "module": "model.gwma_study",
      "handler": "verify_all",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/gwma_study.mjs",
    "factory": "attachGWMAStudyWorkbench",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "toast",
      "showTask"
    ],
    "styles": [
      "/web/gwma_study.css"
    ],
    "view": {
      "id": "gwma-study",
      "title": "Pathogen study",
      "after": "observations"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
