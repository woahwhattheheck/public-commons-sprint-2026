{
  "schema": "upstate.operator-extension/v1",
  "id": "geographic-headwaters",
  "title": "Geographic model case",
  "version": "1",
  "order": 21,
  "requires_actions": [
    "source.prepare",
    "source.compose"
  ],
  "assets": [
    "source_workbench.mjs",
    "source_workbench.css",
    "geographic_workbench.mjs",
    "geographic_workbench.css"
  ],
  "backend": {
    "module": "geographic_preparation",
    "factory": {
      "handler": "GeographyPreparation",
      "args": [
        "operator",
        "fault",
        "source_roots"
      ]
    },
    "actions": [
      "geography.prepare",
      "geography.compose"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/geographic-headwaters/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/geographic-headwaters/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/geographic-headwaters/case",
        "operation": "case",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/geographic-headwaters/progress",
        "operation": "progress",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/geographic-headwaters/result",
        "operation": "result",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    }
  },
  "client": {
    "module": "/web/geographic_workbench.mjs",
    "factory": "createGeographicWorkbench",
    "requires": [
      "getState",
      "getWorkspace",
      "api",
      "refresh",
      "toast",
      "navigate",
      "openItem",
      "showTask"
    ],
    "styles": [
      "/web/source_workbench.css",
      "/web/geographic_workbench.css"
    ],
    "view": {
      "id": "geographic-headwaters",
      "title": "Geographic model case",
      "after": "source-preparation"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "suspend"
    }
  }
}
