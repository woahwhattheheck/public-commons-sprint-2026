{
  "schema": "upstate.operator-extension/v1",
  "id": "profile-workbench",
  "title": "Profile workbench",
  "version": "3",
  "order": 25,
  "assets": [
    "profile_workbench.mjs",
    "profile_workbench.css",
    "profile_customer_review.mjs",
    "biophysical_evidence.mjs"
  ],
  "backend": {
    "module": "profile_workbench",
    "factory": {
      "handler": "ProfileWorkbench",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "profile.edition.save",
      "profile.edition.review",
      "profile.customer_review.create",
      "profile.customer_review.apply",
      "profile.biophysical.evidence.save",
      "profile.biophysical.ranges.prepare",
      "profile.biophysical.experiment.prepare"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/profile-workbench/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/profile-workbench/methods",
        "operation": "methods",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/profile-workbench/inspect",
        "operation": "inspect",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/profile-workbench/table",
        "operation": "table",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/profile-workbench/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/profile-workbench/compare",
        "operation": "compare",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/profile-workbench/customer-reviews/catalog",
        "operation": "customer-review-catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/profile-workbench/customer-reviews/inspect",
        "operation": "customer-review-inspect",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/profile-workbench/customer-reviews/preview",
        "operation": "customer-review-preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/profile-workbench/biophysical/catalog",
        "operation": "biophysical-catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/profile-workbench/biophysical/template",
        "operation": "biophysical-template",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/profile-workbench/biophysical/evidence-preview",
        "operation": "biophysical-evidence-preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/profile-workbench/biophysical/evidence-inspect",
        "operation": "biophysical-evidence-inspect",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/profile-workbench/biophysical/ranges-preview",
        "operation": "biophysical-ranges-preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/profile-workbench/biophysical/ranges-inspect",
        "operation": "biophysical-ranges-inspect",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_all",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/profile_workbench.mjs",
    "factory": "createProfileWorkbench",
    "requires": [
      "getState",
      "api",
      "refreshState",
      "showTask"
    ],
    "styles": [
      "/web/profile_workbench.css"
    ],
    "view": {
      "id": "profile-workbench",
      "title": "Profile workbench",
      "after": "profiles"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
