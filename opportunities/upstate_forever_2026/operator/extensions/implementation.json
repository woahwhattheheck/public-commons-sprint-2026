{
  "schema": "upstate.operator-extension/v1",
  "id": "implementation",
  "title": "Implementation & fieldwork",
  "version": "3",
  "order": 70,
  "assets": [
    "implementation.mjs",
    "implementation_core.mjs",
    "implementation_forms.mjs",
    "implementation.css",
    "implementation_workbench.html"
  ],
  "backend": {
    "module": "implementation_operator",
    "factory": {
      "handler": "ImplementationOperator",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "implementation.plan.create",
      "implementation.plan.import",
      "implementation.plan.save",
      "implementation.plan.report",
      "implementation.records.append",
      "implementation.source.attach",
      "implementation.source.import",
      "implementation.selection.import",
      "implementation.observations.import"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/implementation/list",
        "operation": "list",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/implementation/detail",
        "operation": "detail",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/implementation/history",
        "operation": "history",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/implementation/schedule",
        "operation": "schedule",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/implementation/summary",
        "operation": "summary",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/implementation/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/implementation/selections",
        "operation": "selections",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/implementation/create",
        "operation": "create",
        "handler": "queue",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/implementation/import",
        "operation": "import",
        "handler": "queue",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/implementation/save",
        "operation": "save",
        "handler": "queue",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/implementation/report",
        "operation": "report",
        "handler": "queue",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/implementation/append",
        "operation": "append",
        "handler": "queue",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/implementation/attach",
        "operation": "attach",
        "handler": "queue",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/implementation/source-import",
        "operation": "source-import",
        "handler": "queue",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/implementation/selection-import",
        "operation": "selection-import",
        "handler": "queue",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/implementation/observations-preview",
        "operation": "observations-preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/implementation/observations-import",
        "operation": "observations-import",
        "handler": "queue",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "items": [
      {
        "kind": "implementation_plans",
        "handler": "read_item",
        "args": [
          "workspace_key",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "implementation_plans",
      "handler": "overview",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/implementation.mjs",
    "factory": "attachImplementationWorkbench",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "refresh",
      "navigate"
    ],
    "styles": [
      "/web/implementation.css"
    ],
    "view": {
      "id": "implementation",
      "title": "Implementation & fieldwork",
      "after": "communities"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
