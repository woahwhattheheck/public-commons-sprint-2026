{
  "schema": "upstate.operator-extension/v1",
  "id": "native-interactions",
  "title": "Conservation combinations",
  "version": "1.3.0",
  "order": 48,
  "assets": [
    "native-interactions.mjs",
    "native-interactions.css"
  ],
  "backend": {
    "module": "native_interactions",
    "actions": [
      "interaction.plan",
      "interaction.apply",
      "interaction.analyze"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "operator",
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/native-interactions/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/native-interactions/plan",
        "operation": "plan",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/native-interactions/result",
        "operation": "result",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/native-interactions/report",
        "operation": "report",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/native-interactions/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "native_interactions",
      "handler": "updates",
      "args": [
        "workspace"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "operator",
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/native-interactions.mjs",
    "factory": "createNativeInteractions",
    "requires": [
      "api",
      "getState",
      "getWorkspace"
    ],
    "view": {
      "id": "native-interactions",
      "title": "Conservation combinations",
      "after": "scenario-inputs"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    },
    "styles": [
      "/web/native-interactions.css"
    ]
  }
}
