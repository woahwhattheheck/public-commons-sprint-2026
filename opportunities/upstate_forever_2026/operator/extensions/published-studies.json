{
  "schema": "upstate.operator-extension/v1",
  "id": "published-studies",
  "title": "Published studies",
  "version": "2.7.0",
  "order": 46,
  "assets": [
    "published_studies.mjs",
    "published_studies.css",
    "published_review_reports.mjs",
    "published_microbial_selection.mjs",
    "published_original_reports.mjs",
    "published_interpretation.mjs",
    "published_interpretation.css"
  ],
  "backend": {
    "module": "published_study_operator",
    "factory": {
      "handler": "PublishedStudyProvider",
      "args": [
        "operator",
        "fault",
        "source_roots"
      ]
    },
    "actions": [
      "published-study.import",
      "published-study.export",
      "published-study.report",
      "published-study.review.save",
      "published-study.review.export",
      "published-study.review.import",
      "published-study.review.prepare-source",
      "published-study.microbial-selection.prepare",
      "published-study.interpretation.save",
      "published-study.interpretation.export",
      "published-study.interpretation.import"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/published-studies/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/published-studies/study",
        "operation": "study",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/published-studies/context",
        "operation": "context",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/published-studies/review",
        "operation": "review",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/published-studies/geographic-preview",
        "operation": "geographic-preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/published-studies/geographic-selection",
        "operation": "geographic-selection",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/published-studies/review-source-preview",
        "operation": "review-source-preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/published-studies/review-sources",
        "operation": "review-sources",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/published-studies/review-source",
        "operation": "review-source",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/published-studies/microbial-selection-catalog",
        "operation": "microbial-selection-catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/published-studies/microbial-selection-preview",
        "operation": "microbial-selection-preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/published-studies/report-preview",
        "operation": "report-preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/published-studies/interpretation-catalog",
        "operation": "interpretation-catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/published-studies/interpretation-preview",
        "operation": "interpretation-preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/published-studies/interpretation-get",
        "operation": "interpretation-get",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "file_routes": [
      {
        "path": "/api/file/published-study/{workspace_key}/{collection_id}/{member_path...}",
        "handler": "member",
        "args": [
          "route.workspace_key",
          "route.collection_id",
          "route.member_path"
        ],
        "response": "ticket_policy_pair"
      },
      {
        "path": "/api/file/published-study-preview/{workspace_key}/{ticket_id}",
        "handler": "report_preview_file",
        "args": [
          "route.workspace_key",
          "route.ticket_id"
        ],
        "response": "ticket_policy_pair"
      }
    ]
  },
  "client": {
    "module": "/web/published_studies.mjs",
    "factory": "createPublishedStudiesDesk",
    "requires": [
      "getState",
      "getWorkspace",
      "api",
      "refresh",
      "toast",
      "navigate",
      "openItem",
      "showTask"
    ],
    "styles": [
      "/web/published_studies.css",
      "/web/published_interpretation.css"
    ],
    "view": {
      "id": "published-studies",
      "title": "Published studies",
      "after": "sources"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
