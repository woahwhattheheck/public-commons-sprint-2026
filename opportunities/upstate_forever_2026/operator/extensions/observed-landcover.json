{
  "schema": "upstate.operator-extension/v1",
  "id": "observed-landcover",
  "title": "Observed watershed change",
  "version": "1.3.0",
  "order": 58,
  "assets": [
    "observed_landcover.mjs",
    "observed_landcover.css",
    "observed_landcover_selection.mjs",
    "observed_landcover_groups.mjs",
    "observed_landcover_handover.mjs"
  ],
  "backend": {
    "module": "observed_landcover_operator",
    "actions": [
      "observed.landcover.import",
      "observed.landcover.save",
      "observed.landcover.handover"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "operator",
        "workspace_key",
        "action",
        "payload"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/observed-landcover/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/observed-landcover/inputs",
        "operation": "inputs",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/observed-landcover/edition",
        "operation": "edition",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/observed-landcover/handover-catalog",
        "operation": "handover-catalog",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/observed-landcover/handover",
        "operation": "handover",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "items": [
      {
        "kind": "observed-landcover-selections",
        "operation": "edition",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "kind": "observed-landcover-handovers",
        "operation": "handover",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "observed_landcover_selections",
      "handler": "overview",
      "args": [
        "operator",
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "operator",
        "task"
      ]
    },
    "verify_workspace": {
      "module": "model.observed_landcover",
      "handler": "verify_all",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/observed_landcover.mjs",
    "factory": "attachObservedLandcover",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "toast",
      "openScientificReport",
      "openForm",
      "submitAction",
      "openDesk"
    ],
    "styles": [
      "/web/observed_landcover.css"
    ],
    "view": {
      "id": "observed-landcover",
      "title": "Observed watershed change",
      "after": "landcover-ledger"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    },
    "task_actions": "taskActions",
    "action_prefixes": [
      "observed-lc-"
    ],
    "dispatch": "dispatch"
  }
}
