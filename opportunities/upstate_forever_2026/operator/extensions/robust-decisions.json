{
  "schema": "upstate.operator-extension/v1",
  "id": "robust-decisions",
  "title": "Robust decision studies",
  "version": "0.2.0",
  "order": 84,
  "assets": [
    "robust-decisions.mjs",
    "robust-decisions.css"
  ],
  "backend": {
    "module": "robust_decision_registry",
    "factory": {
      "handler": "create",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "robust.study.list",
      "robust.study.read",
      "robust.study.create",
      "robust.study.revise",
      "robust.experiment.prepare",
      "robust.summary.prepare",
      "robust.solve",
      "robust.frontier",
      "robust.project.export",
      "robust.project.receive",
      "robust.selection.export",
      "robust.report.export"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/robust-decisions",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "robust_decisions",
      "handler": "state",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "module": "robust_decision_registry",
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/robust-decisions.mjs",
    "factory": "attachRobustDecisions",
    "requires": [
      "getState",
      "api",
      "showTask"
    ],
    "styles": [],
    "view": {
      "id": "robust-decisions",
      "title": "Robust decisions",
      "after": "decisions"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
