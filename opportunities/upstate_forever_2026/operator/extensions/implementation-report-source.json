{
  "schema": "upstate.operator-extension/v1",
  "id": "implementation-report-source",
  "title": "Implementation plan reports",
  "version": "1.0.0",
  "order": 73,
  "assets": [],
  "backend": {
    "module": "implementation_report_source",
    "factory": {
      "handler": "ImplementationReportSource",
      "args": [
        "operator",
        "fault"
      ]
    },
    "routes": [
      {
        "methods": [
          "POST"
        ],
        "path": "/api/implementation/report-source-preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/implementation/report-source-detail",
        "operation": "detail",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "actions": [
      "implementation.report-source.import"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    }
  }
}
