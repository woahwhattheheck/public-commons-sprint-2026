{
  "schema": "upstate.operator-extension/v1",
  "id": "water-context",
  "title": "Water and Habitat Context",
  "version": "1",
  "order": 65,
  "assets": [
    "water_context.mjs",
    "water_context_map.mjs",
    "water_context.css"
  ],
  "backend": {
    "module": "water_context_service",
    "factory": {
      "handler": "WaterContextService",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "water-context.build"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/water-context/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/water-context/analysis",
        "operation": "analysis",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/water-context/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "water_context",
      "handler": "state",
      "args": [
        "workspace_key"
      ]
    },
    "items": [
      {
        "kind": "water-context",
        "operation": "analysis",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/water_context.mjs",
    "factory": "attachWaterContext",
    "requires": [
      "getState",
      "api",
      "refreshState",
      "showTask",
      "toast"
    ],
    "styles": [
      "/web/water_context.css"
    ],
    "view": {
      "id": "water-context",
      "title": "Water and Habitat Context",
      "after": "spatial"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
