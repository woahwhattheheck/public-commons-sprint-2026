{
  "schema": "upstate.operator-extension/v1",
  "id": "scenario-analysis",
  "title": "Scenario analysis",
  "version": "20261013.4",
  "order": 55,
  "assets": [
    "scenario_analysis.mjs",
    "scenario_analysis_bridge.mjs",
    "scenario_analysis.css",
    "native_versions.mjs"
  ],
  "backend": {
    "module": "scenario_analysis_operator",
    "actions": [
      "scenario.analyze"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "workspace",
        "payload"
      ]
    },
    "items": [
      {
        "kind": "scenario_analyses",
        "handler": "item",
        "args": [
          "operator",
          "workspace_key",
          "payload",
          "fault"
        ]
      }
    ],
    "state": {
      "key": "scenario_analyses",
      "handler": "overview",
      "args": [
        "workspace"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "operator",
        "task",
        "fault"
      ]
    }
  },
  "client": {
    "module": "/web/scenario_analysis_bridge.mjs",
    "factory": "attachScenarioAnalysisExtension",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "openForm",
      "submitAction",
      "fileList",
      "toast",
      "openItem"
    ],
    "styles": [
      "/web/scenario_analysis.css"
    ],
    "view": {
      "id": "scenario-analysis",
      "title": "Scenario analysis",
      "after": "comparisons"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    },
    "action_prefixes": [
      "analysis-"
    ],
    "dispatch": "dispatch"
  }
}
