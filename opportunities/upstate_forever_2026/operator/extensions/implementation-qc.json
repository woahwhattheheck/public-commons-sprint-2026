{
  "schema": "upstate.operator-extension/v1",
  "id": "implementation-qc",
  "title": "Sample quality control",
  "version": "3",
  "order": 72,
  "assets": [
    "implementation_qc.mjs",
    "implementation_qc_comparison.mjs"
  ],
  "backend": {
    "module": "implementation_qc",
    "factory": {
      "handler": "ImplementationQC",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "implementation.qc.save",
      "implementation.qc.source",
      "implementation.qc.export",
      "implementation.qc.actions.save",
      "implementation.qc.actions.source",
      "implementation.qc.actions.export",
      "implementation.qc.comparison.save",
      "implementation.qc.comparison.source",
      "implementation.qc.comparison.export"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/implementation-qc/records",
        "operation": "records",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/implementation-qc/list",
