{
  "schema": "upstate.operator-extension/v1",
  "id": "spatial-cohorts",
  "title": "Native feature cohorts",
  "order": 43,
  "assets": [
    "spatial_cohorts.mjs",
    "spatial_cohorts.css"
  ],
  "backend": {
    "module": "spatial_cohort_operations",
    "factory": {
      "handler": "CohortOperations",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "spatial.cohort.analyze"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "path": "/api/spatial/cohorts/catalog",
        "methods": [
          "GET",
          "POST"
        ],
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "path": "/api/spatial/cohorts/result",
        "methods": [
          "GET",
          "POST"
        ],
        "operation": "result",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "items": [
      {
        "kind": "spatial_cohorts",
        "handler": "item",
        "args": [
          "workspace_key",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "spatial_cohorts",
      "handler": "state",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  }
}
