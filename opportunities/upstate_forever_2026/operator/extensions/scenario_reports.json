{
  "schema": "upstate.operator-extension/v1",
  "id": "scenario-reports",
  "title": "Watershed reports",
  "version": "5",
  "order": 55,
  "assets": [
    "extensions/scenario_reports.mjs",
    "extensions/scenario_reports.css",
    "extensions/report_releases.css"
  ],
  "backend": {
    "module": "scenario_decision_reports",
    "actions": [
      "scenario.decision.build"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "operator",
        "workspace_key",
        "action",
        "payload",
        "fault"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/scenario-reports/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload",
          "fault"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/scenario-reports/selection",
        "operation": "selection",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload",
          "fault"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/scenario-reports/report",
        "operation": "report",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload",
          "fault"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/scenario-reports/release",
        "operation": "release",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload",
          "fault"
        ]
      }
    ],
    "items": [
      {
        "kind": "scenario-reports",
        "operation": "report",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload",
          "fault"
        ]
      }
    ],
    "state": {
      "key": "scenario_reports",
      "handler": "overview",
      "args": [
        "operator",
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "operator",
        "task",
        "fault"
      ]
    },
    "verify_workspace": {
      "module": "scenario_decision_reports",
      "handler": "verify_all",
      "args": [
        "workspace"
      ]
    },
    "file_routes": [
      {
        "path": "/api/file/scenario-report/{workspace_key}/{report_id}",
        "handler": "preview",
        "args": [
          "operator",
          "route.workspace_key",
          "route.report_id",
          "fault"
        ],
        "response": "ticket_policy_pair"
      }
    ]
  },
  "client": {
    "module": "/web/extensions/scenario_reports.mjs",
    "factory": "attachScenarioReports",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "toast"
    ],
    "styles": [
      "/web/extensions/scenario_reports.css",
      "/web/extensions/report_releases.css"
    ],
    "view": {
      "id": "scenario-reports",
      "title": "Watershed reports",
      "after": "comparisons"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
