{
  "schema": "upstate.operator-extension/v1",
  "id": "decision-context",
  "title": "Regional decision context",
  "version": "1.0.0",
  "order": 66,
  "assets": [
    "decision_context.mjs",
    "decision_context.css"
  ],
  "backend": {
    "module": "decision_context",
    "factory": {
      "handler": "DecisionContextOperator",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "decision.context.build",
      "decision.context.delivery"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "path": "/api/decision-context/catalog",
        "methods": [
          "GET"
        ],
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "path": "/api/decision-context/detail",
        "methods": [
          "GET"
        ],
        "operation": "detail",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "items": [
      {
        "kind": "decision_contexts",
        "handler": "item",
        "args": [
          "workspace_key",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "decision_contexts",
      "handler": "state",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/decision_context.mjs",
    "factory": "attachDecisionContext",
    "view": {
      "id": "decision-context",
      "title": "Decision context",
      "after": "comparisons"
    },
    "styles": [
      "/web/decision_context.css"
    ],
    "requires": [
      "api",
      "endpoint",
      "getState",
      "openForm",
      "submitAction",
      "detail",
      "fileList",
      "toast"
    ],
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    },
    "action_prefixes": [
      "decision-context-"
    ],
    "dispatch": "dispatch"
  }
}
