{
  "schema": "upstate.operator-extension/v1",
  "id": "received-published-review-admission",
  "title": "Editable admitted Published-study reviews",
  "version": "1.0.0",
  "order": 90,
  "requires_actions": [
    "published-study.review.import"
  ],
  "backend": {
    "module": "published_review_admission",
    "actions": [
      "received.published-review.admit"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "operator",
        "workspace_key",
        "action",
        "payload"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/received-published-review/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/received-published-review/admission",
        "operation": "admission",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "operator",
        "task"
      ]
    },
    "verify_workspace": {
      "module": "model.published_review_admission",
      "handler": "verify_all",
      "args": [
        "workspace"
      ]
    }
  }
}
