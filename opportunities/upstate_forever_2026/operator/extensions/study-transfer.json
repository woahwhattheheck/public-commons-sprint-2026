{
  "schema": "upstate.operator-extension/v1",
  "id": "study-transfer",
  "title": "Study transfer",
  "version": "1",
  "order": 88,
  "assets": [
    "extensions/study_transfer.mjs",
    "extensions/study_transfer.css",
    "received_studies.mjs",
    "gauge_received_studies.mjs",
    "ensemble_received_studies.mjs",
    "observed_landcover_received.mjs",
    "observed_landcover_received.css",
    "study_report_navigation.mjs",
    "economic_received_comparisons.mjs"
  ],
  "requires_actions": [
    "workspace.restore"
  ],
  "backend": {
    "module": "study_transfer",
    "factory": {
      "handler": "StudyTransfer",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "study.export"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/study-transfer/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/study-transfer/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/study-transfer/exports",
        "operation": "exports",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/study-transfer/progress",
        "operation": "progress",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/study-transfer/received",
        "operation": "received",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/study-transfer/received-detail",
        "operation": "received-detail",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/extensions/study_transfer.mjs",
    "factory": "attachStudyTransfer",
    "requires": [
      "getState",
      "getWorkspace",
      "api",
      "refreshState",
      "showTask",
      "navigate",
      "openExtension",
      "openItem",
      "openScientificReport",
      "openDesk"
    ],
    "styles": [
      "/web/extensions/study_transfer.css",
      "/web/observed_landcover_received.css"
    ],
    "view": {
      "id": "study-transfer",
      "title": "Study transfer",
      "after": "deliveries"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
