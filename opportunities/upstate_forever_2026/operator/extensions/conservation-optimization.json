{
  "schema": "upstate.operator-extension/v1",
  "id": "conservation-optimization",
  "title": "Conservation optimization",
  "version": "2",
  "order": 85,
  "backend": {
    "module": "conservation_optimization",
    "factory": {
      "handler": "ConservationOptimization",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "conservation.optimization.preview",
      "conservation.optimization.save",
      "conservation.optimization.export"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/conservation-optimization/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/conservation-optimization/analysis",
        "operation": "analysis",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/conservation-optimization/plan",
        "operation": "plan",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "items": [
      {
        "kind": "conservation-optimized-plans",
        "operation": "plan",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    }
  }
}
