{
  "schema": "upstate.operator-extension/v1",
  "id": "source-reports",
  "title": "Retained source reports",
  "version": "2.1.0",
  "order": 56,
  "assets": [
    "source_reports.mjs",
    "source_reports.css",
    "source_report_editions.mjs"
  ],
  "backend": {
    "module": "source_reports",
    "factory": {
      "handler": "SourceReports",
      "args": [
        "operator",
        "fault",
        "source_roots"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/source-reports/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/source-reports/detail",
        "operation": "detail",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/source-reports/archive",
        "operation": "archive",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/source-reports/scientific-catalog",
        "operation": "scientific-catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/source-reports/scientific-preview",
        "operation": "scientific-preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/source-reports/scientific-edition",
        "operation": "scientific-edition",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/source-reports/scientific-briefing-preview",
        "operation": "scientific-briefing-preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/source-reports/scientific-briefing",
        "operation": "scientific-briefing",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "file_routes": [
      {
        "path": "/api/file/source-reports/{workspace_key}/{collection_id}/{entry_key}/{member...}",
        "response": "ticket_policy_pair",
        "handler": "member",
        "args": [
          "route.workspace_key",
          "route.collection_id",
          "route.entry_key",
          "route.member"
        ]
      },
      {
        "path": "/api/file/scientific-reports/{workspace_key}/{edition_id}/{member...}",
        "response": "ticket_policy_pair",
        "handler": "scientific_member",
        "args": [
          "route.workspace_key",
          "route.edition_id",
          "route.member"
        ]
      },
      {
        "path": "/api/file/scientific-briefings/{workspace_key}/{briefing_id}/{member...}",
        "response": "ticket_policy_pair",
        "handler": "briefing_member",
        "args": [
          "route.workspace_key",
          "route.briefing_id",
          "route.member"
        ]
      }
    ],
    "actions": [
      "source-reports.render",
      "source-reports.export",
      "source-reports.briefing"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "state": {
      "key": "scientific_reports",
      "handler": "state",
      "args": [
        "workspace_key"
      ]
    },
    "items": [
      {
        "kind": "scientific-report-editions",
        "operation": "scientific-edition",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  }
}
