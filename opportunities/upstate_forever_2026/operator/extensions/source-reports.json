{
  "schema": "upstate.operator-extension/v1",
  "id": "source-reports",
  "title": "Retained source reports",
  "version": "1.0.0",
  "order": 56,
  "assets": [
    "source_reports.mjs",
    "source_reports.css"
  ],
  "backend": {
    "module": "source_reports",
    "factory": {
      "handler": "SourceReports",
      "args": [
        "operator",
        "fault"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/source-reports/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/source-reports/detail",
        "operation": "detail",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/source-reports/archive",
        "operation": "archive",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "file_routes": [
      {
        "path": "/api/file/source-reports/{workspace_key}/{collection_id}/{entry_key}/{member...}",
        "response": "ticket_policy_pair",
        "handler": "member",
        "args": [
          "route.workspace_key",
          "route.collection_id",
          "route.entry_key",
          "route.member"
        ]
      }
    ]
  }
}
