{
  "schema": "upstate.operator-extension/v1",
  "id": "parcel-sources",
  "title": "Parcel sources",
  "version": "2",
  "order": 24,
  "assets": [
    "parcel_source_desk.mjs",
    "parcel_source_desk.css"
  ],
  "backend": {
    "module": "parcel_source_desk",
    "factory": {
      "handler": "ParcelSourceDesk",
      "args": [
        "operator",
        "fault",
        "source_roots"
      ]
    },
    "actions": [
      "parcel.source.receive",
      "parcel.source.prepare"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/parcel-sources/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/parcel-sources/directories",
        "operation": "directories",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/parcel-sources/capture",
        "operation": "capture",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/parcel-sources/edition",
        "operation": "edition",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/parcel-sources/rows",
        "operation": "rows",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/parcel-sources/study-selection",
        "operation": "study-selection",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "items": [
      {
        "kind": "parcel_source_editions",
        "operation": "edition",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "parcel_source_desk",
      "handler": "state",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "module": "model.parcel_source_desk",
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/parcel_source_desk.mjs",
    "factory": "createParcelSourceDesk",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "toast",
      "showTask",
      "openItem",
      "navigate"
    ],
    "styles": [
      "/web/parcel_source_desk.css"
    ],
    "view": {
      "id": "parcel-sources",
      "title": "Parcel sources",
      "after": "source-preparation"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
