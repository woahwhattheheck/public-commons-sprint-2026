{
  "schema": "upstate.operator-extension/v1",
  "id": "native-run-history",
  "title": "Original native execution history",
  "version": "1",
  "order": 41,
  "assets": [
    "native_run_history.mjs"
  ],
  "backend": {
    "module": "native_run_history",
    "actions": [
      "run.history.save"
