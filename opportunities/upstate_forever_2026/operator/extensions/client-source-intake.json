{
  "schema": "upstate.operator-extension/v1",
  "id": "client-source-intake",
  "title": "Open my data",
  "version": "1",
  "order": 19,
  "assets": [
    "client_source_intake.mjs",
    "client_source_mapping.mjs",
    "client_source_intake.css"
  ],
  "backend": {
    "module": "client_source_intake",
    "factory": {
      "handler": "ClientSourceIntake",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "client-source.inspect",
      "client-source.commit"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/client-source/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/client-source/result",
        "operation": "result",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/client_source_intake.mjs",
    "factory": "createClientSourceIntake",
    "requires": [
      "getState",
      "getWorkspace",
      "api",
      "refresh",
      "toast",
      "navigate",
      "openItem",
      "showTask"
    ],
    "styles": [
      "/web/client_source_intake.css"
    ],
    "view": {
      "id": "client-source-intake",
      "title": "Open my data",
      "after": "sources"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "suspend"
    }
  }
}
