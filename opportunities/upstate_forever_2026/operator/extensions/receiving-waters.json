{
  "schema": "upstate.operator-extension/v1",
  "id": "receiving-waters",
  "title": "Receiving waters",
  "version": "5",
  "order": 52,
  "assets": [
    "receiving_waters.mjs",
    "receiving_waters_extension.mjs",
    "receiving_waters.css",
    "receiving_water_spatial.mjs",
    "receiving_water_monitoring.mjs"
  ],
  "backend": {
    "module": "receiving_water_actions",
    "factory": {
      "handler": "ReceivingWaterActions",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "receiving.water.catalog",
      "receiving.water.plan",
      "receiving.water.profile",
      "receiving.water.analyze",
      "receiving.water.monitoring"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/receiving-waters/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/receiving-waters/plan",
        "operation": "plan",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/receiving-waters/analysis",
        "operation": "analysis",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/receiving-waters/designation-catalog",
        "operation": "designation-catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/receiving-waters/monitoring",
        "operation": "monitoring",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "receiving_waters",
      "handler": "snapshot",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    }
  },
  "client": {
    "module": "/web/receiving_waters_extension.mjs",
    "factory": "attachReceivingWatersExtension",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "openForm",
      "submitAction",
      "detail",
      "fileList",
      "showTask",
      "toast"
    ],
    "styles": [
      "/web/receiving_waters.css"
    ],
    "view": {
      "id": "receiving-waters",
      "title": "Receiving waters",
      "after": "spatial"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    },
    "action_prefixes": [
      "water-"
    ],
    "dispatch": "dispatch"
  }
}
