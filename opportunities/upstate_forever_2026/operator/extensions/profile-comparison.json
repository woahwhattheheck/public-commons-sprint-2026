{
  "schema": "upstate.operator-extension/v1",
  "id": "profile-comparison",
  "title": "Source profile comparison",
  "version": "1.0.0",
  "order": 53,
  "assets": [
    "profile_comparison.mjs",
    "profile_comparison.css"
  ],
  "backend": {
    "module": "profile_comparison_service",
    "factory": {
      "handler": "ProfileComparisonService",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "profile_comparison.create",
      "profile_comparison.export"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/profile-comparison/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/profile-comparison/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/profile-comparison/inspect",
        "operation": "inspect",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/profile-comparison/study",
        "operation": "study",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "file_routes": [
      {
        "path": "/api/file/profile-comparison/{workspace_key}/{comparison_id}/{member_path...}",
        "handler": "member",
        "args": [
          "route.workspace_key",
          "route.comparison_id",
          "route.member_path"
        ],
        "response": "ticket_policy_pair"
      }
    ],
    "items": [
      {
        "kind": "profile_comparisons",
        "operation": "inspect",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "profile_comparisons",
      "handler": "overview",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "module": "profile_comparison_service",
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/profile_comparison.mjs",
    "factory": "attachProfileComparison",
    "requires": [
      "getState",
      "api",
      "refresh",
      "toast",
      "showTask",
      "navigate",
      "openExtension",
      "openItem"
    ],
    "styles": [
      "/web/profile_comparison.css"
    ],
    "view": {
      "id": "profile-comparison",
      "title": "Source profiles",
      "after": "profiles"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
