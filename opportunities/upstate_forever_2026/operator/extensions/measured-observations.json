{
  "schema": "upstate.operator-extension/v1",
  "id": "measured-observations",
  "title": "Measured observations",
  "version": "1.9.1",
  "order": 45,
  "assets": [
    "measured_observations.mjs",
    "measured_observations.css",
    "measured_observations_extension.mjs",
    "measured_collections.mjs",
    "measured_chemistry.mjs",
    "measured_large_files.mjs",
    "measured_results.mjs",
    "flow_editions.mjs",
    "flow_editions.css",
    "measured_intake.mjs",
    "flow_loads_ui.mjs",
    "source_reconciliation.mjs",
    "source_reconciliation.css",
    "source_handback.mjs",
    "source_handback.css",
    "benchmarks.mjs",
    "measured_native_observations.mjs",
    "observation_editions.mjs",
    "observation_editions.css",
    "sediment.mjs",
    "result_handback.mjs",
    "intake_comparison.mjs"
  ],
  "backend": {
    "module": "measurement_workspace.extension",
    "factory": {
      "handler": "MeasuredObservationExtension",
      "args": [
        "operator",
        "fault"
      ]
    },
    "routes": [
      {
        "methods": [
          "POST"
        ],
        "path": "/api/measurements/rpc",
        "operation": "rpc",
        "handler": "read",
        "args": [
          "workspace",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/measurements/domain",
        "operation": "bind-domain",
        "handler": "read",
        "args": [
          "workspace",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/measurements/chemistry",
        "operation": "chemistry",
        "handler": "read",
        "args": [
          "workspace",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/measurements/native-observations",
        "operation": "native-observations",
        "handler": "read",
        "args": [
          "workspace",
          "operation",
          "payload"
        ]
      }
    ]
  },
  "client": {
    "module": "/web/measured_observations_extension.mjs",
    "factory": "createMeasuredObservations",
    "requires": [
      "api",
      "getWorkspace",
      "openDesk",
      "getState",
      "showTask"
    ],
    "styles": [
      "/web/measured_observations.css"
    ],
    "view": {
      "id": "measured-observations",
      "title": "Measured observations",
      "after": "sources"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "suspend"
    }
  }
}
