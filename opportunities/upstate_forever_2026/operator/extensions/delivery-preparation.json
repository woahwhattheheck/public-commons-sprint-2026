{
  "schema": "upstate.operator-extension/v1",
  "id": "delivery-preparation",
  "title": "Delivery preparation",
  "version": "1",
  "order": 65,
  "assets": [
    "delivery_preparation.mjs",
    "delivery_preparation_storage.mjs",
    "delivery_preparation.css"
  ],
  "backend": {
    "module": "delivery_preparation",
    "factory": {
      "handler": "DeliveryPreparationDesk",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "delivery.preparation.save",
      "delivery.preparation.build"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "POST"
        ],
        "path": "/api/delivery-preparation/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/delivery-preparation/item",
        "operation": "item",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/delivery-preparation/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/delivery-preparation/operation",
        "operation": "operation",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "items": [
      {
        "kind": "delivery_preparations",
        "operation": "item",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "delivery_preparation",
      "handler": "state",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "module": "model.delivery_preparation",
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/delivery_preparation.mjs",
    "factory": "createDeliveryPreparationDesk",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "showTask",
      "openItem",
      "navigate"
    ],
    "styles": [
      "/web/delivery_preparation.css"
    ],
    "view": {
      "id": "delivery-preparation",
      "title": "Delivery preparation",
      "after": "deliveries"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
