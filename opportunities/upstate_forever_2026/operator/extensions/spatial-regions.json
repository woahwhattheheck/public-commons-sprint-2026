{
  "schema": "upstate.operator-extension/v1",
  "id": "spatial-regions",
  "title": "Native region analysis",
  "order": 42,
  "assets": [
    "spatial_regions.mjs",
    "spatial_regions.css"
  ],
  "backend": {
    "module": "spatial_region_operations",
    "factory": {
      "handler": "RegionOperations",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "spatial.region.analyze",
      "spatial.region.extract"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "path": "/api/spatial/regions/catalog",
        "methods": [
          "GET",
          "POST"
        ],
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "path": "/api/spatial/regions/result",
        "methods": [
          "GET",
          "POST"
        ],
        "operation": "result",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "path": "/api/spatial/regions/extract",
        "methods": [
          "GET",
          "POST"
        ],
        "operation": "extract",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "path": "/api/spatial/regions/extracts",
        "methods": [
          "GET",
          "POST"
        ],
        "operation": "extracts",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "items": [
      {
        "kind": "spatial_regions",
        "handler": "item",
        "args": [
          "workspace_key",
          "payload"
        ]
      },
      {
        "kind": "spatial_region_extractions",
        "handler": "extract_item",
        "args": [
          "workspace_key",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "spatial_regions",
      "handler": "state",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  }
}
