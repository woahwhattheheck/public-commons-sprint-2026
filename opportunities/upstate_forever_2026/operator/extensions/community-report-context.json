{
  "schema": "upstate.operator-extension/v1",
  "id": "community-report-context",
  "title": "Community scientific report sources and handovers",
  "version": "2",
  "order": 57,
  "assets": [
    "community_report_handover.mjs"
  ],
  "backend": {
    "module": "community_report_context",
    "factory": {
      "name": "CommunityReportContext",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "community.report.source.prepare",
      "community.report.handover.export",
      "community.report.handover.receive"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/community-report-context/handover-preview",
        "operation": "handover-preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ]
  }
}
