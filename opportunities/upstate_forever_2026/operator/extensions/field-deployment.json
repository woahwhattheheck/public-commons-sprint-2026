{
  "schema": "upstate.operator-extension/v1",
  "id": "field-deployment",
  "title": "Field crew packets",
  "version": "1.0.0",
  "order": 74,
  "assets": [
    "implementation_deployment.mjs"
  ],
  "backend": {
    "module": "field_deployment",
    "factory": {
      "handler": "FieldDeployment",
      "args": [
        "operator",
        "fault"
      ]
    },
    "routes": [
      {
        "methods": [
          "POST"
        ],
        "path": "/api/implementation/deployment-preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/implementation/deployments",
        "operation": "list",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/implementation/deployment-detail",
        "operation": "detail",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "actions": [
      "implementation.field-deployment.prepare"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  }
}
