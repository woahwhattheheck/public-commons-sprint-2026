{
  "schema": "upstate.operator-extension/v1",
  "id": "gauge-support",
  "title": "Gauge support",
  "version": "1.3.0",
  "order": 45,
  "assets": [
    "gauge_support.mjs",
    "gauge_support.css"
  ],
  "backend": {
    "module": "gauge_support",
    "factory": {
      "handler": "GaugeSupport",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "gauge.support.build",
      "gauge.support.report"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/gauge-support/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/gauge-support/edition",
        "operation": "edition",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/gauge-support/verify",
        "operation": "verify",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/gauge-support/report",
        "operation": "report",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "items": [
      {
        "kind": "gauge-support",
        "operation": "edition",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "gauge_support",
      "handler": "overview",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "module": "model.gauge_support",
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/gauge_support.mjs",
    "factory": "attachGaugeSupport",
    "requires": [
      "getState",
      "getWorkspace",
      "api",
      "refresh",
      "toast",
      "navigate",
      "openItem",
      "showTask",
      "openDelivery"
    ],
    "styles": [
      "/web/gauge_support.css"
    ],
    "view": {
      "id": "gauge-support",
      "title": "Gauge support",
      "after": "station-geography"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
