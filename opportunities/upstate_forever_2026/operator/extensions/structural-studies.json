{
  "schema": "upstate.operator-extension/v1",
  "id": "structural-studies",
  "title": "Structural studies",
  "version": "1",
  "order": 61,
  "assets": [
    "structural_studies.mjs",
    "structural_study_storage.mjs",
    "structural_studies.css"
  ],
  "backend": {
    "module": "structural_study",
    "factory": {
      "handler": "StructuralStudyDesk",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "structural-study.prepare",
      "structural-study.run",
      "structural-study.report"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "POST"
        ],
        "path": "/api/structural-studies/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/structural-studies/item",
        "operation": "item",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/structural-studies/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/structural-studies/operation",
        "operation": "operation",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/structural-studies/result",
        "operation": "result",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "file_routes": [
      {
        "path": "/api/file/structural-study/{workspace_key}/{study_id}/{member...}",
        "response": "ticket_policy_pair",
        "handler": "report_member",
        "args": [
          "workspace_key",
          "route.study_id",
          "route.member"
        ]
      }
    ],
    "items": [
      {
        "kind": "structural_studies",
        "operation": "item",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "structural_studies",
      "handler": "state",
      "args": [
        "workspace_key"
      ]
    },
    "verify_workspace": {
      "module": "model.structural_studies",
      "handler": "verify_all",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/structural_studies.mjs",
    "factory": "createStructuralStudyDesk",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "showTask",
      "openItem",
      "navigate"
    ],
    "styles": [
      "/web/structural_studies.css"
    ],
    "view": {
      "id": "structural-studies",
      "title": "Structural studies",
      "after": "parameter-studies"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
