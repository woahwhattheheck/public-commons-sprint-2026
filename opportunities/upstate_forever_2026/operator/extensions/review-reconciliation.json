{
  "schema": "upstate.operator-extension/v1",
  "id": "review-reconciliation",
  "title": "Returned responses",
  "version": "1",
  "order": 76,
  "assets": [
    "review_reconciliation.mjs"
  ],
  "requires_actions": [
    "customer.review.response.import"
  ],
  "backend": {
    "module": "review_reconciliation",
    "factory": {
      "handler": "ReviewReconciliation",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "customer.review.response.stage",
      "customer.review.response.reconcile"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/review-reconciliation/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/review-reconciliation/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/review-reconciliation/validate",
        "operation": "validate",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/review-reconciliation/detail",
        "operation": "detail",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "review_reconciliation",
      "handler": "overview",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "module": "model.review_reconciliation",
      "handler": "verify_all",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/review_reconciliation.mjs",
    "factory": "attachReviewReconciliation",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "toast",
      "showTask"
    ],
    "view": {
      "id": "review-reconciliation",
      "title": "Returned responses",
      "after": "customer-reviews"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
