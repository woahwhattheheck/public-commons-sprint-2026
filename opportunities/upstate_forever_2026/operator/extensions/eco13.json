{
  "schema": "upstate.operator-extension/v1",
  "id": "eco13",
  "title": "Experiment comparisons",
  "version": "3",
  "order": 57,
  "assets": [
    "eco13.mjs",
    "eco13.css"
  ],
  "backend": {
    "module": "eco13_operator",
    "factory": {
      "handler": "Eco13Operator",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "eco13.experiment.receive",
      "eco13.report.save",
      "eco13.comparison.export",
      "eco13.archive.receive",
      "eco13.review.create",
      "eco13.review.receive"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/eco13/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/eco13/record",
        "operation": "record",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/eco13/rows",
        "operation": "rows",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/eco13/economic-sources",
        "operation": "economic-sources",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "items": [
      {
        "kind": "eco13-records",
        "operation": "record",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "eco13",
      "handler": "overview",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/eco13.mjs",
    "factory": "attachEco13",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "refreshState",
      "showTask",
      "toast",
      "navigate"
    ],
    "styles": [
      "/web/eco13.css"
    ],
    "view": {
      "id": "eco13",
      "title": "Experiment comparisons",
      "after": "experiments"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    },
    "action_prefixes": [
      "eco13-"
    ],
    "dispatch": "dispatch",
    "task_actions": "taskActions"
  }
}
