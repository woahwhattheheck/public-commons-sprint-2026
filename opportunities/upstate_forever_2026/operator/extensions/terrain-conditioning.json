{
  "schema": "upstate.operator-extension/v1",
  "id": "terrain-conditioning",
  "title": "Terrain editions",
  "version": "1.0.0",
  "order": 26,
  "requires_actions": [
    "run.start"
  ],
  "assets": [
    "terrain_conditioning.mjs",
    "terrain_conditioning.css"
  ],
  "backend": {
    "module": "terrain_conditioning_native",
    "actions": [
      "terrain.conditioning.save",
      "terrain.conditioning.run",
      "terrain.conditioning.grid",
      "terrain.conditioning.native.prepare",
      "terrain.conditioning.compare",
      "terrain.conditioning.report-source.prepare"
    ],
    "invoke": {
      "handler": "perform",
      "args": [
        "operator",
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/terrain-conditioning",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/terrain-conditioning/report-source-preview",
        "handler": "preview_report_source",
        "args": [
          "operator",
          "workspace_key",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "terrain_conditioning",
      "handler": "snapshot",
      "args": [
        "workspace"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "operator",
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/terrain_conditioning.mjs",
    "factory": "createTerrainConditioning",
    "styles": [
      "/web/terrain_conditioning.css"
    ],
    "requires": [
      "api",
      "getState",
      "getWorkspace",
      "refresh",
      "navigate",
      "showTask",
      "openScientificReport"
    ],
    "view": {
      "id": "terrain-conditioning",
      "title": "Terrain editions",
      "after": "sources"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    }
  }
}
