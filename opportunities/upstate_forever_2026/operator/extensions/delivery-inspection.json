{
  "schema": "upstate.operator-extension/v1",
  "id": "delivery-inspection",
  "title": "Original delivery inspection",
  "version": "1",
  "assets": [
    "delivery_inspection.mjs"
  ],
  "backend": {
    "module": "delivery_inspection",
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/delivery-inspection",
        "operation": "inspect",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "file_routes": [
      {
        "path": "/api/file/delivery-view/{workspace_key}/{delivery_id}/{member_path...}",
        "handler": "preview",
        "args": [
          "operator",
          "route.workspace_key",
          "route.delivery_id",
          "route.member_path"
        ],
        "response": "ticket_policy_pair"
      },
      {
        "path": "/api/file/delivery-preview/{workspace_key}/{delivery_id}/{member_path...}",
        "handler": "linked_preview",
        "args": [
          "operator",
          "route.workspace_key",
          "route.delivery_id",
          "route.member_path"
        ],
        "response": "ticket_policy_pair"
      }
    ]
  }
}
