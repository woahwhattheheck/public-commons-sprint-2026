{
  "schema": "upstate.operator-extension/v1",
  "id": "source-preparation",
  "title": "Prepare study inputs",
  "version": "4",
  "order": 20,
  "assets": [
    "source_workbench.mjs",
    "source_workbench.css"
  ],
  "backend": {
    "module": "source_preparation",
    "factory": {
      "handler": "SourcePreparation",
      "args": [
        "operator",
        "fault",
        "source_roots"
      ]
    },
    "actions": [
      "source.prepare",
      "source.compose"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/source-preparation/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/source-preparation/files",
        "operation": "files",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/source-preparation/progress",
        "operation": "progress",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET",
          "POST"
        ],
        "path": "/api/source-preparation/result",
        "operation": "result",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    }
  },
  "client": {
    "module": "/web/source_workbench.mjs",
    "factory": "createSourceWorkbench",
    "requires": [
      "getState",
      "getWorkspace",
      "api",
      "refresh",
      "toast",
      "navigate",
      "openItem",
      "showTask",
      "openExtension"
    ],
    "styles": [
      "/web/source_workbench.css"
    ],
    "view": {
      "id": "source-preparation",
      "title": "Prepare study inputs",
      "after": "sources"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "suspend"
    }
  }
}
