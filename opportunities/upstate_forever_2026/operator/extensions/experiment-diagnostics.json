{
  "schema": "upstate.operator-extension/v1",
  "id": "experiment-diagnostics",
  "title": "Scientific interpretation",
  "version": "2",
  "order": 55,
  "assets": [
    "retained_desks.mjs",
    "experiment_diagnostics.mjs",
    "experiment_diagnostics.css"
  ],
  "backend": {
    "module": "experiment_diagnostics",
    "factory": {
      "name": "ExperimentDiagnostics",
      "args": [
        "operator",
        "fault"
      ]
    },
    "actions": [
      "diagnostics.analyze",
      "diagnostics.report.prepare"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/diagnostics/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/diagnostics/item",
        "operation": "item",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/diagnostics/experiment",
        "operation": "experiment",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "experiment_diagnostics",
      "handler": "summaries",
      "args": [
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    }
  },
  "client": {
    "module": "/web/retained_desks.mjs",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "openForm",
      "submitAction",
      "detail",
      "fileList",
      "showTask",
      "openItem",
      "toast",
      "refreshState",
      "navigate",
      "closeDetail",
      "openDelivery"
    ],
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    },
    "dispatch": "dispatch",
    "task_actions": "taskActions",
    "factory": "attachDiagnosticsDesk",
    "styles": [
      "/web/experiment_diagnostics.css"
    ],
    "view": {
      "id": "experiment-diagnostics",
      "title": "Scientific interpretation",
      "after": "conservation"
    },
    "action_prefixes": [
      "diagnostic-"
    ]
  }
}
