{
  "schema": "upstate.operator-extension/v1",
  "id": "measurement-returned-reviews-native",
  "title": "Returned measurement reviews",
  "version": "1.0.0",
  "order": 46,
  "assets": [
    "measured_returned_reviews.mjs"
  ],
  "backend": {
    "module": "measurement_returned_reviews_native",
    "actions": [
      "measurements.returned-review.plan",
      "measurements.returned-review.apply"
    ],
    "invoke": {
      "handler": "perform",
      "args": [
        "operator",
        "task"
      ]
    },
    "routes": [
      {
        "methods": [
          "POST"
        ],
        "path": "/api/measurement-returned-reviews/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/measurement-returned-reviews/inspect",
        "operation": "inspect",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "operator",
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  }
}
