{
  "schema": "upstate.operator-extension/v1",
  "id": "paired-ensemble-report",
  "title": "Retained paired ensemble scientific reports",
  "version": "1.0.0",
  "order": 56,
  "requires_actions": [
    "paired_ensemble.build"
  ],
  "backend": {
    "module": "paired_ensemble_report_native",
    "actions": [
      "paired_ensemble.report_source"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "operator",
        "workspace_key",
        "action",
        "payload"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "operator",
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    }
  }
}
