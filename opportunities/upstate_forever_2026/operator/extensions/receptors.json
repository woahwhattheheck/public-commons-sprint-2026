  "client": {
    "module": "/web/receptors.mjs",
    "factory": "attachReceptorWorkbench",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "toast",
      "openExtension",
      "openForm",
      "submitAction",
      "refreshState",
      "openItem",
      "navigate",
      "closeDetail",
      "getProgramme"
    ],
    "styles": [
      "/web/receptors.css"
    ],
    "view": {
      "id": "source-water",
      "title": "Source-water areas",
      "after": "decisions"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    },
    "task_actions": "taskActions",
    "dispatch": "dispatch",
    "action_prefixes": [
      "receptor-result-"
    ]
