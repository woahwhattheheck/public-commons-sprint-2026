{
  "schema": "upstate.operator-extension/v1",
  "id": "independent-comparison",
  "title": "Independent source comparisons",
  "version": "1.0.0",
  "order": 60,
  "assets": [
    "independent_comparison.mjs",
    "independent_comparison_state.mjs",
    "independent_comparison.css"
  ],
  "backend": {
    "module": "independent_comparison",
    "actions": [
      "independent.comparison.save"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "operator",
        "workspace_key",
        "action",
        "payload"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/independent-comparison/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/independent-comparison/inputs",
        "operation": "inputs",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/independent-comparison/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/independent-comparison/edition",
        "operation": "edition",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/independent-comparison/reference-context",
        "operation": "reference-context",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/independent-comparison/prediction-context",
        "operation": "prediction-context",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "items": [
      {
        "kind": "independent-comparisons",
        "operation": "edition",
        "handler": "read",
        "args": [
          "operator",
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "state": {
      "key": "independent_comparisons",
      "handler": "overview",
      "args": [
        "operator",
        "workspace_key"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "operator",
        "task"
      ]
    },
    "verify_workspace": {
      "module": "model.independent_comparison",
      "handler": "verify_all",
      "args": [
        "workspace"
      ]
    }
  },
  "client": {
    "module": "/web/independent_comparison.mjs",
    "factory": "attachIndependentComparison",
    "requires": [
      "getState",
      "api",
      "endpoint",
      "toast",
      "openDesk",
      "openScientificReport",
      "showTask",
      "refreshState"
    ],
    "styles": [
      "/web/independent_comparison.css"
    ],
    "view": {
      "id": "independent-comparison",
      "title": "Independent source comparisons",
      "after": "observation-comparability"
    },
    "lifecycle": {
      "mount": "mount",
      "update": "update",
      "detach": "detach"
    },
    "task_actions": "taskActions",
    "action_prefixes": [
      "independent-comparison-"
    ],
    "dispatch": "dispatch"
  }
}
