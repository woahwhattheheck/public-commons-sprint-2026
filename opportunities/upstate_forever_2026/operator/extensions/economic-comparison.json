{
  "schema": "upstate.operator-extension/v1",
  "id": "economic-comparison",
  "title": "Saved Economic comparisons",
  "version": "1.0.0",
  "order": 66,
  "assets": [
    "economic_comparison.mjs"
  ],
  "requires_actions": [
    "economic.edition.build"
  ],
  "backend": {
    "module": "economic_comparison",
    "factory": {
      "handler": "EconomicComparison",
      "args": [
        "operator",
        "fault"
      ]
    },
    "routes": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/economic-comparison/catalog",
        "operation": "catalog",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "POST"
        ],
        "path": "/api/economic-comparison/preview",
        "operation": "preview",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      },
      {
        "methods": [
          "GET"
        ],
        "path": "/api/economic-comparison/detail",
        "operation": "detail",
        "handler": "read",
        "args": [
          "workspace_key",
          "operation",
          "payload"
        ]
      }
    ],
    "actions": [
      "economic.comparison.build"
    ],
    "invoke": {
      "handler": "invoke",
      "args": [
        "task"
      ]
    },
    "decorate_task": {
      "handler": "decorate_task",
      "args": [
        "task"
      ]
    },
    "verify_workspace": {
      "handler": "verify_workspace",
      "args": [
        "workspace"
      ]
    },
    "file_routes": [
      {
        "path": "/api/file/economic-comparison/{workspace_key}/{comparison_id}/{member}",
        "handler": "preview_file",
        "args": [
          "route.workspace_key",
          "route.comparison_id",
          "route.member"
        ],
        "response": "ticket_policy_pair"
      }
    ]
  }
}
