    "operator/web/scenario_analysis.mjs": [
      {
        "label": "source context controller import",
        "before": "import {createAnalysisDelivery} from './scenario_analysis_delivery.mjs';",
        "after": "import {createAnalysisDelivery} from './scenario_analysis_delivery.mjs';\nimport {createAnalysisSourceContext} from './analysis_source_context.mjs';"
      },
      {
        "label": "source context result tab",
        "before": "['coverage','Coverage and choices'],['source-areas','Source areas'],['delivery','GIS delivery'],['files','Download results']",
        "after": "['coverage','Coverage and choices'],['source-areas','Source areas'],['source-context','Source context'],['delivery','GIS delivery'],['files','Download results']"
      },
      {
        "label": "existing desk helper composition",
        "before": "  const delivery=createAnalysisDelivery({getState,api,endpoint,openDelivery,openReceivingPlan,openItem,onChange:()=>redraw()});",
        "after": "  const delivery=createAnalysisDelivery({getState,api,endpoint,openDelivery,openReceivingPlan,openItem,onChange:()=>redraw()});\n  const sourceContext=createAnalysisSourceContext({getState,api,endpoint,submitAction,openItem,fileList,onChange:()=>redraw()});"
      },
      {
        "label": "context report render",
        "before": "const body={physical,priority,sensitivity,pairs,coverage,'source-areas':sourceAreas,delivery:row=>delivery.render(row),files}[local.tab](record);",
        "after": "const body={physical,priority,sensitivity,pairs,coverage,'source-areas':sourceAreas,'source-context':row=>sourceContext.render(row),delivery:row=>delivery.render(row),files}[local.tab](record);"
      },
      {
        "label": "context-specific controls",
        "before": "(['files','source-areas','delivery'].includes(local.tab)?'':filters(record))",
        "after": "(['files','source-areas','source-context','delivery'].includes(local.tab)?'':filters(record))"
      },
      {
        "label": "lazy context source load",
        "before": "    if(local.tab==='delivery'&&selected())delivery.ensure(selected());",
        "after": "    if(local.tab==='delivery'&&selected())delivery.ensure(selected());\n    if(local.tab==='source-context'&&selected())sourceContext.ensure(selected());"
      },
      {
        "label": "context mount source load",
        "before": "    controller?.abort();container=node;controller=new AbortController();const g=++generation;",
        "after": "    controller?.abort();container=node;controller=new AbortController();const g=++generation;\n    if(local.tab==='source-context'&&selected())sourceContext.ensure(selected());"
      },
      {
        "label": "context form changes",
        "before": "      if(event.target.matches?.('[data-analysis-delivery-plan]')){delivery.selectPlan(selected(),event.target.value);return;}",
        "after": "      if(event.target.matches?.('[data-analysis-delivery-plan]')){delivery.selectPlan(selected(),event.target.value);return;}\n      if(event.target.dataset?.analysisContextField&&selected()){sourceContext.change(event,selected());return;}"
      },
      {
        "label": "current source and report state fingerprint",
        "before": "tasks:rows(current()?.tasks).filter(task=>task.action==='scenario.analyze')});",
        "after": "tasks:rows(current()?.tasks).filter(task=>task.action==='scenario.analyze'),source_context:sourceContext.fingerprint()});"
      },
      {
        "label": "context cancellation with native desk lifecycle",
        "before": "function detach(){generation++;controller?.abort();container=null;updateSignature='';}",
        "after": "function detach(){generation++;controller?.abort();sourceContext.detach();container=null;updateSignature='';}"
      },
      {
        "label": "existing action dispatcher",
        "before": "    if(action?.startsWith('delivery-'))return delivery.dispatch(node,selected());",
        "after": "    if(action?.startsWith('delivery-'))return delivery.dispatch(node,selected());\n    if(action?.startsWith('context-'))return sourceContext.dispatch(node,selected());"
      }
    ],
