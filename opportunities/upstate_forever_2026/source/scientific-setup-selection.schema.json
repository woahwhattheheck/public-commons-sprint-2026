{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:upstate:scientific-setup-selection:v1",
  "title": "Selection of original scientific setup objects",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "question",
    "domain_rationale",
    "grid_id",
    "profile_id",
    "baseline_scenario_id",
    "validation"
  ],
  "properties": {
    "schema": {
      "const": "upstate.scientific-setup-selection/v1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "domain_rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40000
    },
    "grid_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baseline_scenario_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "alternative_scenario_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "source_collection_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "observation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40000
        },
        "intended_comparison": {
          "type": "string",
          "maxLength": 40000
        },
        "limitations": {
          "type": "string",
          "maxLength": 40000
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scientific_reviewer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 500
            },
            "role": {
              "type": "string",
              "maxLength": 500
            },
            "organization": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "receiving_operator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 500
            },
            "role": {
              "type": "string",
              "maxLength": 500
            },
            "organization": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      }
    },
    "expected_resolution_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "expected_alternative_count": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      }
    }
  }
}
