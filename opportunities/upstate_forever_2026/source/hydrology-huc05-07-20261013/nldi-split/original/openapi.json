        "description":"The Network Linked Data Index (NLDI) pygeoapi service provides geoprocessing tools for tracing and analyzing hydrologic network relationships. It is intended for users who need to discover upstream and downstream connections, delineate local catchments, or work with stream-network navigation workflows. For most users, Processes are the main entry point for this service. Other generated sections are included for completeness, but most users should begin with Processes. Additional guidance is available in the public NLDI pygeoapi documentation at https://api.water.usgs.gov/docs/nldi-pygeoapi/.",
        "license":{
            "name":"CC0 1.0 license",
            "url":"https://creativecommons.org/publicdomain/zero/1.0/legalcode"
        },
        "termsOfService":"https://creativecommons.org/licenses/by/4.0/",
        "title":"Network Linked Data Index Geoprocessing Server",
        "version":"0.23.4",
        "x-keywords":[
            "geospatial",
            "data",
            "api"
        ]
    },
