{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upstate.classified-water-bindings/v1",
  "title": "Native SC DES classification field bindings",
  "type": "object",
  "required": [
    "layers"
  ],
  "properties": {
    "layers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "class_field",
          "name_field",
          "status",
          "vintage"
        ],
        "properties": {
          "class_field": {
            "type": "string",
            "minLength": 1
          },
          "name_field": {
            "type": "string",
            "minLength": 1
          },
          "description_field": {
            "type": "string",
            "minLength": 1
          },
          "county_field": {
            "type": "string",
            "minLength": 1
          },
          "ndz_field": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "current",
              "proposed"
            ],
            "description": "Current or proposed legal-edition context. Preserve provisional data status separately in data_status."
          },
          "vintage": {
            "type": "string",
            "minLength": 1
          },
          "class_values": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "county_values": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "description": "Explicit native county label or code to R.61-69 county abbreviation(s)."
          },
          "county_separator": {
            "type": "string",
            "description": "Regex separating multiple counties when the native scalar field uses a published delimiter."
          },
          "data_status": {
            "type": "string",
            "minLength": 1,
            "description": "Publisher or retained catalogue data-quality status, independent of the current/proposed legal edition; for this layer provisional."
          },
          "catalogue_source_id": {
            "type": "string",
            "minLength": 1,
            "description": "Exact entry ID in the retained source catalogue."
          },
          "source_metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Original catalogue labels, source references and other source metadata retained alongside legal_edition_status."
          }
        }
      }
    }
  },
  "additionalProperties": true
}
