{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upstate.classified-water-bindings/v1",
  "title": "Jurisdiction-qualified native classified-water field bindings",
  "type": "object",
  "required": [
    "layers"
  ],
  "properties": {
    "layers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "class_field",
          "name_field",
          "status",
          "vintage"
        ],
        "properties": {
          "class_field": {
            "type": "string",
            "minLength": 1
          },
          "name_field": {
            "type": "string",
            "minLength": 1
          },
          "description_field": {
            "type": "string",
            "minLength": 1
          },
          "county_field": {
            "type": "string",
            "minLength": 1
          },
          "ndz_field": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "current",
              "proposed",
              "source-published",
              "historical",
              "superseded"
            ],
            "description": "Explicit legal source edition status. A source-published reference is not silently asserted as current law; publisher data quality remains separate."
          },
          "vintage": {
            "type": "string",
            "minLength": 1
          },
          "class_values": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "county_values": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "description": "Explicit native county labels to same-jurisdiction legal registry county values. Historical SC mappings use original R.61-69 abbreviations."
          },
          "county_separator": {
            "type": "string",
            "description": "Regex separating multiple counties when the native scalar field uses a published delimiter."
          },
          "data_status": {
            "type": "string",
            "minLength": 1,
            "description": "Publisher or retained catalogue data-quality status, independent of the current/proposed legal edition; for this layer provisional."
          },
          "catalogue_source_id": {
            "type": "string",
            "minLength": 1,
            "description": "Exact entry ID in the retained source catalogue."
          },
          "source_metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Original catalogue labels, source references and other source metadata retained alongside legal_edition_status."
          },
          "jurisdiction": {
            "enum": [
              "SC",
              "NC",
              "GA"
            ]
          },
          "classification_system": {
            "enum": [
              "SC-R61-69",
              "NC-15A-NCAC-02B",
              "GA-391-3-6-.03"
            ]
          },
          "native_index_field": {
            "type": "string",
            "minLength": 1,
            "description": "Exact original metadata field containing the legal source index, such as BIMS_INDEX."
          },
          "effective_date_field": {
            "type": "string",
            "minLength": 1,
            "description": "Original native per-reach date field; raw source value remains distinct from legal effective_date."
          },
          "class_components": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "Source-declared GA literal label to original component names; exact label retained."
          },
          "classification_role": {
            "type": "string",
            "description": "Designated use, trout protection or other original source role."
          }
        },
        "dependentRequired": {
          "jurisdiction": [
            "classification_system"
          ],
          "classification_system": [
            "jurisdiction"
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
