              "path": "README.md"
            }
          ]
        }
      ]
    ],
    [
      "RL-18151 native station and delivery receiving",
      [
        "The original importer can now create the station geography selection from its actual imported source and observation identities, build the retained station through the maintained application, and update this report in its existing ordered scientific delivery request.",
        {
