{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:upstate:receiving-water-selection:1",
  "title": "Upstate receiving-water source selection",
  "description": "Select exact original Workspace assets and distinct designation vintages for water-specific model priorities.",
  "type": "object",
  "required": [
    "as_of",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": "upstate.receiving-water-selection/1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "analysis_crs": {
      "type": "string"
    },
    "notes": {},
    "catchments": {
      "allOf": [
        {
          "$ref": "#/$defs/source"
        }
      ],
      "properties": {
        "id_field": {
          "type": "string",
          "minLength": 1
        },
        "downstream_field": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "profile",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "enum": [
              "scdes_classified_streams",
              "scdes_classified_waters",
              "scdes_surface_intakes",
              "scdes_source_water_areas",
              "scdes_protection_zones"
            ]
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "service_url": {
            "type": "string",
            "format": "uri"
          },
          "layer_metadata": {
            "type": "object"
          },
          "layer_metadata_source": {
            "$ref": "#/$defs/source"
          },
          "field_map": {
            "type": "object",
            "properties": {
              "object_id": {
                "type": "string",
                "minLength": 1
              },
              "classification": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "system_id": {
                "type": "string",
                "minLength": 1
              },
              "intake_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "vintage": {
            "$ref": "#/$defs/vintage"
          },
          "include_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "ONRW",
                "ORW",
                "SFH",
                "TN",
                "TPGT",
                "TPT",
                "FW",
                "SA",
                "SB"
              ]
            }
          },
          "selection_rationale": {
            "type": "string",
            "minLength": 1
          },
          "status_filter": {
            "type": "object",
            "required": [
              "include"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "include": {
                "type": "array",
                "minItems": 1
              }
            },
            "additionalProperties": false
          },
          "relation": {
            "$ref": "#/$defs/relation"
          },
          "record_overrides": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "include": {
                  "type": "boolean"
                },
                "vintage": {
                  "type": "object"
                },
                "relation": {
                  "$ref": "#/$defs/relation"
                }
              },
              "additionalProperties": true
            }
          },
          "layer_metadata_companion": {
            "type": "string",
            "minLength": 1,
            "description": "Exact source_path of an original JSON metadata companion retained with this source; its body and original manifest are verified."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "profile": {
                  "enum": [
                    "scdes_classified_streams",
                    "scdes_classified_waters"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "include_classes",
                "selection_rationale"
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_collection_id",
        "source_id"
      ],
      "properties": {
        "source_collection_id": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": [
            "string",
            "integer"
          ]
        },
        "where": {
          "type": "object"
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "vintage": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "effective",
            "proposed",
            "historical",
            "unknown"
          ]
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "evidence": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "minProperties": 1
              }
            ]
          }
        },
        "retrieved_at": {
          "type": "string"
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "additionalProperties": true
    },
    "relation": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "upstream_huc",
            "source_area",
            "geometric_context"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "buffer_m": {
          "type": "number",
          "minimum": 0
        },
        "seed_huc_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{12}$"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": true
    }
  }
}
