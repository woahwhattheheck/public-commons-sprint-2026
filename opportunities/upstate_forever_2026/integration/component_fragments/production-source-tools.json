{
  "schema": "upstate.application-component-fragment/v1",
  "id": "production-source-tools",
  "source_reference": {
    "grid_source": "https://github.com/woahwhattheheck/public-commons-sprint-2026/pull/4247",
    "scenario_margins": "https://tokenjunkielabs.slack.com/archives/C0BTTA66TK3/p1791891915557799",
    "composition_checkpoint": "7b5d0f184989767a79fb1b6e4d24930509d5f849"
  },
  "components": {
    "source-grid-support": {
      "title": "Original regional source-grid compilation, offline exploration and editable import",
      "paths": [
        "source_tools/grid_support/README.md",
        "source_tools/grid_support/compile_grid_support.py",
        "source_tools/grid_support/compile_model_grid.py",
        "source_tools/grid_support/import_support.py",
        "source_tools/grid_support/prepare_handoff.py",
        "source_tools/grid_support/prepare_native_handoff.py",
        "source_tools/grid_support/render_landcover.py",
        "source_tools/grid_support/render_support.py"
      ],
      "requires": [
        "core",
        "source-preparation"
      ],
      "python_contexts": [
        {
          "prefix": "source_tools/grid_support",
          "import_roots": [
            "source_tools/grid_support"
          ]
        }
      ]
    },
    "scenario-decision-margins": {
      "title": "Completed native scenario decision margins and Economic receiving",
      "paths": [
        "source_tools/scenario_margin/README.md",
        "source_tools/scenario_margin/build.py",
        "source_tools/scenario_margin/desk.css",
        "source_tools/scenario_margin/desk.mjs",
        "source_tools/scenario_margin/intake.py"
      ],
      "requires": [
        "economic-desk",
        "study-transfer"
      ]
    },
    "application-composition-tools": {
      "title": "Complete JavaScript application source composition and original portable archive",
      "paths": [
        "source_tools/application_join.mjs",
        "source_tools/application_join_cli.mjs",
        "source_tools/APPLICATION_JOIN.md",
        "source_tools/carrier_codec.mjs",
        "source_tools/application_archive.mjs"
      ],
      "requires": [
        "core",
        "retained-application-source"
      ]
    }
  },
  "extend_components": {
    "core": {
      "paths": [
        "integration/component_fragments/production-source-tools.json",
        "integration/PRODUCTION_SOURCE_TOOLS.md",
        "CURRENT_OWNER_DIRECTION.md"
      ]
    },
    "chemistry": {
      "paths": [
        "model/chemistry_receiving.py",
        "operator/web/chemistry-native.mjs",
        "operator/CHEMISTRY_OPERATOR.md",
        "operator/install_chemistry.py",
        "integration/reach_chemistry/install_chemistry_legacy.py"
      ]
    },
    "assessment-source-delivery": {
      "paths": [
        "source_tools/ANNUAL_REFERENCE_ENRICHMENT.md"
      ]
    }
  },
  "required_components": [
    "source-grid-support",
    "scenario-decision-margins",
    "application-composition-tools",
    "chemistry",
    "assessment-source-delivery"
  ]
}
