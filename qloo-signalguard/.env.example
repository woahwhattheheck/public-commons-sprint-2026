# Qloo key only runs on the server; never put one in the browser or commit it.
QLOO_API_KEY=
PORT=3108

# Set to 0.0.0.0 only behind an HTTPS reverse proxy for a public demo.
HOST=127.0.0.1
# Each fresh LIVE audit makes at most four Qloo calls; cached/repeated audits do not.
MAX_LIVE_AUDITS_PER_HOUR=12

# Additional direct-TCP-peer guard: four fresh live audits per 10 minutes.
# At a reverse proxy, all requests may have the proxy IP; enforce IP limits at edge.
