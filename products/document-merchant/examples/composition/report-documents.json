{
  "schema": "stellar-forge.document-composition.v1",
  "id": "example-reports-20261012",
  "name": "Example report document set",
  "provider": "pdfmint",
  "merchantOrigin": null,
  "dataset": {
    "source": "reports.csv",
    "format": "csv",
    "delimiter": ","
  },
  "recordKey": "/Record ID",
  "taskReference": "report-{{report_id}}",
  "bindings": {
    "report_id": "/Record ID",
    "title": "/Report Title",
    "owner": "/Owner",
    "period": "/Period",
    "completed": "/Completed Items",
    "revenue": "/Revenue",
    "summary": "/Summary",
    "next_action": "/Next Action"
  },
  "templates": [
    {
      "id": "report",
      "source": "report.md",
      "format": "markdown",
      "title": "{{title}}",
      "label": "{{title}}"
    }
  ]
}
