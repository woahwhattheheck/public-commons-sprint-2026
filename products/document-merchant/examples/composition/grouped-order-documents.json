{
  "schema": "stellar-forge.document-composition.v1",
  "id": "example-order-lines-20261012",
  "name": "Example grouped order document set",
  "provider": "mintpdf",
  "merchantOrigin": null,
  "dataset": {
    "source": "order-lines.csv",
    "format": "csv",
    "delimiter": ",",
    "group": {
      "key": "order_id",
      "itemsAs": "items",
      "itemFields": [
        "sku",
        "description",
        "quantity",
        "unit_price_display",
        "line_total_display"
      ]
    }
  },
  "recordKey": "/order_id",
  "taskReference": "order-{{order_id}}",
  "bindings": {},
  "templates": [
    {
      "id": "invoice",
      "source": "invoice.html",
      "format": "html",
      "title": "Invoice {{order_id}}",
      "label": "Invoice {{order_id}}"
    },
    {
      "id": "greeting",
      "source": "greeting.html",
      "format": "html",
      "title": "Greeting for {{order_id}}",
      "label": "Greeting for {{order_id}}",
      "when": {
        "pointer": "/gift_message",
        "notEmpty": true
      }
    }
  ],
  "maxGeneratedBytes": 16777216
}
