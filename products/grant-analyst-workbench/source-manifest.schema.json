{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private complete Grant Analyst source authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "stellar-forge.grant-analyst-workbench-source.v1"
    },
    "files": {
      "type": "array",
      "minItems": 14,
      "maxItems": 25000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
