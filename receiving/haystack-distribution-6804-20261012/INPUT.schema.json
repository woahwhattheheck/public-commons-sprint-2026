{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Complete maintained Haystack distribution receiving",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "operationId",
    "directory",
    "repository",
    "sourceCommit",
    "cohort"
  ],
  "properties": {
    "format": {
      "const": "commons.haystack.distribution-receiving.v1"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{7,159}$"
    },
    "directory": {
      "type": "string",
      "pattern": "^/",
      "description": "Explicit original operation directory."
    },
    "repository": {
      "type": "string",
      "pattern": "^/",
      "description": "Existing retained standalone Git checkout; donor refs and worktree remain its owner's."
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "cohort": {
      "type": "object",
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 43,
          "maxItems": 43,
          "items": {
            "type": "object",
            "required": [
              "path",
              "gitBlobSha1",
              "content"
            ],
            "properties": {
              "path": {
                "enum": [
                  "products/haystack/OPERATING.md",
                  "stellar/scf-starforge-20261009/distribution/contributions/haystack-workspace.json",
                  "stellar/scf-starforge-20261009/distribution/selections/haystack-turnover.json",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/HAYSTACK_CONTRACT.md",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/HAYSTACK_LICENSE.txt",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/LICENSE",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/MERCHANT.md",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/OPERATING.md",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/README.md",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/RECEIVING.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/app.js",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/application-provider.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/browser-assets-loader.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/browser-assets.json",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/catalog.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/cli.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/client.d.mts",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/client.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/contribution.json",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/files.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/fixture-charlie.json",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/fixtures.json",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/haystack-index.d.mts",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/haystack-index.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/haystack-types.d.mts",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/haystack-types.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/index.html",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/json-codec.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/mcp.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/merchant-client.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/merchant-provider.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/merchant-setup.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/merchant-tools.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/merchant.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/model.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/package.json",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/portable.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/protocol.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/reports.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/server.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/store.mjs",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/style.css",
                  "stellar/scf-starforge-20261009/sf30-seller-sdk/haystack-workspace/util.mjs"
                ]
              },
              "gitBlobSha1": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "content": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "receivingDirectory": {
      "type": "string",
      "pattern": "^/",
      "description": "The already accepted original RECEIVING operation directory; completion is reused after full application/source identity checks."
    },
    "python": {
      "type": "string",
      "minLength": 1,
      "default": "python3"
    },
    "npm": {
      "type": "string",
      "minLength": 1,
      "default": "npm"
    },
    "npmCache": {
      "type": "string",
      "minLength": 1
    },
    "sourceOffline": {
      "type": "boolean",
      "default": false
    },
    "installOffline": {
      "type": "boolean",
      "default": true
    }
  }
}
