{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upstate.ensemble-design/v1",
  "title": "Source-aware paired watershed parameter ensemble",
  "type": "object",
  "required": [
    "title",
    "reason",
    "grid_id",
    "baseline_scenario_id",
    "base_profile_ids"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "grid_id": {
      "$ref": "#/$defs/id"
    },
    "baseline_scenario_id": {
      "$ref": "#/$defs/id"
    },
    "alternative_scenario_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true,
      "default": []
    },
    "base_profile_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "design": {
      "enum": [
        "factorial",
        "one_at_a_time"
      ],
      "default": "factorial"
    },
    "axes": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "id",
          "targets",
          "values",
          "reason",
          "references"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "ndr.threshold_flow_accumulation",
                "sdr.threshold_flow_accumulation",
                "ndr.flow_dir_algorithm",
                "sdr.flow_dir_algorithm",
                "ndr.k_param",
                "sdr.k_param",
                "ndr.subsurface_critical_length_n",
                "ndr.subsurface_eff_n",
                "ndr.runoff_proxy_av",
                "sdr.sdr_max",
                "sdr.ic_0_param",
                "sdr.l_max"
              ]
            }
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": [
                "number",
                "string"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "anyOf": [
                    {
                      "required": [
                        "url"
                      ]
                    },
                    {
                      "required": [
                        "source_id"
                      ]
                    },
                    {
                      "required": [
                        "citation"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "enum": [
          "ndr",
          "sdr"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Native models to execute. Omission inherits the retained grid. Both models canonicalize to omission in retained selections."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
