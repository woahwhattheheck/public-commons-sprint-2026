    "ndr": {
      "native_registry_id": "watershed_results_ndr",
      "path": "watershed_results_ndr.gpkg"
    },
    "sdr": {
      "native_registry_id": "watershed_results_sdr",
      "path": "watershed_results_sdr.shp",
      "required_sidecars": [
        ".shx",
        ".dbf",
        ".prj"
      ]
    }
  },
  "conventions": {
    "reporting_time_basis": "long_term_mean_annual",
    "mass_units": {
      "ndr": "kg",
      "sdr": "metric_tonne"
    },
    "suffix": "InVEST inserts results_suffix before the file extension; resolve through the run manifest.",
    "density_to_total": "sum(value_i * included_area_m2_i / 10000)",
    "native_north_up_area_m2": "abs(pixel_width_m * pixel_height_m)",
    "affine_area_m2": "abs(a*e-b*d)",
    "mean_density": "total_mass_per_year / valid_included_area_ha",
    "native_zonal_matching": "Use the same selected pixels and NoData masks as native pygeoprocessing.zonal_statistics for exact native-total reconciliation.",
    "reporting_fractional_polygons": "Fractional cell intersections may be used for reporting; record this method and do not demand equality to native pixel-selection totals.",
    "vector_totals": "Already annual totals; no second area multiplication.",
    "missing": "Distinguish metric_not_run, missing_output, all_nodata, and finite zero.",
    "overlap": "Each reporting polygon is independent; regional totals use a dissolved union or disjoint partition, never an unrestricted sum of overlapping utility catchments.",
    "annual_semantics": "Several v3.20.0 MODEL_SPEC output units omit /year. Preserve declared_unit separately; reporting_unit uses annual forcing/model semantics.",
    "method": "Post-processing contract consuming existing native outputs; no hydrology or transport model is reimplemented.",
    "native_unit_notation": "Normalized text representation of MODEL_SPEC units: u.none becomes 1, u.metric_ton becomes metric_tonne. Categorical class is a reporting type, not a native physical unit.",
    "spatial_requirements": {
      "coordinate_system": "projected",
      "linear_unit": "metre",
      "native_grid": "DEM grid",
      "reporting_area_unit": "ha",
      "density_area_denominator_m2": 10000
    }
  },
