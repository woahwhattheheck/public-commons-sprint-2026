  "derived_metrics": [
    {
      "id": "n_total_load",
      "formula": "n_surface_load+n_subsurface_load",
      "unit": "kg/year",
      "scope": "watershed"
    },
    {
      "id": "n_retained_from_watershed_sources",
      "formula": "n_surface_load+n_subsurface_load-n_total_export",
      "unit": "kg/year",
      "scope": "watershed",
      "attribution": "retained along source flowpaths; not local pixel retention"
    },
    {
      "id": "p_retained_from_watershed_sources",
      "formula": "p_surface_load-p_surface_export",
      "unit": "kg/year",
      "scope": "watershed",
      "attribution": "retained along source flowpaths; not local pixel retention"
    },
    {
      "id": "n_delivered_fraction",
      "formula": "n_total_export/(n_surface_load+n_subsurface_load)",
      "unit": "1",
      "scope": "matched_support",
      "zero_denominator": null
    },
    {
      "id": "p_delivered_fraction",
      "formula": "p_surface_export/p_surface_load",
      "unit": "1",
      "scope": "matched_support",
      "zero_denominator": null
    },
    {
      "id": "sed_delivered_fraction",
      "formula": "sed_export/usle",
      "unit": "1",
      "scope": "matched_support",
      "zero_denominator": null
