"ColumnOrdinal=38,ColumnSize=9,NumericPrecision=255,NumericScale=255,ProviderType=VarChar,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlString,DataTypeName=varchar","ColumnOrdinal=39,ColumnSize=30,NumericPrecision=255,NumericScale=255,ProviderType=VarChar,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlString,DataTypeName=varchar","ColumnOrdinal=40,ColumnSize=2,NumericPrecision=5,NumericScale=255,ProviderType=SmallInt,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlInt16,DataTypeName=smallint","ColumnOrdinal=41,ColumnSize=2,NumericPrecision=5,NumericScale=255,ProviderType=SmallInt,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlInt16,DataTypeName=smallint","ColumnOrdinal=42,ColumnSize=254,NumericPrecision=255,NumericScale=255,ProviderType=VarChar,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlString,DataTypeName=varchar","ColumnOrdinal=43,ColumnSize=254,NumericPrecision=255,NumericScale=255,ProviderType=VarChar,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlString,DataTypeName=varchar","ColumnOrdinal=44,ColumnSize=2,NumericPrecision=5,NumericScale=255,ProviderType=SmallInt,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlInt16,DataTypeName=smallint","ColumnOrdinal=45,ColumnSize=4,NumericPrecision=10,NumericScale=255,ProviderType=Int,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlInt32,DataTypeName=int","ColumnOrdinal=46,ColumnSize=2,NumericPrecision=5,NumericScale=255,ProviderType=SmallInt,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlInt16,DataTypeName=smallint","ColumnOrdinal=47,ColumnSize=2147483647,NumericPrecision=255,NumericScale=255,ProviderType=VarChar,IsLong=True,ProviderSpecificDataType=System.Data.SqlTypes.SqlString,DataTypeName=varchar","ColumnOrdinal=48,ColumnSize=4,NumericPrecision=10,NumericScale=255,ProviderType=Int,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlInt32,DataTypeName=int","ColumnOrdinal=49,ColumnSize=8,NumericPrecision=23,NumericScale=3,ProviderType=DateTime,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlDateTime,DataTypeName=datetime","ColumnOrdinal=50,ColumnSize=50,NumericPrecision=255,NumericScale=255,ProviderType=VarChar,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlString,DataTypeName=varchar","ColumnOrdinal=51,ColumnSize=2,NumericPrecision=5,NumericScale=255,ProviderType=SmallInt,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlInt16,DataTypeName=smallint","ColumnOrdinal=52,ColumnSize=2,NumericPrecision=5,NumericScale=255,ProviderType=SmallInt,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlInt16,DataTypeName=smallint","ColumnOrdinal=53,ColumnSize=4,NumericPrecision=10,NumericScale=255,ProviderType=Int,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlInt32,DataTypeName=int","ColumnOrdinal=54,ColumnSize=20,NumericPrecision=255,NumericScale=255,ProviderType=VarChar,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlString,DataTypeName=varchar","ColumnOrdinal=55,ColumnSize=2,NumericPrecision=5,NumericScale=255,ProviderType=SmallInt,IsLong=False,ProviderSpecificDataType=System.Data.SqlTypes.SqlInt16,DataTypeName=smallint","ColumnOrdinal=56,ColumnSize=2147483647,NumericPrecision=255,NumericScale=255,ProviderType=VarChar,IsLong=True,ProviderSpecificDataType=System.Data.SqlTypes.SqlString,DataTypeName=varchar"],["19","K Factor, Rock Free","chorizon","kffact","Choice","254",null,"Erosion factor K indicates the susceptibility of a soil to sheet and rill erosion by water. Factor K is one of six factors used in the Universal Soil Loss Equation (USLE) and the Revised Universal Soil Loss Equation (RUSLE) to predict the average annual rate of soil loss by sheet and rill erosion in tons per acre per year. The estimates are based primarily on percentage of silt, sand, and organic matter and on soil structure and saturated hydraulic conductivity (Ksat). Values of K range from 0.02 to 0.69. Other factors being equal, the higher the value, the more susceptible the soil is to sheet and rill erosion by water.\n\n\"Erosion factor Kf (rock free)\" indicates the erodibility of the fine-earth fraction, or the material less than 2 millimeters in size.\n\nFactor K does not apply to organic horizons and is not reported for those layers.",null,null,"Property",null,null,null,"0","1","0","1",null,"0",null,null,"1","KfactRF",null,null,null,null,null,null,null,"1","Surface Layer",null,null,null,"0",null,null,"Weighted Average","0","0",null,null,"0","7",null,"\u003cMap_Legend maplegendkey=\"7\"\u003e\r\n  \u003cColorRampType type=\"1\" name=\"Progressive\" count=\"3\"\u003e\r\n    \u003cLowerColor part=\"0\" algorithm=\"1\" red=\"255\" green=\"0\" blue=\"0\" /\u003e\r\n    \u003cUpperColor part=\"0\" algorithm=\"1\" red=\"255\" green=\"255\" blue=\"0\" /\u003e\r\n    \u003cLowerColor part=\"1\" algorithm=\"1\" red=\"255\" green=\"255\" blue=\"0\" /\u003e\r\n    \u003cUpperColor part=\"1\" algorithm=\"1\" red=\"0\" green=\"255\" blue=\"255\" /\u003e\r\n    \u003cLowerColor part=\"2\" algorithm=\"1\" red=\"0\" green=\"255\" blue=\"255\" /\u003e\r\n    \u003cUpperColor part=\"2\" algorithm=\"1\" red=\"0\" green=\"0\" blue=\"255\" /\u003e\r\n  \u003c/ColorRampType\u003e\r\n  \u003cLegend_Symbols shapeType=\"polygon\"\u003e\r\n    \u003cStyles fillStyle=\"esriSFSSolid\" /\u003e\r\n    \u003cFont type=\"Times New Roman\" size=\"8\" red=\"0\" green=\"0\" blue=\"0\" /\u003e\r\n    \u003cLine type=\"outline\" width=\"0.4\" red=\"0\" green=\"0\" blue=\"0\" /\u003e\r\n  \u003c/Legend_Symbols\u003e\r\n  \u003cLegend_Elements transparency=\"0\"\u003e\r\n    \u003cLabels value=\".02\" label=\".02\" order=\"1\" /\u003e\r\n    \u003cLabels value=\".05\" label=\".05\" order=\"2\" /\u003e\r\n    \u003cLabels value=\".10\" label=\".10\" order=\"3\" /\u003e\r\n    \u003cLabels value=\".15\" label=\".15\" order=\"4\" /\u003e\r\n    \u003cLabels value=\".17\" label=\".17\" order=\"5\" /\u003e\r\n    \u003cLabels value=\".20\" label=\".20\" order=\"6\" /\u003e\r\n    \u003cLabels value=\".24\" label=\".24\" order=\"7\" /\u003e\r\n    \u003cLabels value=\".28\" label=\".28\" order=\"8\" /\u003e\r\n    \u003cLabels value=\".32\" label=\".32\" order=\"9\" /\u003e\r\n    \u003cLabels value=\".37\" label=\".37\" order=\"10\" /\u003e\r\n    \u003cLabels value=\".43\" label=\".43\" order=\"11\" /\u003e\r\n    \u003cLabels value=\".49\" label=\".49\" order=\"12\" /\u003e\r\n    \u003cLabels value=\".55\" label=\".55\" order=\"13\" /\u003e\r\n    \u003cLabels value=\".64\" label=\".64\" order=\"14\" /\u003e\r\n  \u003c/Legend_Elements\u003e\r\n\u003c/Map_Legend\u003e","1","1/28/2021 4:52:23 AM","Dominant Condition",null,"1","11","Choice","0","Added information about organic horizons not being populated."],["51","K Factor, Whole Soil","chorizon","kwfact","Choice","254",null,"Erosion factor K indicates the susceptibility of a soil to sheet and rill erosion by water. Factor K is one of six factors used in the Universal Soil Loss Equation (USLE) and the Revised Universal Soil Loss Equation (RUSLE) to predict the average annual rate of soil loss by sheet and rill erosion in tons per acre per year. The estimates are based primarily on percentage of silt, sand, and organic matter and on soil structure and saturated hydraulic conductivity (Ksat). Values of K range from 0.02 to 0.69. Other factors being equal, the higher the value, the more susceptible the soil is to sheet and rill erosion by water.\n\n\"Erosion factor Kw (whole soil)\" indicates the erodibility of the whole soil. The estimates are modified by the presence of rock fragments.\n\nFactor K does not apply to organic horizons and is not reported for those layers.",null,null,"Property",null,null,null,"0","1","0","1",null,"0",null,null,"1","KfactWS",null,null,null,null,null,null,null,"1","Surface Layer",null,null,null,"0",null,null,"Weighted Average","0","0",null,null,"0","7",null,"\u003cMap_Legend maplegendkey=\"7\"\u003e\r\n  \u003cColorRampType type=\"1\" name=\"Progressive\" count=\"3\"\u003e\r\n    \u003cLowerColor part=\"0\" algorithm=\"1\" red=\"255\" green=\"0\" blue=\"0\" /\u003e\r\n    \u003cUpperColor part=\"0\" algorithm=\"1\" red=\"255\" green=\"255\" blue=\"0\" /\u003e\r\n    \u003cLowerColor part=\"1\" algorithm=\"1\" red=\"255\" green=\"255\" blue=\"0\" /\u003e\r\n    \u003cUpperColor part=\"1\" algorithm=\"1\" red=\"0\" green=\"255\" blue=\"255\" /\u003e\r\n    \u003cLowerColor part=\"2\" algorithm=\"1\" red=\"0\" green=\"255\" blue=\"255\" /\u003e\r\n    \u003cUpperColor part=\"2\" algorithm=\"1\" red=\"0\" green=\"0\" blue=\"255\" /\u003e\r\n  \u003c/ColorRampType\u003e\r\n  \u003cLegend_Symbols shapeType=\"polygon\"\u003e\r\n    \u003cStyles fillStyle=\"esriSFSSolid\" /\u003e\r\n    \u003cFont type=\"Times New Roman\" size=\"8\" red=\"0\" green=\"0\" blue=\"0\" /\u003e\r\n    \u003cLine type=\"outline\" width=\"0.4\" red=\"0\" green=\"0\" blue=\"0\" /\u003e\r\n  \u003c/Legend_Symbols\u003e\r\n  \u003cLegend_Elements transparency=\"0\"\u003e\r\n    \u003cLabels value=\".02\" label=\".02\" order=\"1\" /\u003e\r\n    \u003cLabels value=\".05\" label=\".05\" order=\"2\" /\u003e\r\n    \u003cLabels value=\".10\" label=\".10\" order=\"3\" /\u003e\r\n    \u003cLabels value=\".15\" label=\".15\" order=\"4\" /\u003e\r\n    \u003cLabels value=\".17\" label=\".17\" order=\"5\" /\u003e\r\n    \u003cLabels value=\".20\" label=\".20\" order=\"6\" /\u003e\r\n    \u003cLabels value=\".24\" label=\".24\" order=\"7\" /\u003e\r\n    \u003cLabels value=\".28\" label=\".28\" order=\"8\" /\u003e\r\n    \u003cLabels value=\".32\" label=\".32\" order=\"9\" /\u003e\r\n    \u003cLabels value=\".37\" label=\".37\" order=\"10\" /\u003e\r\n    \u003cLabels value=\".43\" label=\".43\" order=\"11\" /\u003e\r\n    \u003cLabels value=\".49\" label=\".49\" order=\"12\" /\u003e\r\n    \u003cLabels value=\".55\" label=\".55\" order=\"13\" /\u003e\r\n    \u003cLabels value=\".64\" label=\".64\" order=\"14\" /\u003e\r\n  \u003c/Legend_Elements\u003e\r\n\u003c/Map_Legend\u003e","1","1/28/2021 4:50:51 AM","Dominant Condition",null,"1","11","Choice","0","Added information about organic horizons not being populated."],["71","Wind Erodibility Group","component","weg","Choice","254",null,"A wind erodibility group (WEG) consists of soils that have similar properties affecting their susceptibility to wind erosion in cultivated areas. The soils assigned to group 1 are the most susceptible to wind erosion, and those assigned to group 8 are the least susceptible.",null,null,"Property",null,null,null,"0","1","0","0",null,"0",null,null,"-1","WEG",null,null,null,null,null,null,null,"0",null,null,null,null,"0",null,null,"Weighted Average","0","0",null,null,"1","7",null,"\u003cMap_Legend maplegendkey=\"7\"\u003e\u003cColorRampType type=\"1\" name=\"Progressive\" count=\"3\"\u003e\u003cLowerColor part=\"0\" algorithm=\"1\" red=\"255\" green=\"0\" blue=\"0\" /\u003e\u003cUpperColor part=\"0\" algorithm=\"1\" red=\"255\" green=\"255\" blue=\"0\" /\u003e\u003cLowerColor part=\"1\" algorithm=\"1\" red=\"255\" green=\"255\" blue=\"0\" /\u003e\u003cUpperColor part=\"1\" algorithm=\"1\" red=\"0\" green=\"255\" blue=\"255\" /\u003e\u003cLowerColor part=\"2\" algorithm=\"1\" red=\"0\" green=\"255\" blue=\"255\" /\u003e\u003cUpperColor part=\"2\" algorithm=\"1\" red=\"0\" green=\"0\" blue=\"255\" /\u003e\u003c/ColorRampType\u003e\u003cLegend_Symbols shapeType=\"polygon\"\u003e\u003cStyles fillStyle=\"esriSFSSolid\" /\u003e\u003cFont type=\"Times New Roman\" size=\"8\" red=\"0\" green=\"0\" blue=\"0\" /\u003e\u003cLine type=\"outline\" width=\"0.4\" red=\"0\" green=\"0\" blue=\"0\" /\u003e\u003c/Legend_Symbols\u003e\u003cLegend_Elements transparency=\"0\"\u003e\u003cLabels value=\"1\" label=\"1\" order=\"1\" /\u003e\u003cLabels value=\"2\" label=\"2\" order=\"2\" /\u003e\u003cLabels value=\"3\" label=\"3\" order=\"3\" /\u003e\u003cLabels value=\"4\" label=\"4\" order=\"4\" /\u003e\u003cLabels value=\"4L\" label=\"4L\" order=\"5\" /\u003e\u003cLabels value=\"5\" label=\"5\" order=\"6\" /\u003e\u003cLabels value=\"6\" label=\"6\" order=\"7\" /\u003e\u003cLabels value=\"7\" label=\"7\" order=\"8\" /\u003e\u003cLabels value=\"8\" label=\"8\" order=\"9\" /\u003e\u003c/Legend_Elements\u003e\u003c/Map_Legend\u003e","1","3/4/2007 9:05:09 AM","Dominant Condition",null,"1","11","Choice",null,null],["4","Wind Erodibility Index","component","wei","Choice","254",null,"The wind erodibility index is a numerical value indicating the susceptibility of soil to wind erosion, or the tons per acre per year that can be expected to be lost to wind erosion. There is a close correlation between wind erosion and the texture of the surface layer, the size and durability of surface clods, rock fragments, organic matter, and a calcareous reaction. Soil moisture and frozen soil layers also influence wind erosion.","tons per acre per year","tons/acre/yr","Property",null,null,null,"0","1","0","0","wind_erodibility_index","1",null,null,"1","WEI",null,null,null,null,null,null,null,"0",null,null,null,null,"0",null,null,"Weighted Average","0","0",null,null,"1","7",null,"\u003cMap_Legend maplegendkey=\"7\"\u003e\u003cColorRampType type=\"1\" name=\"Progressive\" count=\"3\"\u003e\u003cLowerColor part=\"0\" algorithm=\"1\" red=\"255\" green=\"0\" blue=\"0\" /\u003e\u003cUpperColor part=\"0\" algorithm=\"1\" red=\"255\" green=\"255\" blue=\"0\" /\u003e\u003cLowerColor part=\"1\" algorithm=\"1\" red=\"255\" green=\"255\" blue=\"0\" /\u003e\u003cUpperColor part=\"1\" algorithm=\"1\" red=\"0\" green=\"255\" blue=\"255\" /\u003e\u003cLowerColor part=\"2\" algorithm=\"1\" red=\"0\" green=\"255\" blue=\"255\" /\u003e\u003cUpperColor part=\"2\" algorithm=\"1\" red=\"0\" green=\"0\" blue=\"255\" /\u003e\u003c/ColorRampType\u003e\u003cLegend_Symbols shapeType=\"polygon\"\u003e\u003cStyles fillStyle=\"esriSFSSolid\" /\u003e\u003cFont type=\"Times New Roman\" size=\"8\" red=\"0\" green=\"0\" blue=\"0\" /\u003e\u003cLine type=\"outline\" width=\"0.4\" red=\"0\" green=\"0\" blue=\"0\" /\u003e\u003c/Legend_Symbols\u003e\u003cLegend_Elements transparency=\"0\"\u003e\u003cLabels value=\"0\" label=\"0\" order=\"1\" /\u003e\u003cLabels value=\"38\" label=\"38\" order=\"2\" /\u003e\u003cLabels value=\"48\" label=\"48\" order=\"3\" /\u003e\u003cLabels value=\"56\" label=\"56\" order=\"4\" /\u003e\u003cLabels value=\"86\" label=\"86\" order=\"5\" /\u003e\u003cLabels value=\"134\" label=\"134\" order=\"6\" /\u003e\u003cLabels value=\"160\" label=\"160\" order=\"7\" /\u003e\u003cLabels value=\"180\" label=\"180\" order=\"8\" /\u003e\u003cLabels value=\"220\" label=\"220\" order=\"9\" /\u003e\u003cLabels value=\"250\" label=\"250\" order=\"10\" /\u003e\u003cLabels value=\"310\" label=\"310\" order=\"11\" /\u003e\u003c/Legend_Elements\u003e\u003c/Map_Legend\u003e","1","3/4/2007 9:06:40 AM","Dominant Condition",null,"1","11","Choice",null,null]]}