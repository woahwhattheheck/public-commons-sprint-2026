{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stellar-forge:openlineage:analysis-facets:v1",
  "title": "Stellar Forge Analysis custom facets, version 1",
  "description": "Exact metadata projected from original completed Analysis jobs, immutable dataset versions, complete query exports and retained workbook deliveries. Full native records are retained in the private publication handover.",
  "$defs": {
    "nativeId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "StellarForgeAnalysisMetadata": {
      "type": "object",
      "properties": {
        "_producer": {
          "type": "string",
          "format": "uri"
        },
        "_schemaURL": {
          "type": "string",
          "format": "uri"
        },
        "analysis_workspace_id": {
          "$ref": "#/$defs/nativeId"
        },
        "native_job_id": {
          "$ref": "#/$defs/nativeId"
        },
        "original_job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/nativeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrospective": {
          "const": true
        },
        "time_basis": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "native_request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "native_result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_binding_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "binding_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sql_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parameters_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewed_query_result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version_id": {
          "$ref": "#/$defs/sha256"
        },
        "reviewed_query_id": {
          "$ref": "#/$defs/nativeId"
        },
        "reviewed_parent_job_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nativeId"
          },
          "uniqueItems": true
        },
        "sql_included": {
          "type": "boolean"
        },
        "sql": {
          "type": "string",
          "description": "Original SQL text only when the operator explicitly selected include_sql; parameter values remain local."
        },
        "columns": {
          "type": "array"
        },
        "column_mapping": {
          "type": "array"
        },
        "sheet_mappings": {
          "type": "array"
        },
        "row_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "preview_rows": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "preview_truncated": {
          "type": "boolean"
        },
        "reviewed_preview_truncated": {
          "type": "boolean"
        },
        "incomplete_acknowledged": {
          "type": "boolean"
        },
        "original_payment_status": {
          "type": [
            "string",
            "boolean",
            "null"
          ]
        },
        "response_status": {
          "type": [
            "string",
            "boolean",
            "null"
          ]
        },
        "settlement_status": {
          "type": [
            "string",
            "boolean",
            "null"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "bytes",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "StellarForgeAnalysisRunFacet": {
      "title": "StellarForgeAnalysisRunFacet",
      "description": "Original retained Analysis run metadata; custom facet key stellarForge_analysis.",
      "allOf": [
        {
          "$ref": "https://openlineage.io/spec/2-0-2/OpenLineage.json#/$defs/RunFacet"
        },
        {
          "$ref": "#/$defs/StellarForgeAnalysisMetadata"
        }
      ]
    },
    "StellarForgeAnalysisJobFacet": {
      "title": "StellarForgeAnalysisJobFacet",
      "description": "Original retained Analysis job metadata; custom facet key stellarForge_analysis.",
      "allOf": [
        {
          "$ref": "https://openlineage.io/spec/2-0-2/OpenLineage.json#/$defs/JobFacet"
        },
        {
          "$ref": "#/$defs/StellarForgeAnalysisMetadata"
        }
      ]
    },
    "StellarForgeAnalysisDatasetFacet": {
      "title": "StellarForgeAnalysisDatasetFacet",
      "description": "Original retained Analysis dataset metadata; custom facet key stellarForge_analysis.",
      "allOf": [
        {
          "$ref": "https://openlineage.io/spec/2-0-2/OpenLineage.json#/$defs/DatasetFacet"
        },
        {
          "$ref": "#/$defs/StellarForgeAnalysisMetadata"
        }
      ]
    }
  }
}
