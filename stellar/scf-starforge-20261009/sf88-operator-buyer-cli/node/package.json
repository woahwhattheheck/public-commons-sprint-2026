{
  "name": "@stellar-forge/native-buyer",
  "version": "0.1.0",
  "description": "Durable Node applications using the original Stellar Forge SF88 buyer runtime",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs"
    },
    "./agents": {
      "types": "./agents/operation.d.mts",
      "import": "./agents/operation.mjs"
    },
    "./agents/langgraph": {
      "types": "./agents/langgraph.d.mts",
      "import": "./agents/langgraph.mjs"
    },
    "./agents/langchain": {
      "types": "./agents/langchain.d.mts",
      "import": "./agents/langchain.mjs"
    },
    "./agents/sqlite": {
      "types": "./agents/sqlite.d.mts",
      "import": "./agents/sqlite.mjs"
    },
    "./unstructured": {
      "types": "./unstructured/index.d.mts",
      "import": "./unstructured/index.mjs"
    }
  },
  "files": [
    "*.mjs",
    "index.d.mts",
    "README.md",
    "OBJECTS.md",
    "STREAMS.md",
    "ACCOUNTING.md",
    "RECOVERY.md",
    "INBOX.md",
    "WORKSPACE.md",
    "ACQUISITIONS.md",
    "examples",
    "agents",
    "FRAMEWORKS.md",
    "unstructured"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.21",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "zod": "^3.25.32 || ^4.2.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@langchain/langgraph-checkpoint-sqlite": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
