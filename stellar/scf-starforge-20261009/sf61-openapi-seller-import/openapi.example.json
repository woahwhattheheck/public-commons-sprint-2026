{
  "openapi": "3.1.1",
  "info": { "title": "Illustrative weather API", "version": "1.0.0" },
  "servers": [{ "url": "https://weather.example/api/v1" }],
  "components": {
    "parameters": {
      "City": { "name": "city", "in": "path", "required": true,
        "schema": { "type": "string", "examples": ["Louisville"] } }
    },
    "schemas": {
      "Coordinates": { "type": "object", "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }, "required": ["latitude", "longitude"], "additionalProperties": false }
    }
  },
  "paths": {
    "/forecast/{city}": {
      "parameters": [{ "$ref": "#/components/parameters/City" },
        { "name": "days", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 7, "default": 1 } }],
      "get": { "operationId": "cityForecast", "summary": "Forecast for one city", "tags": ["weather"],
        "parameters": [{ "name": "days", "in": "query", "required": true,
          "description": "Number of forecast days", "schema": { "type": "integer", "minimum": 1, "maximum": 7, "examples": [1] }, "example": 3 }],
        "responses": { "200": { "description": "Forecast" } } }
    },
    "/forecast": {
      "post": { "operationId": "coordinateForecast", "summary": "Forecast from coordinates", "tags": ["weather"],
        "servers": [{ "url": "https://weather.example/api/v2" }],
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "$ref": "#/components/schemas/Coordinates" },
          "example": { "latitude": 38.25, "longitude": -85.76 }
        } } }, "responses": { "200": { "description": "Forecast" } } }
    }
  }
}
