{
  "schema": "stellar-forge.openalex-merchant.v1",
  "title": "OpenAlex research metadata",
  "publicOrigin": "https://merchant.example",
  "provider": {
    "account": "openalex-keyless"
  },
  "budget": {
    "creditsPerDay": 1000,
    "requestsPerSecond": 5
  },
  "timeoutMs": 30000,
  "maxResponseBytes": 16777216,
  "products": [
    {
      "id": "works",
      "path": "/research/works",
      "entity": "works",
      "kind": "list",
      "requireFilter": true,
      "description": "OpenAlex works matching a retained research query",
      "paymentOptions": [
        {
          "scheme": "exact",
          "network": "stellar:testnet",
          "asset": "UNVERIFIED_DEMO_ASSET",
          "payTo": "UNVERIFIED_DEMO_RECIPIENT",
          "amount": "10000",
          "maxTimeoutSeconds": 60
        }
      ],
      "example": {
        "search": "greenhouse AND \"heat pump\"",
        "per_page": "100",
        "cursor": "*"
      }
    },
    {
      "id": "work",
      "path": "/research/work",
