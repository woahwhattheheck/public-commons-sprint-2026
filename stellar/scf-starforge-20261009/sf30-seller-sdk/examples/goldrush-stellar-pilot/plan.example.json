    "transfers": {"accepts": [{"scheme": "exact", "network": "stellar:testnet", "asset": "REPLACE_WITH_PROVIDER_SEP41_CONTRACT", "payTo": "REPLACE_WITH_PROVIDER_STELLAR_RECIPIENT", "amount": "100000", "maxTimeoutSeconds": 120}]}
  }
}
