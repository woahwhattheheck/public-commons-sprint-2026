{
  "schema": "stellar-forge.seller-service.v1",
  "routes": [
    {
      "id": "dataset",
      "path": "/dataset",
      "definition": {
        "method": "GET",
        "serviceName": "Local Dataset API",
        "description": "A small local example dataset behind an x402 seller route",
        "tags": ["dataset", "example"],
        "payment": {
          "scheme": "exact",
          "network": "stellar:testnet",
          "asset": "UNVERIFIED_DEMO_ASSET",
          "payTo": "UNVERIFIED_DEMO_RECIPIENT",
          "amount": "10000",
          "maxTimeoutSeconds": 60
        },
        "outputExample": {"dataset": "local-example", "rows": [{"region": "north", "value": 4}]}
      },
      "response": {"dataset": "local-example", "rows": [{"region": "north", "value": 4}, {"region": "south", "value": 7}]}
    }
  ]
}
