{
  "schema": "stellar-forge.open311-service-configuration-host.v1",
  "workspaces": {
    "operations": {
      "label": "Agency service configuration",
      "directory": "/absolute/private/service-configuration",
      "inputs": {
        "requests": {
          "label": "Complete original request register",
          "path": "/absolute/original/requests.json",
          "sha256": "REPLACE_WITH_COMPLETE_ORIGINAL_REQUEST_FILE_SHA256",
          "kind": "source",
          "format": "json"
        },
        "configuration": {
          "label": "Complete selected service profile",
          "path": "/absolute/original/service-definition.json",
          "sha256": "REPLACE_WITH_COMPLETE_ORIGINAL_PROFILE_FILE_SHA256",
          "kind": "profile",
          "format": "json"
        }
      }
    },
    "received": {
      "label": "Received agency service configuration",
      "directory": "/absolute/private/received-service-configuration",
      "inputs": {
        "handover": {
          "label": "Complete editable service workspace",
          "path": "/absolute/handover/service-workspace.json",
          "sha256": "REPLACE_WITH_COMPLETE_ORIGINAL_WORKSPACE_FILE_SHA256",
          "kind": "workspace",
          "format": "json"
        }
      }
    }
  }
}
