{
  "schema": "stellar-forge.open311-follow-through-host.v1",
  "workspaces": {
    "municipal": {
      "label": "Municipal follow-through",
      "directory": "./follow-through",
      "inputs": {
        "requests": {
          "label": "Original municipal request source",
          "path": "./original-requests.json",
          "sha256": "REPLACE_WITH_THE_COMPLETE_FILE_SHA256",
          "kind": "source",
          "format": "json"
        },
        "metadata": {
          "label": "Original service/layer metadata",
          "path": "./original-layer-metadata.json",
          "sha256": "REPLACE_WITH_THE_COMPLETE_FILE_SHA256",
          "kind": "metadata",
          "format": "json"
        },
        "review": {
          "label": "Returned source-linked reviewer file",
          "path": "./reviewer-return.json",
          "sha256": "REPLACE_WITH_THE_COMPLETE_FILE_SHA256",
          "kind": "review",
          "format": "json"
        },
        "receiving": {
          "label": "Complete editable follow-through workspace",
          "path": "./complete-follow-through.json",
          "sha256": "REPLACE_WITH_THE_COMPLETE_FILE_SHA256",
          "kind": "workspace",
          "format": "json"
        }
      }
    }
  }
}
