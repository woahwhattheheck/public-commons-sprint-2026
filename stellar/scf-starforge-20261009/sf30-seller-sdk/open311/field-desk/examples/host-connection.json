{
  "schema": "stellar-forge.open311-field-desk-host.v1",
  "workspaces": {
    "operations": {
      "label": "Municipal field work",
      "directory": "/absolute/private/field-desk",
      "inputs": {
        "dispatch": {
          "label": "Complete approved Follow-through dispatch",
          "path": "/absolute/handover/reviewed-dispatch.json",
          "sha256": "REPLACE_WITH_COMPLETE_ORIGINAL_FILE_SHA256",
          "kind": "source",
          "format": "json"
        },
        "returned": {
          "label": "Original crew return",
          "path": "/absolute/handover/crew-return.json",
          "sha256": "REPLACE_WITH_COMPLETE_ORIGINAL_FILE_SHA256",
          "kind": "return",
          "format": "json"
        },
        "context": {
          "label": "Original selected task context",
          "path": "/absolute/handover/task-context.json",
          "sha256": "REPLACE_WITH_COMPLETE_ORIGINAL_FILE_SHA256",
          "kind": "attachment",
          "format": "binary",
          "contentType": "application/json"
        }
      }
    },
    "received": {
      "label": "Received editable field work",
      "directory": "/absolute/private/received-field-desk",
      "inputs": {
        "workspace": {
          "label": "Complete editable Field Desk",
          "path": "/absolute/handover/editable-field-workspace.json",
          "sha256": "REPLACE_WITH_COMPLETE_ORIGINAL_FILE_SHA256",
          "kind": "workspace",
          "format": "json"
        }
      }
    }
  }
}
