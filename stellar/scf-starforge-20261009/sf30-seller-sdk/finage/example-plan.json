{
  "schema": "commons.finage.acquisition.v1",
  "id": "customer-selected-capture-001",
  "title": "Customer selected Finage REST and stream capture",
  "accountAlias": "existing-customer-account",
  "selectedEdition": "selected-forex-observation",
  "requests": [
    {
      "id": "aapl-minute-recovery",
      "operation": "stock-aggregates",
      "pathParams": {
        "symbol": "AAPL",
        "multiply": 1,
        "time": "minute",
        "from": "2025-02-05",
        "to": "2025-02-07"
      },
      "query": {
        "limit": 50000,
        "sort": "asc",
        "date_format": "ts",
        "dbt_filter": false
      },
      "edition": {
        "id": "aapl-minute-recovery",
        "label": "Selected AAPL minute recovery window"
      }
    },
    {
      "id": "selected-stock-snapshot",
      "operation": "stock-snapshot",
      "query": {
        "quotes": true,
        "trades": true,
        "symbols": "AAPL,MSFT,NVDA"
      },
      "edition": {
        "id": "selected-stock-snapshot",
        "label": "Selected stock snapshot"
      }
    }
  ],
  "websockets": [
    {
      "id": "selected-forex-observation",
      "server": "wss://YOUR_ASSIGNED_SUBDOMAIN.finage.ws:443/",
      "market": "forex",
      "symbols": "EURUSD,GBPUSD,USDJPY",
      "durationSeconds": 60,
      "reconnect": {
        "maxAttempts": 1,
        "delaySeconds": 2
      },
      "edition": {
        "id": "selected-forex-observation",
        "label": "Customer authorized Forex observation"
      },
      "provenance": {
        "selectionNote": "Replace server, port, symbols and dates with the existing account's actual authorized selections. This plan is configuration, not a captured session."
      }
    }
  ]
}
