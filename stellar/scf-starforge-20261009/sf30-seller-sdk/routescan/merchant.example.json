{
  "schema": "stellar-forge.routescan-merchant.v1",
  "title": "Routescan gas analytics",
  "publicOrigin": "https://merchant.example",
  "provider": { "network": "mainnet", "chainId": "43114", "account": "routescan-keyless" },
  "quota": { "requestsPerSecond": 2, "callsPerDay": 10000 },
  "maxRangeDays": 31,
  "units": ["hour", "day"],
  "timeoutMs": 15000,
  "maxResponseBytes": 1048576,
  "products": [
    {
      "id": "gasSeries", "path": "/gas/average", "operation": "series",
      "description": "Routescan average gas price series on Avalanche C-Chain",
      "paymentOptions": [{ "scheme": "exact", "network": "stellar:testnet", "asset": "UNVERIFIED_DEMO_ASSET", "payTo": "UNVERIFIED_DEMO_RECIPIENT", "amount": "10000", "maxTimeoutSeconds": 60 }],
      "example": { "dateFrom": "2026-10-08T00:00:00Z", "dateTo": "2026-10-09T00:00:00Z", "unit": "day" }
    },
    {
      "id": "gasTotal", "path": "/gas/average-total", "operation": "total",
      "description": "Routescan average gas price total on Avalanche C-Chain",
      "paymentOptions": [{ "scheme": "exact", "network": "stellar:testnet", "asset": "UNVERIFIED_DEMO_ASSET", "payTo": "UNVERIFIED_DEMO_RECIPIENT", "amount": "10000", "maxTimeoutSeconds": 60 }],
      "example": { "dateFrom": "2026-10-08T00:00:00Z", "dateTo": "2026-10-09T00:00:00Z" }
    }
  ]
}
