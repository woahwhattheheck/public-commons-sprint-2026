{
  "schema": "stellar-forge.opencage-plan.v1",
  "id": "location-workshare",
  "name": "Location workshare",
  "apiKeyEnv": "OPENCAGE_API_KEY",
  "minIntervalMs": 1000,
  "timeoutMs": 15000,
  "maxResponseBytes": 1048576,
  "products": [
    {
      "id": "forward",
      "name": "Address candidates",
      "path": "/geocode/forward",
      "mode": "forward",
      "options": [
        "bounds",
        "countrycode",
        "language",
        "limit",
        "no_annotations",
        "no_record",
        "proximity"
      ],
      "defaults": {
        "limit": "10",
        "no_record": "1"
      }
    },
    {
      "id": "reverse",
      "name": "Coordinate address",
      "path": "/geocode/reverse",
      "mode": "reverse",
      "options": [
        "language",
        "no_annotations",
        "no_record",
        "roadinfo"
      ],
      "defaults": {
        "no_record": "1"
      }
    }
  ]
}
