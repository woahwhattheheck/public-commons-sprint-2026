{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host-selected original SensorThings merchant runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "stellar-forge.sensorthings-analysis-merchant-runtime.v1"
    },
    "port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "maxInFlight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "drainGraceMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "operationsAccessFile": {
      "type": "string",
      "pattern": "^/"
    },
    "nativeFactoryModule": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256",
            "exportName"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2097152
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "exportName": {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,99}$"
            }
          }
        }
      ]
    }
  }
}
