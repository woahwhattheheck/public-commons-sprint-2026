<!ENTITY % OPENBASE SYSTEM "openbase_1_0.dtd">

%OPENBASE;

  <!ELEMENT DISPATCHNOTIFICATION (DISPATCHNOTIFICATION_HEADER , DISPATCHNOTIFICATION_ITEM_LIST , DISPATCHNOTIFICATION_SUMMARY)>
    <!ATTLIST DISPATCHNOTIFICATION  
                     version  CDATA  #FIXED "1.0"
                     xmlns    CDATA  #FIXED 'http://www.opentrans.org/opentrans/1.0/opentrans_dispatchnotification'>

  <!ELEMENT DISPATCHNOTIFICATION_HEADER (CONTROL_INFO? , DISPATCHNOTIFICATION_INFO)>

  <!ELEMENT DISPATCHNOTIFICATION_INFO (DISPATCHNOTIFICATION_ID , DISPATCHNOTIFICATION_DATE? , 
                                       BUYER_PARTY , SUPPLIER_PARTY , SHIPMENT_PARTIES , 
                                       MEANS_OF_TRANSPORT* , PACKAGE_INFO* , 
                                       INTERNATIONAL_RESTRICTIONS* , REMARK*)>

  <!ELEMENT DISPATCHNOTIFICATION_ITEM_LIST (DISPATCHNOTIFICATION_ITEM+)>

  <!ELEMENT DISPATCHNOTIFICATION_ITEM (LINE_ITEM_ID , ARTICLE_ID , QUANTITY , ORDER_UNIT , 
                                       DELIVERY_COMPLETED? , DELIVERY_DATE? , ORDER_REFERENCE ,
                                       SUPPLIER_ORDER_REFERENCE? , SUPPLIER_PARTY? , SHIPMENT_PARTIES? , 
                                       PACKAGE_INFO* , REMARK*)>

  <!ELEMENT DISPATCHNOTIFICATION_SUMMARY (TOTAL_ITEM_NUM)>

