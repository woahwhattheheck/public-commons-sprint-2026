  "semantics": {
    "raw_record": "JSON object of all original parsed source fields, preserving each field's text; source_row_sha256 binds the original physical CSV/TSV record including its original line ending.",
    "missing_strings": "Nonnullable string metadata uses empty string when unavailable; JSON collections are compact JSON strings.",
    "dates": "ISO YYYY-MM-DD strings; monthly employment metrics use their specific month, quarterly metrics the quarter; M13 is an annual average with separate coverage fields.",
    "laus_basis": "place_of_residence",
    "qcew_basis": "place_of_employment",
    "annual_coverage": "Resolve original observation and series footnote codes against captured la.footnote. Code G for 2025 is eleven months excluding October. Unavailable annual averages have null value and coverage; do not impute missing months.",
    "qcew_disclosure": "Use disclosure_code, lq_disclosure_code, or oty_disclosure_code for the corresponding metric group. N means withheld even when the raw token is zero; keep raw token. Preserve the original full row.",
    "numeric": "value is finite and within safe integer precision, otherwise null with a specific value_status; raw value is always retained.",
    "source_retention": "Source-file projection includes every manifest files member and the manifest itself; capture_id is SHA256 of exact manifest bytes."
  },
  "worker": {
    "command": [
      "python3",
      "project.py",
      "--source",
      "SOURCE_JSON",
      "--query",
      "laus|qcew|source_files"
    ],
    "row": {
      "kind": "row",
      "row": "object matching selected projection columns exactly"
    },
    "complete": {
      "kind": "complete",
      "result": {
        "schema": "stellar-forge.bls-labor-extraction.v1",
        "projection": "laus|qcew|source_files",
        "sourceHash": "SHA256 source JSON bytes",
        "captureHash": "SHA256 manifest bytes",
        "completeSelection": true,
        "sourceVerified": true,
        "rawValuesPreserved": true,
        "rowCount": "integer"
      }
    },
    "rules": "UTF-8 JSONL only on stdout, diagnostics on stderr, nonzero exit on failure. One final complete line after all rows; no output after it. Exit nonzero when pipe closes. No network while projecting."
  }
