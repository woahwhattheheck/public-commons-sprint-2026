{
  "name": "Complete period telemetry",
  "periodId": "REPLACE_WITH_SAVED_PERIOD_UUID",
  "periodVersion": 1,
  "cadenceSeconds": 900,
  "queries": [
    {
      "name": "Complete rate snapshot history",
      "connection": "mainnet-telemetry",
      "action": "snapshots.list",
      "args": {
        "limit": 500
      }
    },
    {
      "name": "Latest original route window",
      "connection": "mainnet-telemetry",
      "action": "routes.list",
      "args": {
        "limit": 500
      }
    }
  ]
}
