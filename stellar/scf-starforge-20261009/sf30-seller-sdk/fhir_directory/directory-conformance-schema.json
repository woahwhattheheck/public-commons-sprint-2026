{
  "schema": "stellar-forge.directory-conformance-catalogue.v1",
  "inputSchemas": {
    "conformance_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Name this complete reviewed record.",
          "maxLength": 240,
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "description": "Actual operator or reviewer.",
          "maxLength": 200,
          "minLength": 1
        },
        "subjectKind": {
          "type": "string",
          "enum": [
            "sources",
            "editions"
          ]
        },
        "subjectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "family": {
          "type": "string",
          "enum": [
            "hsds-3.3.1",
            "fhir-hsd-1.0.0"
          ]
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Exact original table or resource type.",
            "maxLength": 128
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "profileDisposition": {
          "type": "string",
          "enum": [
            "selected-standard",
            "migration-assessment"
          ],
          "description": "A migration assessment does not assert that the publisher selected this target standard."
        },
        "publisherProfile": {
          "type": "string",
          "description": "Publisher's actual declared profile URI or version; leave empty only if none was observed.",
          "maxLength": 2048
        },
        "scope": {
          "type": "string",
          "description": "Exact publication/selection coverage and intended receiving use.",
          "maxLength": 4000
        },
        "formatPolicy": {
          "type": "string",
          "enum": [
            "annotation",
            "assert"
          ],
          "description": "Whether canonical JSON Schema format declarations are checked or retained as annotations. Tabular field formats remain their declared logical type and format assertions."
        },
        "definitionRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "Exact retained Directory source."
              },
              "recordId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "Exact retained original resource record."
              }
            },
            "required": [
              "sourceId",
              "recordId"
            ]
          },
          "uniqueItems": true,
          "maxItems": 3,
          "description": "For HSD, select the original published 1.0.0 StructureDefinition records with full snapshots. HSDS leaves this empty."
        },
        "note": {
          "type": "string",
          "description": "Full interpretation and standards-selection note.",
          "maxLength": 8192
        }
      },
      "required": [
        "label",
        "actor",
        "subjectKind",
        "subjectId",
        "family",
        "profileDisposition",
        "scope"
      ]
    },
    "conformance_assess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Name this complete reviewed record.",
          "maxLength": 240,
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "description": "Actual operator or reviewer.",
          "maxLength": 200,
          "minLength": 1
        },
        "planId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "note": {
          "type": "string",
          "description": "Purpose of the complete original assessment.",
          "maxLength": 8192
        }
      },
      "required": [
        "label",
        "actor",
        "planId"
      ]
    },
    "conformance_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Name this complete reviewed record.",
          "maxLength": 240,
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "description": "Actual operator or reviewer.",
          "maxLength": 200,
          "minLength": 1
        },
        "assessmentId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "accept-for-receiving",
            "needs-correction",
            "defer"
          ]
        },
        "declaration": {
          "type": "string",
          "description": "Reviewer's interpretation of coverage, limitations and selected receiving use.",
          "maxLength": 12000
        },
        "decisions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "findingId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "accepted-deviation",
                  "requires-correction",
                  "not-applicable"
                ]
              },
              "reason": {
                "type": "string",
                "description": "Source-bound reason; findings and originals remain unchanged.",
                "maxLength": 4000
              }
            },
            "required": [
              "findingId",
              "disposition",
              "reason"
            ]
          }
        },
        "predecessorId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "note": {
          "type": "string",
          "description": "Additional review note.",
          "maxLength": 8192
        },
        "groups": {
          "type": "array",
          "maxItems": 1000,
          "description": "Explicit groups over this immutable assessment. Each group's full matched finding IDs are retained. Per-finding decisions take precedence; overlapping groups are rejected.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "not-evaluated"
                ]
              },
              "table": {
                "type": "string",
                "maxLength": 128
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "accepted-deviation",
                  "requires-correction",
                  "not-applicable"
                ]
              },
              "reason": {
                "type": "string",
                "description": "Source-bound reason; findings and originals remain unchanged.",
                "maxLength": 4000
              }
            },
            "required": [
              "code",
              "disposition",
              "reason"
            ]
          }
        }
      },
      "required": [
        "label",
        "actor",
        "assessmentId",
        "disposition",
        "declaration"
      ]
    },
    "conformance_compare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Name this complete reviewed record.",
          "maxLength": 240,
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "description": "Actual operator or reviewer.",
          "maxLength": 200,
          "minLength": 1
        },
        "beforeAssessmentId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "afterAssessmentId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scopeNote": {
          "type": "string",
          "description": "Explain the two selected assessment populations; this compares rule outcomes without inferring entity equivalence.",
          "maxLength": 8192
        },
        "note": {
          "type": "string",
          "description": "Additional note.",
          "maxLength": 8192
        }
      },
      "required": [
        "label",
        "actor",
        "beforeAssessmentId",
        "afterAssessmentId",
        "scopeNote"
      ]
    }
  },
  "recordKinds": [
    "conformancePlans",
    "conformanceAssessments",
    "conformanceReviews",
    "conformanceComparisons"
  ],
  "actions": [
    {
      "id": "conformance-plan",
      "input": "conformance_plan",
      "method": "POST",
      "path": "/api/directory/conformance/plans",
      "python": "save_directory_conformance_plan"
    },
    {
      "id": "conformance-assess",
      "input": "conformance_assess",
      "method": "POST",
      "path": "/api/directory/conformance/assessments",
      "python": "assess_directory_conformance"
    },
    {
      "id": "conformance-review",
      "input": "conformance_review",
      "method": "POST",
      "path": "/api/directory/conformance/reviews",
      "python": "review_directory_conformance"
    },
    {
      "id": "conformance-compare",
      "input": "conformance_compare",
      "method": "POST",
      "path": "/api/directory/conformance/comparisons",
      "python": "compare_directory_conformance"
    }
  ],
  "fileKinds": [
    "report",
    "findings",
    "rows",
    "index",
    "rules",
    "summary",
    "package",
    "foreignKeys",
    "foreignKeyCandidates",
    "foreignKeyMatches",
    "foreignKeyCoverage"
  ],
  "families": [
    {
      "id": "hsds-3.3.1",
      "label": "HSDS 3.3.1 canonical JSON and compiled tabular data declarations",
      "sourceId": "hsds-3.3.1"
    },
    {
      "id": "fhir-hsd-1.0.0",
      "label": "Selected published FHIR HSD 1.0.0 profile snapshot assertions",
      "sourceId": "fhir-hsd-1.0.0-authoring"
    }
  ],
  "limits": {
    "findings": 1000000,
    "rows": 250000,
    "fileBytes": 1073741824,
    "interactiveBytes": 4194304,
    "foreignKeyCandidates": 1000000,
    "foreignKeyOutcomes": 2000000,
    "foreignKeyMatches": 2000000,
    "foreignKeyTupleBytes": 1048576
  },
  "semantics": [
    "Original source and edition IDs, logical JSON number tokens and member bytes are unchanged.",
    "HSDS JSON assertions follow the exact retained canonical schemas; unknown properties are allowed unless a selected source schema says otherwise.",
    "Tabular cells are interpreted only for checking their original compiled data-package declarations; interpreted values never replace original cells.",
    "FHIR assessment records cardinality, selected primitive/fixed/pattern and reference observations from the exact retained snapshots. Unsupported slices, invariants, external bases and terminology are reported as unevaluated requirements.",
    "Must Support and narrative semantic obligations remain review requirements, not invented missing-field cardinalities.",
    "Canonical JSON Schema format annotation and additional format assertions are separate operator selections. Tabular field formats remain their original declared logical type and format assertions.",
    "No result is a blanket certification. A reviewed receiving disposition retains all findings and coverage limitations.",
    "Comparison reports complete rule-outcome counts and row populations, without silently matching entities from different sources.",
    "Whole editable export includes every assessment index, finding, rule, report and original subject.",
    "Accept-for-receiving requires an explicit accepted-deviation or not-applicable disposition for every error; grouped decisions freeze every matched original finding ID. Findings are never removed.",
    "Each exact original HSDS tabular foreignKeys declaration is evaluated separately, including repeated declarations. String and equal-cardinality array field tuples are supported; the retained 3.3.1 edition declares 38 single-field foreign keys and no composites.",
    "Original CSV and top-level rows in an explicitly selected HSDS tables JSON document are checked. Nested/entity/page JSON has explicit tabular noncoverage; native parent links never supply invented foreign-key cells.",
    "Original missingValues and existing field casting determine logical keys. Physical absence, JSON null and exact missing markers remain distinct. This implementation explicitly selects SQL MATCH SIMPLE for otherwise interpretable nullable tuples; field required/primary-key checks stay separate.",
    "All original target candidates and every matching edge are retained. Existence can pass with ambiguous identity; no candidate is silently selected. A target table outside established selected coverage is unevaluated, distinct from a missing key within a received table.",
    "The foreign-key implementation has a new exact engine edition and four complete additional files. Earlier seven-file assessment records and their original plans remain readable and immutable."
  ],
  "implementationEdition": "stellar-forge.directory-conformance.hsds-foreign-keys.20261013",
  "reads": [
    {
      "method": "GET",
      "path": "/api/directory/conformance/assessments/:id/foreign-keys",
      "python": "directory_conformance_foreign_keys",
      "filters": [
        "offset",
        "limit",
        "table",
        "state",
        "ruleId",
        "sourceId",
        "recordId"
      ],
      "querySchema": "conformance_foreign_keys",
      "response": "conformance_relationship_page"
    },
    {
      "method": "GET",
      "path": "/api/directory/conformance/assessments/:id/foreign-key-candidates",
      "python": "directory_conformance_foreign_key_candidates",
      "filters": [
        "offset",
        "limit",
        "table",
        "state",
        "groupId",
        "sourceId",
        "recordId"
      ],
      "querySchema": "conformance_foreign_key_candidates",
      "response": "conformance_relationship_page"
    },
    {
      "method": "GET",
      "path": "/api/directory/conformance/assessments/:id/foreign-key-matches",
      "python": "directory_conformance_foreign_key_matches",
      "filters": [
        "offset",
        "limit",
        "outcomeId",
        "candidateId"
      ],
      "querySchema": "conformance_foreign_key_matches",
      "response": "conformance_relationship_page"
    }
  ],
  "querySchemas": {
    "conformance_foreign_keys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000,
          "default": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250,
          "default": 50
        },
        "table": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ruleId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recordId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "conformance_foreign_key_candidates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000,
          "default": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250,
          "default": 50
        },
        "table": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "groupId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recordId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "conformance_foreign_key_matches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000,
          "default": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250,
          "default": 50
        },
        "outcomeId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidateId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "pageResponses": {
    "conformance_relationship_page": {
      "description": "The complete filtered rows in original SQLite ordinal order, bounded by the requested count and 4 MiB total body bytes. Follow each exact nextOffset; no target list is truncated into a count-only result.",
      "fields": {
        "assessmentId": "original immutable assessment ID",
        "rows": "complete original relationship record bodies",
        "total": "full filtered count",
        "offset": "requested offset",
        "limit": "requested count",
        "nextOffset": "next contiguous offset, or null at completion",
        "bytes": "sum of original stored JSON body bytes returned",
        "byteBudget": 4194304
      }
    }
  },
  "fileDescriptions": {
    "foreignKeys": "Complete JSON Lines: one outcome for every selected original row and exact original foreign-key declaration, with full declaration/source pointer, original row reference, interpretation components, constraint/resolution status and matching-target count.",
    "foreignKeyCandidates": "Complete JSON Lines: every original target row for each selected declaration target group, including null, invalid and non-tabular rows. Interpreted values do not replace original cells or JSON.",
    "foreignKeyMatches": "Complete JSON Lines: every exact matching source-outcome/target-candidate edge. Multiple matches remain separate original references; no winning target is inferred.",
    "foreignKeyCoverage": "Complete JSON: all 38 original declarations, source pointers, selected and unselected coverage, target groups, original table presence, null/type policy, operation counts and explicit implementation limits."
  }
}
