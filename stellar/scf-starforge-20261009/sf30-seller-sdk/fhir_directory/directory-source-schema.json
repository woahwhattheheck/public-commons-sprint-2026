  "limits": {
    "sourceBytes": 268435456,
    "expandedBytes": 268435456,
    "indexBytes": 268435456,
    "recordBytes": 16777216,
    "sourceRecords": 100000,
    "editionRecords": 250000,
    "referenceEdges": 500000,
    "sourceMembers": 4096,
    "selectedMembers": 1024,
    "sourcePages": 512,
    "editionSources": 64,
    "interactiveBytes": 4194304,
    "pageRows": 250,
    "operationMetadataBytes": 16777216
  },
  "formats": [
    "hsds-json",
    "hsds-csv",
    "hsds-csv-zip",
    "fhir-json",
    "fhir-json-zip",
    "directory-capture"
  ],
  "protocols": [
    "hsds",
    "fhir-hsd"
  ],
  "sourceOrigins": [
    "published_reference",
    "operator_source",
    "authored_example"
  ],
