            "type": "object",
            "properties": {
              "before": {
                "type": "object",
                "properties": {
                  "sourceId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "recordId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
