    "snapshot",
    "subset",
    "incremental",
    "unknown"
  ],
  "comparisonStates": [
    "unchanged",
    "changed",
    "only-before",
    "only-after",
    "ambiguous",
    "unidentified"
  ],
  "operationStates": [
    "ready",
    "receiving",
    "waiting",
    "paused",
    "needs-review",
    "complete"
  ],
  "recordRef": {
    "type": "object",
    "properties": {
      "sourceId": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "recordId": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "required": [
      "sourceId",
      "recordId"
    ],
    "additionalProperties": false
  },
  "actions": [
    {
      "id": "connection",
      "method": "directory_connection",
      "input": "connection",
      "description": "Save an immutable selected endpoint using existing local authentication"
    },
    {
      "id": "discover",
      "method": "directory_discover",
      "input": "discover",
      "description": "Retain the actual HSDS root or FHIR CapabilityStatement response"
    },
    {
      "id": "import",
      "method": "directory_import",
      "input": "import",
      "description": "Retain original file/member bytes and a complete immutable source index"
    },
    {
      "id": "request",
      "method": "directory_request",
      "input": "request",
      "description": "Freeze exact selected GETs and explicit pagination"
    },
    {
      "id": "acquire",
      "method": "directory_acquire",
      "input": "acquire",
      "description": "Reserve original request and operation identity without network access"
    },
    {
      "id": "advance",
      "method": "directory_advance",
      "input": "operation",
      "description": "Receive at most one retained original GET and continue the same request"
    },
    {
      "id": "pause",
      "method": "directory_pause",
      "input": "operation",
      "description": "Pause local continuation without a provider mutation"
    },
    {
      "id": "resume",
      "method": "directory_resume",
      "input": "operation",
      "description": "Continue the same original request and any retained complete response"
    },
    {
      "id": "edition",
      "method": "directory_edition",
      "input": "edition",
      "description": "Freeze selected complete source indices and resolve exact directory references"
    },
    {
      "id": "compare",
      "method": "directory_compare",
      "input": "comparison",
      "description": "Compare exact native identities and explicitly reviewed record links"
    },
    {
      "id": "capture_source",
      "method": "directory_capture_source",
      "input": "operation",
      "description": "Freeze currently received complete pages explicitly, retaining incomplete capture state"
    }
  ],
  "semantics": {
    "versions": "HSDS 3.3.1 sources retain the original datapackage version 3.0.0. FHIR HSD STU1 authoring maps HSDS 2.0.1; migration remains an explicit reviewed mapping.",
    "completeness": "A finished local file or page is not a claim that a remote directory is complete. HSDS termination is explicitly selected; FHIR follows exact returned next links.",
    "conformance": "Retained observations check source structure and supported identity/reference constraints; they do not claim complete JSON Schema, FHIR profile or terminology conformance.",
    "comparison": "only-before and only-after describe the two selected editions, not remote deletions or creations. Duplicate and missing native IDs remain visible.",
    "clocks": "Original last_modified/meta.lastUpdated values remain distinct from capturedAt and operator-authored scope.",
    "numbers": "Original JSON is retained byte-for-byte. data and display projections represent numeric lexical tokens as strings; json and numericTokens preserve their exact JSON type/value.",
    "extensions": "Unknown original fields are retained. They are not discarded or rejected merely because the selected source schema does not name them."
  }
}
