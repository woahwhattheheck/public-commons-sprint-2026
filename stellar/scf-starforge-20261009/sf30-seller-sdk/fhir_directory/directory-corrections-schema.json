{
  "schema": "stellar-forge.directory-corrections-catalogue.v1",
  "description": "Authored HSDS corrections over exact retained rows; original source bytes and each frozen edition remain available.",
  "collections": [
    "correctionPlans",
    "correctionPreviews",
    "corrections"
  ],
  "limits": {
    "maxEdits": 10000,
    "maxInputBytes": 33554432,
    "maxValueBytes": 16777216,
    "maxSourceBytes": 268435456
  },
  "inputSchemas": {
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "editionId",
        "actor",
        "edits"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1
        },
        "editionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "actor": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1
        },
        "note": {
          "type": "string",
          "maxLength": 65536
        },
        "predecessorId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "edits": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "recordId",
              "rowSha256",
              "resourceSha256",
              "memberSha256",
              "action",
              "reason"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "recordId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "rowSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "resourceSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "memberSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "action": {
                "type": "string",
                "enum": [
                  "json-set",
                  "json-remove",
                  "csv-cell",
                  "csv-row"
                ]
              },
              "pointer": {
                "type": "string",
                "maxLength": 16384
              },
              "valueJson": {
                "type": "string",
                "maxLength": 16777216
              },
              "column": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "value": {
                "type": "string",
                "maxLength": 16777216
              },
              "cells": {
                "type": "array",
                "maxItems": 65536,
                "items": {
                  "type": "string",
                  "maxLength": 16777216
                }
              },
              "reason": {
                "type": "string",
                "maxLength": 65536,
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId"
      ],
      "properties": {
        "planId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "apply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previewId",
        "expectedEditionId",
        "actor"
      ],
      "properties": {
        "previewId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expectedEditionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "actor": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1
        },
        "note": {
          "type": "string",
          "maxLength": 65536
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctionId",
        "actor"
      ],
      "properties": {
        "correctionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "actor": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "note": {
          "type": "string",
          "maxLength": 65536
        }
      }
    }
  }
}
