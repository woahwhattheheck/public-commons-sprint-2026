{
  "schema": "stellar-forge.directory-worksheet-reconciliation-catalogue.v1",
  "version": 1,
  "collections": [
    "correctionWorksheetReconciliations",
    "correctionWorksheetReconciliationReviews"
  ],
  "limits": {
    "inputBytes": 33554432,
    "valueBytes": 16777216,
    "fileBytes": 268435456,
    "rows": 10000,
    "changes": 10000,
    "pageRows": 250,
    "pageBytes": 4194304
  },
  "states": [
    "proposable",
    "already-applied",
    "conflict",
    "unbound",
    "structure-conflict"
  ],
  "decisions": [
    "accept-proposed",
    "keep-current",
    "resolve-row"
  ],
  "inputSchemas": {
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "actor",
        "returnId",
        "currentEditionId",
        "bindings"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "returnId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "currentEditionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "predecessorId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rowKey",
              "original",
              "current",
              "reason"
            ],
            "properties": {
              "rowKey": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "original": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sourceId",
                  "recordId",
                  "rowSha256",
                  "resourceSha256",
                  "memberSha256"
                ],
                "properties": {
                  "sourceId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "recordId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "rowSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "resourceSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "memberSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "current": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sourceId",
                      "recordId",
                      "rowSha256",
                      "resourceSha256",
                      "memberSha256"
                    ],
                    "properties": {
                      "sourceId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "recordId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "rowSha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "resourceSha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "memberSha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            }
          }
        },
        "note": {
          "type": "string",
          "maxLength": 16384
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "actor",
        "reconciliationId",
        "choices"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "reconciliationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "choices": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "changeId",
              "decision",
              "reason"
            ],
            "properties": {
              "changeId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "accept-proposed",
                  "keep-current",
                  "resolve-row"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            }
          }
        },
        "rowResolutions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rowKey",
                  "reason",
                  "representation",
                  "valueJson"
                ],
                "properties": {
                  "rowKey": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  },
                  "representation": {
                    "const": "json",
                    "type": "string"
                  },
                  "valueJson": {
                    "type": "string",
                    "maxLength": 16777216
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rowKey",
                  "reason",
                  "representation",
                  "cells"
                ],
                "properties": {
                  "rowKey": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  },
                  "representation": {
                    "const": "csv",
                    "type": "string"
                  },
                  "cells": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100000,
                    "items": {
                      "type": "string",
                      "maxLength": 16777216
                    }
                  }
                }
              }
            ]
          }
        },
        "note": {
          "type": "string",
          "maxLength": 16384
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reconciliationId",
        "actor"
      ],
      "properties": {
        "reconciliationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "note": {
          "type": "string",
          "maxLength": 16384
        }
      }
    }
  },
  "fileKinds": {
    "correctionWorksheetReconciliations": [
      "input",
      "rows",
      "comparison"
    ],
    "correctionWorksheetReconciliationReviews": [
      "input",
      "decisions"
    ]
  },
  "methods": {
    "catalogue": "directory_correction_worksheet_reconciliation_catalogue",
    "prepare": "prepare_directory_correction_worksheet_reconciliation",
    "review": "review_directory_correction_worksheet_reconciliation",
    "export": "export_directory_correction_worksheet_reconciliation",
    "rows": "directory_correction_worksheet_reconciliation_rows",
    "file": "directory_correction_worksheet_reconciliation_file"
  },
  "semantics": {
    "binding": "Every original worksheet row needs one explicit exact five-field original/current reference and a human reason. Null current is retained as unresolved, never auto-matched.",
    "comparison": "Every original returned change compares base/proposed/current presence, type and lexical JSON. Object-parent changes and physical CSV layout changes require explicit complete-row resolution.",
    "review": "Every comparison requires one explicit choice. Whole-row resolution requires every change of that row to resolve-row. It preserves full candidate/current custody and creates one ordinary current-edition edit.",
    "execution": "Preparing or reviewing never accepts a correction. Preview and acceptance remain original separate operations.",
    "replay": "Complete normalized inputs and retained files produce the same immutable records; a saved correction plan is reused after interrupted review receiving."
  }
}
