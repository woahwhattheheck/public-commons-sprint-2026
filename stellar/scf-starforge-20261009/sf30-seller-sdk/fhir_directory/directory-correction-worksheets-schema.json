{
  "schema": "stellar-forge.directory-correction-worksheets-catalogue.v1",
  "inputSchemas": {
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "editionId",
        "actor",
        "rows"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 65536
        },
        "editionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "predecessorId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "recordId",
              "rowSha256",
              "resourceSha256",
              "memberSha256"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "recordId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "rowSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "resourceSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "memberSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worksheetId",
        "actor"
      ],
      "properties": {
        "worksheetId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 65536
        }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worksheetId",
        "actor",
        "filename"
      ],
      "properties": {
        "worksheetId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "expectedSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expectedBytes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 33554432
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 65536
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "returnId",
        "label",
        "actor",
        "choices"
      ],
      "properties": {
        "returnId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 65536
        },
        "choices": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "changeId",
              "decision",
              "reason"
            ],
            "properties": {
              "changeId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "decision": {
                "enum": [
                  "accept",
                  "keep-original"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            }
          }
        }
      }
    }
  },
  "returnDocumentSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "workspaceId",
      "worksheetId",
      "editionId",
      "returnedBy",
      "returnedAt",
      "candidates"
    ],
    "properties": {
      "schema": {
        "const": "stellar-forge.directory-correction-worksheet-return.v1"
      },
      "workspaceId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      },
      "worksheetId": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "editionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "returnedBy": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "returnedAt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      },
      "note": {
        "type": "string",
        "minLength": 0,
        "maxLength": 65536
      },
      "candidates": {
        "type": "array",
        "minItems": 0,
        "maxItems": 10000,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rowKey",
                "representation",
                "valueJson",
                "reason"
              ],
              "properties": {
                "rowKey": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                },
                "representation": {
                  "const": "json"
                },
                "valueJson": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16777216
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rowKey",
                "representation",
                "cells",
                "reason"
              ],
              "properties": {
                "rowKey": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                },
                "representation": {
                  "const": "csv"
                },
                "cells": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 65536,
                  "items": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 16777216
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "limits": {
    "inputBytes": 33554432,
    "returnedFileBytes": 33554432,
    "worksheetDocumentBytes": 67108864,
    "rows": 10000,
    "changes": 10000,
    "pageRows": 250,
    "pageBytes": 4194304,
    "selectedValueBytes": 16777216
  },
  "collections": [
    "correctionWorksheets",
    "correctionWorksheetImports",
    "correctionWorksheetReturns",
    "correctionWorksheetReviews"
  ],
  "methods": {
    "prepare": "prepare_directory_correction_worksheet",
    "export": "export_directory_correction_worksheet",
    "import": "save_directory_correction_worksheet_import",
    "receive": "import_directory_correction_worksheet_return",
    "review": "review_directory_correction_worksheet_return",
    "rows": "directory_correction_worksheet_rows",
    "file": "directory_correction_worksheet_file",
    "document": "directory_correction_worksheet_document",
    "verify": "_verify_directory_correction_worksheets"
  },
  "routes": {
    "prepare": "POST /api/directory/correction-worksheets/prepare",
    "export": "POST /api/directory/correction-worksheets/export",
    "import": "POST /api/directory/correction-worksheets/imports",
    "receive": "PUT /api/directory/correction-worksheets/imports/:id/content",
    "review": "POST /api/directory/correction-worksheets/review",
    "rows": "GET /api/directory/:kind/:id/rows?offset&limit&rowKey&state",
    "file": "GET /api/directory/:kind/:id/files/:fileKind",
    "document": "GET /api/directory/correctionWorksheets/:id/document"
  },
  "semantics": {
    "predecessorId": "Optional accepted correction ID whose editionId equals the selected base, matching existing corrections.",
    "review": "Every native change ID gets exactly one explicit choice. No accepted edits yields outcome no-edits-selected and planId null. Otherwise retains the existing native correction plan, without previewing or applying.",
    "source": "Whole JSON objects remain lexical strings. Arrays and added/removed objects compare atomically. Original row omission means no proposal. CSV count changes are one atomic csv-row; equal length permits physical cell comparisons."
  },
  "description": "Complete original HSDS worksheets, offline customer proposals, typed field comparison and explicit correction-plan selection."
}
