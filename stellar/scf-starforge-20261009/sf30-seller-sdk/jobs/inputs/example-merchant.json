{
  "schema": "stellar-forge.paid-jobs.v1",
  "application": "./example-application.mjs",
  "publicOrigin": "https://jobs-merchant.example",
  "serviceName": "Supplier Invoice Reconciliation",
  "environment": [],
  "workerCount": 1,
  "maxPending": 128,
  "maxJobs": 10000,
  "memoryLimitMb": 256,
  "inputFileStorage": {
    "maxBytes": 536870912,
    "maxUploads": 4096
  },
  "functions": {
    "reconcile": {
      "path": "/invoice-reconciliation",
      "description": "Reconcile original invoice line files against an original supplier price book, with exact integer amounts and streamed ledger receiving.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reportName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxExceptions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          }
        },
        "required": [
          "reportName"
        ],
        "additionalProperties": false
      },
      "example": {
        "reportName": "October supplier invoices",
        "maxExceptions": 200
      },
      "inputFiles": {
        "slots": {
          "ledger": {
            "required": true,
            "description": "UTF-8 NDJSON invoice lines with integer minor-unit charged amounts.",
            "mediaTypes": [
              "application/x-ndjson"
            ],
            "maxBytes": 134217728
          },
          "prices": {
            "required": true,
            "description": "Original supplier-pricebook.v1 JSON with currency-specific unit prices.",
            "mediaTypes": [
              "application/json"
            ],
            "maxBytes": 4194304
          }
        },
        "maxTotalBytes": 138412032
      },
      "payment": {
        "scheme": "exact",
        "network": "stellar:testnet",
        "asset": "UNVERIFIED_DEMO_ASSET",
        "payTo": "UNVERIFIED_DEMO_RECIPIENT",
        "amount": "10000",
        "maxTimeoutSeconds": 60
      },
      "timeoutMs": 300000,
      "maxInputBytes": 262144,
      "maxOutputBytes": 4194304,
      "output": {
        "format": "json",
        "contentType": "application/json; charset=utf-8",
        "filename": "invoice-reconciliation.json"
      }
    }
  },
  "intake": {
    "enabled": true,
    "functions": [
      "reconcile"
    ]
  }
}
