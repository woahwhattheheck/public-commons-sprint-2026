{
  "schema": "stellar-forge.redis-commissioning-input.v1",
  "operationId": "customer-valkey-commissioning",
  "requestId": "customer-valkey-create",
  "setup": {
    "label": "Customer Valkey data products",
    "source": {
      "schema": "stellar-forge.redis-source.v1",
      "connection": {
        "topology": "standalone",
        "host": "valkey.customer.example",
        "port": 6379,
        "database": 0,
        "tls": "verify-full",
        "passwordEnv": "VALKEY_PASSWORD",
        "username": "CUSTOMER_READ_USER"
      },
      "maxConnections": 4,
      "maxPending": 16,
      "connectTimeoutMs": 3000,
      "idleTimeoutMs": 30000,
      "startupTimeoutMs": 5000,
      "queries": {
        "availability": {
          "kind": "get",
          "key": "merchant:availability:catalog",
          "parameters": {},
          "columns": [
            "availability"
          ],
          "maxRows": 1,
          "maxBytes": 16384,
          "timeoutMs": 1000
        },
        "catalog": {
          "kind": "hash",
          "key": {
            "prefix": "merchant:catalog:",
            "parameter": "region"
          },
          "parameters": {
            "region": {
              "type": "string",
              "enum": [
                "north",
                "south"
              ],
              "default": "north",
              "maxLength": 16
            }
          },
          "fields": {
            "itemId": "product_id",
            "title": "name",
            "priceAtomic": "price_atomic"
          },
          "maxRows": 1,
          "maxBytes": 32768,
          "timeoutMs": 1000
        },
        "leaderboard": {
          "kind": "sorted-set",
          "key": "merchant:rankings:daily",
          "parameters": {
            "offset": {
              "type": "integer",
              "minimum": "0",
              "maximum": "10000000",
              "default": "0"
            }
          },
          "offset": "offset",
          "columns": [
            "itemId",
            "score"
          ],
          "maxRows": 20,
          "maxBytes": 65536,
          "timeoutMs": 1500
        },
        "events": {
          "kind": "stream",
          "key": "merchant:events",
          "parameters": {
            "after": {
              "type": "string",
              "maxLength": 41,
              "default": "-"
            }
          },
          "after": "after",
          "fields": {
            "eventType": "event_type",
            "itemId": "product_id",
            "quantity": "quantity"
          },
          "maxRows": 20,
          "maxBytes": 65536,
          "timeoutMs": 1500
        },
        "list_feed": {
          "kind": "list",
          "key": "merchant:collections:queue",
          "parameters": {
            "offset": {
              "type": "integer",
              "minimum": "0",
              "maximum": "10000000",
              "default": "0"
            }
          },
          "offset": "offset",
          "columns": [
            "index",
            "value"
          ],
          "maxRows": 100,
          "maxBytes": 65536,
          "timeoutMs": 1500
        },
        "member_catalog": {
          "kind": "set",
          "key": "merchant:collections:members",
          "parameters": {
            "cursor": {
              "type": "string",
              "maxLength": 20,
              "default": "0"
            }
          },
          "cursor": "cursor",
          "scanCount": 100,
          "columns": [
            "member"
          ],
          "maxRows": 1000,
          "maxBytes": 65536,
          "timeoutMs": 1500
        }
      }
    },
    "plan": {
      "schema": "stellar-forge.redis-merchant-plan.v1",
      "publicOrigin": "https://data.customer.example",
      "payment": {
        "scheme": "exact",
        "network": "stellar:testnet",
        "asset": "UNVERIFIED_DEMO_ASSET",
        "payTo": "UNVERIFIED_DEMO_RECIPIENT",
        "amount": "10000",
        "maxTimeoutSeconds": 60
      },
      "routes": [
        {
          "id": "availability",
          "path": "/availability",
          "method": "GET",
          "query": "availability",
          "serviceName": "Catalog availability",
          "description": "Current catalog availability from the merchant's selected Redis record.",
          "tags": [
            "redis",
            "catalog"
          ],
          "example": {},
          "parameterDescriptions": {}
        },
        {
          "id": "catalog",
          "path": "/catalog",
          "method": "GET",
          "query": "catalog",
          "serviceName": "Regional catalog",
          "description": "Selected product fields and exact atomic price for a reviewed catalog region.",
          "tags": [
            "redis",
            "catalog"
          ],
          "example": {
            "region": "north"
          },
          "parameterDescriptions": {
            "region": "Reviewed catalog region; defaults to north."
          }
        },
        {
          "id": "leaderboard",
          "path": "/rankings",
          "method": "GET",
          "query": "leaderboard",
          "serviceName": "Daily product ranking",
          "description": "A page of the merchant's selected sorted-set members and their Redis score strings.",
          "tags": [
            "redis",
            "ranking"
          ],
          "example": {
            "offset": "0"
          },
          "parameterDescriptions": {
            "offset": "Zero-based sorted-set rank; use the returned nextInput for the following page."
          }
        },
        {
          "id": "events",
          "path": "/events",
          "method": "GET",
          "query": "events",
          "serviceName": "Catalog event feed",
          "description": "Projected catalog events after the selected Redis stream ID.",
          "tags": [
            "redis",
            "events"
          ],
          "example": {
            "after": "-"
          },
          "parameterDescriptions": {
            "after": "Exclusive Redis stream ID; use - for the first page and returned nextInput to continue."
          }
        },
        {
          "id": "list_feed",
          "path": "/list",
          "method": "GET",
          "query": "list_feed",
          "serviceName": "Ordered list feed",
          "description": "One current page of the declared Redis list with exact zero-based indexes and original values. Use nextInput to continue; live changes can move list indexes.",
          "tags": [
            "redis",
            "list"
          ],
          "example": {
            "offset": "0"
          },
          "parameterDescriptions": {
            "offset": "Zero-based list index within the declared bounds. Continue using the previous result's nextInput."
          }
        },
        {
          "id": "member_catalog",
          "path": "/members",
          "method": "GET",
          "query": "member_catalog",
          "serviceName": "Set member catalog",
          "description": "One complete native SSCAN batch from the declared set. A priced page may be empty while iteration continues. Member ordering is unspecified and repeated members are possible across pages.",
          "tags": [
            "redis",
            "set"
          ],
          "example": {
            "cursor": "0"
          },
          "parameterDescriptions": {
            "cursor": "Exact native unsigned 64-bit cursor as decimal text. Start at 0, keep all returned rows, then use nextInput until scanComplete is true."
          }
        }
      ]
    },
    "certificates": {}
  },
  "checks": [
    {
      "id": "availability",
      "query": "availability",
      "input": {},
      "allPages": false,
      "maxPages": 100,
      "maxRows": 10000,
      "expected": {
        "rowCount": 1
      }
    },
    {
      "id": "catalog",
      "query": "catalog",
      "input": {
        "region": "north"
      },
      "allPages": false,
      "maxPages": 100,
      "maxRows": 10000,
      "expected": {
        "rowCount": 1
      }
    },
    {
      "id": "leaderboard",
      "query": "leaderboard",
      "input": {
        "offset": "0"
      },
      "allPages": false,
      "maxPages": 100,
      "maxRows": 10000,
      "expected": {
        "rowCount": 1
      }
    },
    {
      "id": "events",
      "query": "events",
      "input": {
        "after": "-"
      },
      "allPages": false,
      "maxPages": 100,
      "maxRows": 10000,
      "expected": {
        "rowCount": 1
      }
    },
    {
      "id": "list_feed",
      "query": "list_feed",
      "input": {
        "offset": "0"
      },
      "allPages": false,
      "maxPages": 100,
      "maxRows": 10000,
      "expected": {
        "rowCount": 1
      }
    },
    {
      "id": "member_catalog",
      "query": "member_catalog",
      "input": {
        "cursor": "0"
      },
      "allPages": false,
      "maxPages": 100,
      "maxRows": 10000,
      "expected": {
        "rowCount": 1
      }
    }
  ]
}
