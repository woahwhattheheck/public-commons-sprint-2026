{
  "schema": "stellar-forge.redis-ssh-deployment.v1",
  "id": "customer-redis-sentinel-ssh",
  "connection": {
    "topology": "sentinel",
    "database": 0,
    "username": "merchant",
    "passwordEnv": "REDIS_READ_PASSWORD",
    "name": "CUSTOMER_PRIMARY",
    "sentinelUsername": "merchant-monitor",
    "sentinelPasswordEnv": "REDIS_MONITOR_PASSWORD"
  },
  "nodes": [
    {
      "id": "data-a",
      "role": "data",
      "aliases": [
        {
          "host": "data-a.database.example",
          "port": 6379
        }
      ],
      "localPort": 16379,
      "remoteHost": "127.0.0.1",
      "remotePort": 6379,
      "ssh": {
        "host": "data-a.ssh.example",
        "port": 22,
        "user": "PROVIDER_SSH_USER",
        "identityFileEnv": "REDIS_SSH_IDENTITY_FILE",
        "knownHostsFileEnv": "REDIS_SSH_KNOWN_HOSTS_FILE"
      }
    },
    {
      "id": "data-b",
      "role": "data",
      "aliases": [
        {
          "host": "data-b.database.example",
          "port": 6379
        }
      ],
      "localPort": 16380,
      "remoteHost": "127.0.0.1",
      "remotePort": 6379,
      "ssh": {
        "host": "data-b.ssh.example",
        "port": 22,
        "user": "PROVIDER_SSH_USER",
        "identityFileEnv": "REDIS_SSH_IDENTITY_FILE",
        "knownHostsFileEnv": "REDIS_SSH_KNOWN_HOSTS_FILE"
      }
    },
    {
      "id": "monitor-a",
      "role": "sentinel",
      "aliases": [
        {
          "host": "monitor-a.database.example",
          "port": 26379
        }
      ],
      "localPort": 26380,
      "remoteHost": "127.0.0.1",
      "remotePort": 26379,
      "ssh": {
        "host": "monitor-a.ssh.example",
        "port": 22,
        "user": "PROVIDER_SSH_USER",
        "identityFileEnv": "REDIS_SSH_IDENTITY_FILE",
        "knownHostsFileEnv": "REDIS_SSH_KNOWN_HOSTS_FILE"
      }
    },
    {
      "id": "monitor-b",
      "role": "sentinel",
      "aliases": [
        {
          "host": "monitor-b.database.example",
          "port": 26379
        }
      ],
      "localPort": 26381,
      "remoteHost": "127.0.0.1",
      "remotePort": 26379,
      "ssh": {
        "host": "monitor-b.ssh.example",
        "port": 22,
        "user": "PROVIDER_SSH_USER",
        "identityFileEnv": "REDIS_SSH_IDENTITY_FILE",
        "knownHostsFileEnv": "REDIS_SSH_KNOWN_HOSTS_FILE"
      }
    },
    {
      "id": "monitor-c",
      "role": "sentinel",
      "aliases": [
        {
          "host": "monitor-c.database.example",
          "port": 26379
        }
      ],
      "localPort": 26382,
      "remoteHost": "127.0.0.1",
      "remotePort": 26379,
      "ssh": {
        "host": "monitor-c.ssh.example",
        "port": 22,
        "user": "PROVIDER_SSH_USER",
        "identityFileEnv": "REDIS_SSH_IDENTITY_FILE",
        "knownHostsFileEnv": "REDIS_SSH_KNOWN_HOSTS_FILE"
      }
    }
  ],
  "seeds": [
    "monitor-a",
    "monitor-b",
    "monitor-c"
  ],
  "connectTimeoutMs": 10000,
  "startupTimeoutMs": 60000,
  "closeTimeoutMs": 5000,
  "keepAliveSeconds": 10,
  "maxMissedKeepAlives": 3
}
