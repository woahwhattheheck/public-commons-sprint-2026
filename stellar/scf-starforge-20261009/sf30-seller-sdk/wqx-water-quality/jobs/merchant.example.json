{
  "schema": "stellar-forge.paid-jobs.v1",
  "application": "./application.mjs",
  "publicOrigin": "https://water-jobs.example",
  "serviceName": "WQX Water Quality Scientific Review",
  "environment": [
    "WQX_JOB_TEMP_ROOT"
  ],
  "workerCount": 1,
  "maxPending": 8,
  "maxJobs": 1000,
  "memoryLimitMb": 768,
  "inputFileStorage": {
    "maxBytes": 536870912,
    "maxUploads": 128
  },
  "functions": {
    "waterQualityReview": {
      "path": "/water-quality-review",
      "description": "Recompute a complete original WQX scientific review and its selected Open Waters receiving plan; deliver the exact source, decisions and every native output in one portable archive.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reviewId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
            "minLength": 1,
            "maxLength": 96
          },
          "planId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
            "minLength": 1,
            "maxLength": 96
          },
          "expectedCaptureSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "expectedReviewSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "reviewId"
        ],
        "additionalProperties": false
      },
      "example": {
        "reviewId": "potomac-scientific-job-01"
      },
      "inputFiles": {
        "slots": {
          "source": {
            "required": true,
            "description": "Complete native WQX review bundle or Open Waters bundle, with its original capture and saved reviewer choices.",
            "mediaTypes": [
              "application/json"
            ],
            "maxBytes": 67108864
          },
          "choices": {
            "required": false,
            "description": "Optional starforge.wqx-job-choices.v1 JSON bound to the source review SHA, with explicit replacement scientific options, note or Open Waters choices.",
            "mediaTypes": [
              "application/json"
            ],
            "maxBytes": 2097152
          }
        },
        "maxTotalBytes": 69206016
      },
      "payment": {
        "scheme": "exact",
        "network": "stellar:testnet",
        "asset": "UNVERIFIED_DEMO_ASSET",
        "payTo": "UNVERIFIED_DEMO_RECIPIENT",
        "amount": "10000",
        "maxTimeoutSeconds": 60
      },
      "timeoutMs": 600000,
      "maxInputBytes": 262144,
      "maxOutputBytes": 67108864,
      "output": {
        "format": "bytes",
        "contentType": "application/zip",
        "filename": "water-quality-scientific-review.zip"
      }
    }
  },
  "intake": {
    "enabled": true,
    "functions": [
      "waterQualityReview"
    ]
  }
}
