{
  "schema": "stellar-forge.paid-jobs.v1",
  "application": "./application.mjs",
  "publicOrigin": "https://water-jobs.example",
  "serviceName": "WQX Water Quality Scientific Review",
  "environment": [
    "WQX_JOB_TEMP_ROOT"
  ],
  "workerCount": 1,
  "maxPending": 8,
  "maxJobs": 1000,
  "memoryLimitMb": 768,
  "inputFileStorage": {
    "maxBytes": 536870912,
    "maxUploads": 128
  },
  "functions": {
    "waterQualityReview": {
      "path": "/water-quality-review",
      "description": "Recompute an original WQX review/Open Waters plan or independently receive a complete paired scientific edition; deliver the exact sealed source, saved choices and every native output in one portable archive.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reviewId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
            "minLength": 1,
            "maxLength": 96,
            "description": "New review name in review mode; exact already-saved scientific review name in scientific mode."
          },
          "planId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
            "minLength": 1,
            "maxLength": 96
          },
          "expectedCaptureSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "expectedReviewSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "mode": {
            "type": "string",
            "enum": [
              "review",
              "scientific"
            ],
            "description": "review retains the original review/Open Waters job; scientific receives the exact complete saved paired edition."
          },
          "expectedScientificReviewSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64,
            "description": "Required for scientific mode; exact saved scientific review identity inside the sealed source."
          }
        },
        "required": [
          "reviewId"
        ],
        "additionalProperties": false
      },
      "example": {
        "reviewId": "potomac-scientific-job-01"
      },
      "inputFiles": {
        "slots": {
          "source": {
            "required": true,
            "description": "Complete original WQX review/Open Waters bundle (review mode, up to 64 MiB), or complete native paired scientific bundle (scientific mode, up to 128 MiB).",
            "mediaTypes": [
              "application/json"
            ],
            "maxBytes": 134217728
          },
          "choices": {
            "required": false,
            "description": "Optional original starforge.wqx-job-choices.v1 replacements for review mode. Scientific mode carries the complete already-reviewed selection in its source bundle and does not take this slot.",
            "mediaTypes": [
              "application/json"
            ],
            "maxBytes": 2097152
          }
        },
        "maxTotalBytes": 136314880
      },
      "payment": {
        "scheme": "exact",
        "network": "stellar:testnet",
        "asset": "UNVERIFIED_DEMO_ASSET",
        "payTo": "UNVERIFIED_DEMO_RECIPIENT",
        "amount": "10000",
        "maxTimeoutSeconds": 60
      },
      "timeoutMs": 600000,
      "maxInputBytes": 262144,
      "maxOutputBytes": 67108864,
      "output": {
        "format": "bytes",
        "contentType": "application/zip",
        "filename": "water-quality-scientific-review.zip"
      }
    }
  },
  "intake": {
    "enabled": true,
    "functions": [
      "waterQualityReview"
    ]
  }
}
