<% chosen = @detail.fetch("selection"); id = chosen.fetch("id"); source = @source_summary.fetch("source"); page = @source_rows.fetch("page") %>
<div class="heading">
  <div><h2>Original source rows</h2><p><%= chosen.dig("candidate","title") %></p></div>
  <%= link_to "Configure field mapping",action: :mapping,id: id %>
</div>
<nav class="actions" aria-label="Original source downloads">
  <%= link_to "Review overview",action: :show,id: id %>
  <%= link_to "Download complete original CSV",action: :source_export,id: id,format: "csv" %>
  <%= link_to "Download complete original JSONL",action: :source_export,id: id,format: "jsonl" %>
  <%= link_to "Complete source handoff",action: :handoff,id: id %>
  <%= link_to "Original attachments",action: :attachments,id: id %>
</nav>
<section aria-labelledby="source-rows-heading">
  <h3 id="source-rows-heading"><%= @source_rows.fetch("total") %> original rows</h3>
  <p>Page <%= page+1 %> of <%= @source_rows.fetch("pages") %>. Values retain the original source types and field names. Each record's unmodified source JSON is available beside its values.</p>
  <% if @source_rows.fetch("rows").empty? %>
    <p class="empty">This complete source contains no rows.</p>
  <% else %>
    <div class="scroll" role="region" tabindex="0" aria-label="Original source rows">
      <table class="working-records source-rows">
        <thead><tr><th scope="col">Row</th>
          <% @source_rows.fetch("fields").each do |field| %><th scope="col"><%= field %></th><% end %>
          <th scope="col">Original source JSON</th>
        </tr></thead>
        <tbody>
          <% @source_rows.fetch("rows").each do |row| %>
            <% values = operator_values(row.fetch("values_json")) %>
            <tr>
              <th scope="row"><%= row.fetch("ordinal")+1 %></th>
              <% @source_rows.fetch("fields").each do |field| %>
                <td class="record-cell"><%= values.key?(field) ? operator_data_value(values[field]) : "Not included" %></td>
              <% end %>
              <td>
                <details><summary>Read row <%= row.fetch("ordinal")+1 %></summary>
                  <pre><%= row.fetch("raw_json") %></pre>
                  <p class="small">Source row checksum</p><p class="mono"><%= row.fetch("sha256") %></p>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <nav class="actions" aria-label="Source row pages">
    <% if page > 0 %><%= link_to "Previous page",action: :source_rows,id: id,page: page %><% end %>
    <% if page+1 < @source_rows.fetch("pages") %><%= link_to "Next page",action: :source_rows,id: id,page: page+2 %><% end %>
    <%= form_with url: {action: :source_rows,id: id},method: :get,local: true do %>
      <%= label_tag :page,"Page" %>
      <%= number_field_tag :page,page+1,min: 1,max: @source_rows.fetch("pages") %>
      <%= submit_tag "Go to page" %>
    <% end %>
  </nav>
</section>
<details><summary>Complete retained source</summary>
  <dl class="record-details">
    <dt>Received delivery</dt><dd class="mono"><%= source["delivery_manifest_sha256"] %></dd>
    <dt>Dataset manifest</dt><dd class="mono"><%= source["manifest_sha256"] %></dd>
    <dt>Source checksum</dt><dd class="mono"><%= source["source_sha256"] %></dd>
    <dt>Profile checksum</dt><dd class="mono"><%= @source_summary["summary_sha256"] %></dd>
  </dl>
</details>
