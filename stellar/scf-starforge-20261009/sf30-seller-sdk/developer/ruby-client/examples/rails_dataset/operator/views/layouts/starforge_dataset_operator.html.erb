<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Dataset operations</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag url_for(action: :stylesheet, only_path: true) %>
</head>
<body class="dataset-operator">
  <header><div><h1>Dataset operations</h1><p>Review and import complete source editions</p></div><%= link_to "All reviews", action: :index %></header>
  <main>
    <% flash.each do |kind, message| %><p class="notice" role="status"><%= message %></p><% end %>
    <%= yield %>
  </main>
</body>
</html>
