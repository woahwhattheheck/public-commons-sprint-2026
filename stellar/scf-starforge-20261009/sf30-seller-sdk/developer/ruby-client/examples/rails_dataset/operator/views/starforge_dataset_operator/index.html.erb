<section>
  <h2>Received deliveries</h2>
  <p>Select a complete delivery from the application inbox. Read its full source and choose application fields, or prepare its existing mapping directly.</p>
  <% if @candidates.empty? %><p class="empty">The application inbox has no selected deliveries.</p><% end %>
  <% @candidates.each do |candidate| %>
    <article class="candidate">
      <div>
        <h3><%= candidate["title"] %></h3>
        <p>Stream <%= candidate["stream_id"] %> · <%= candidate["format"] %></p>
        <details>
          <summary>Original source and saved mapping</summary>
          <p class="mono"><%= candidate["manifest_sha256"] %></p>
          <% if operator_mapping_configured?(candidate["mapping"]) %>
            <pre><%= JSON.pretty_generate(candidate["mapping"]) %></pre>
          <% else %>
            <p>Choose application fields after opening the complete source.</p>
          <% end %>
        </details>
      </div>
      <div class="candidate-actions">
        <%= form_with url: {action: :create_source},local: true,class: "source-selection-form" do %>
          <%= hidden_field_tag :selection,operator_token({"review_id"=>SecureRandom.uuid,
            "candidate_id"=>candidate["id"],"selection_sha256"=>candidate["selection_sha256"]},"create_source") %>
          <%= submit_tag "Read source and configure fields",class: "primary" %>
        <% end %>
        <% if operator_mapping_configured?(candidate["mapping"]) %>
          <%= form_with url: {action: :create},local: true do %>
            <%= hidden_field_tag :selection,operator_token({"review_id"=>SecureRandom.uuid,
              "candidate_id"=>candidate["id"],"selection_sha256"=>candidate["selection_sha256"]},"create") %>
            <%= submit_tag "Prepare complete review" %>
          <% end %>
        <% end %>
      </div>
    </article>
  <% end %>
</section>
<section>
  <h2>Review history</h2>
  <div class="scroll"><table><thead><tr><th>Delivery</th><th>Selected</th><th>Operator</th><th>State</th><th></th></tr></thead><tbody>
    <% @reviews["items"].each do |item| %><tr>
      <td><%= item["title"] %></td><td><%= operator_data_time(item["selected_at"]) %></td><td><%= item["actor"] %></td>
      <td><%= operator_data_label(item.dig("state","phase")) %></td><td><%= link_to "Open",action: :show,id: item["id"] %></td>
    </tr><% end %>
  </tbody></table></div>
  <% if @reviews["items"].empty? %><p class="empty">Open a received source to start the first review.</p><% end %>
  <% if @reviews["next_before"] %><p><%= link_to "Earlier reviews",action: :index,before: @reviews["next_before"] %></p><% end %>
</section>
