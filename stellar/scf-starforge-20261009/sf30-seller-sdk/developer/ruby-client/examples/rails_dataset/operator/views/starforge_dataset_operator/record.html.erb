<% id = @detail.dig("selection","id"); capture = @data_capture; capture_id = capture.fetch("id"); record = @record_detail.fetch("record") %>
<% source_values = operator_data_unpack(record.dig("source","values")); imported_values = operator_data_unpack(record.dig("committed","values")); working_values = operator_data_unpack(record.dig("target","values")) %>
<div class="heading">
  <div><h2>Record details</h2><p><%= record["key_text"] %></p></div>
  <% if @return_data %>
    <%= link_to "Back to matching records",action: :records,id: id,capture_id: capture_id,query_id: @return_data.dig("query","id"),page: @return_data["page"]+1 %>
  <% else %>
    <%= link_to "Back to working records",action: :records,id: id,capture_id: capture_id %>
  <% end %>
</div>
<p class="notice">
  <strong><%= operator_data_label(record["status"]) %></strong> · <%= operator_data_label(record["target_state"]) %><br>
  Values saved <%= operator_data_time(capture["captured_at"] || capture["created_at"]) %> from edition <%= capture["revision"] %>.
</p>
<nav class="actions" aria-label="Record sections">
  <a href="#record-values">Field comparison</a><a href="#record-files">Original files</a><a href="#record-source">Original source</a>
  <%= link_to "Review overview",action: :show,id: id %>
</nav>

<section aria-labelledby="record-key-heading">
  <h3 id="record-key-heading">Record key</h3>
  <dl class="record-details">
    <% operator_data_unpack(record.fetch("key")).each do |name,value| %>
      <dt><%= operator_data_column({"label"=>name}) %></dt><dd class="preserve"><%= operator_data_value(value) %></dd>
    <% end %>
  </dl>
  <% if record["status"] == "removed" %>
    <p>This record was removed from the source in edition <%= record.dig("committed","revision") %>. Its last original source row is from edition <%= record.dig("source","revision") %>.</p>
  <% end %>
  <% if record["target_state"] == "missing" %>
    <p class="notice">The application had no current record at the time of this saved dataset. The imported values and original source remain available below.</p>
  <% elsif record["target_state"] == "changed" %>
    <p class="notice">The working record differs from its imported values in <%= record.dig("target","changed_columns").length %> <%= record.dig("target","changed_columns").length == 1 ? "field" : "fields" %>.</p>
  <% end %>
</section>

<section id="record-values" aria-labelledby="comparison-heading">
  <h3 id="comparison-heading">Source, imported values and working values</h3>
  <p>Imported values include the configured field mapping and removal behavior. Working values describe the application when this dataset was saved.</p>
  <div class="scroll" role="region" tabindex="0" aria-label="Complete record field comparison">
    <table>
      <thead><tr><th scope="col">Application field</th><th scope="col">Original source value</th><th scope="col">Imported value</th><th scope="col">Working value</th></tr></thead>
      <tbody>
        <% capture.fetch("columns").select { |column| column["origin"] == "target" }.each do |column| %>
          <% name = column.fetch("key").delete_prefix("target."); source_field = column["source_field"]; changed = record.dig("target","changed_columns").include?(name) %>
          <tr class="<%= changed ? "changed-row" : "" %>">
            <th scope="row"><%= operator_data_column(column) %><br><span class="small"><%= operator_data_type(column["type"]) %><% if changed %> · Changed<% end %></span></th>
            <td class="record-cell">
              <% if source_field && source_values.key?(source_field) %>
                <%= operator_data_value(source_values[source_field]) %><br><span class="small">Source field: <%= operator_data_column({"label"=>source_field}) %></span>
              <% elsif source_field %><span class="small">Not included in this original row</span>
              <% else %><span class="small">Set by the application mapping</span><% end %>
            </td>
            <td class="record-cell"><%= imported_values.key?(name) ? operator_data_value(imported_values[name]) : "Not included" %></td>
            <td class="record-cell">
              <% if record["target_state"] == "missing" %><span class="small">No current record</span>
              <% elsif working_values.key?(name) %><%= operator_data_value(working_values[name]) %>
              <% else %><span class="small">Not included</span><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="small">“Empty value” means the field contains no value. “Empty text” is a present, empty text value. “Not included” means that field is absent.</p>
</section>

<section id="record-files" aria-labelledby="files-heading">
  <h3 id="files-heading">Original files</h3>
  <p>Files belong to this record’s original source edition and remain linked to their receiving review.</p>
  <% if record.fetch("attachments").empty? %>
    <p class="empty">This record has no retained original files.</p>
  <% else %>
    <% record.fetch("attachments").each do |file| %>
      <article class="record-file">
        <div><h4><%= file["filename"] %></h4>
          <p><%= file["mime_type"] %> · <%= number_to_human_size(file["bytes"]) %> · Field <%= operator_data_column({"label"=>file["column"]}) %> · File <%= file["index"]+1 %></p>
          <details><summary>Original file details</summary>
            <dl class="record-details"><dt>Exact bytes</dt><dd><%= file["bytes"] %></dd>
              <dt>Checksum</dt><dd class="mono"><%= file["sha256"] %></dd>
              <dt>Original record</dt><dd class="mono"><%= file["record_id"] %></dd>
              <dt>Receiving review</dt><dd><%= link_to "Open original receiving review",action: :show,id: file["review_id"] %></dd></dl>
          </details>
        </div>
        <%= link_to "Download original file",action: :data_attachment,id: id,capture_id: capture_id,
          key_sha256: record["key_sha256"],file: file["file"],record_id: file["record_id"],
          column: file["column"],index: file["index"] %>
      </article>
    <% end %>
  <% end %>
</section>

<section id="record-source" aria-labelledby="source-heading">
  <h3 id="source-heading">Complete original source row</h3>
  <p>Source edition <%= record.dig("source","revision") %>, original position <%= record.dig("source","ordinal") %>. Every received field is retained here.</p>
  <div class="scroll" role="region" tabindex="0" aria-label="All original source fields">
    <table><thead><tr><th scope="col">Source field</th><th scope="col">Original value</th></tr></thead>
      <tbody><% source_values.each do |name,value| %>
        <tr><th scope="row"><%= operator_data_column({"label"=>name}) %></th><td class="record-cell"><%= operator_data_value(value) %></td></tr>
      <% end %></tbody>
    </table>
  </div>
  <details><summary>Original JSON and source identifiers</summary>
    <pre><%= record.dig("source","raw_json") %></pre>
    <dl class="record-details">
      <dt>Original source edition</dt><dd class="mono"><%= record.dig("source","edition_id") %></dd>
      <dt>Source manifest checksum</dt><dd class="mono"><%= record.dig("source","manifest_sha256") %></dd>
      <dt>Source row checksum</dt><dd class="mono"><%= record.dig("source","row_sha256") %></dd>
      <dt>Business key checksum</dt><dd class="mono"><%= record["key_sha256"] %></dd>
      <dt>Application record</dt><dd class="mono"><%= record.dig("target","id") || "No current record" %></dd>
    </dl>
  </details>
</section>

<section aria-labelledby="record-downloads-heading">
  <h3 id="record-downloads-heading">Edition records and downloads</h3>
  <div class="actions">
    <%= link_to "Original source edition receipt",action: :receipt,id: id,edition_id: record.dig("source","edition_id") %>
    <%= link_to "Latest import receipt for this record",action: :receipt,id: id,edition_id: record.dig("committed","edition_id") %>
    <% if @return_data %>
      <%= link_to "Download all matching records as CSV",action: :data_export,id: id,capture_id: capture_id,query_id: @return_data.dig("query","id"),format: "csv" %>
      <%= link_to "Download all matching records as JSON",action: :data_export,id: id,capture_id: capture_id,query_id: @return_data.dig("query","id"),format: "json" %>
    <% end %>
  </div>
  <p class="small">Dataset saved by <%= capture["actor"] %> at <%= operator_data_time(capture["captured_at"] || capture["created_at"]) %>.</p>
</section>
