<% chosen = @detail["selection"]; candidate = chosen["candidate"]; review = @detail["review"]; id = chosen["id"] %>
<div class="heading"><div><h2><%= candidate["title"] %></h2><p>Selected <%= chosen["selected_at"] %> by <%= chosen["actor"] %> · Stream <%= candidate["stream_id"] %></p></div><%= link_to "Refresh", action: :show, id: id %></div>
<p class="notice" role="status">Current state: <strong><%= @detail.dig("state","phase").tr("_"," ") %></strong>
<% if @detail.dig("state","message") %><br><%= @detail.dig("state","message") %><% end %></p>
<% if review %>
  <div class="metrics">
    <% %w[inserted updated unchanged removed].each do |kind| %><div><span><%= kind.capitalize %></span><strong><%= review.dig("summary","counts",kind) %></strong></div><% end %>
  </div>
  <nav class="actions" aria-label="Review sections">
    <%= link_to "Review all changes", action: :changes,id: id %>
    <%= link_to "Original attachments", action: :attachments,id: id %>
    <%= link_to "Edition history", action: :history,id: id %>
    <%= link_to "Complete review handoff", action: :handoff,id: id %>
  </nav>
  <section><h3>Review this source against current records</h3>
    <p>Refresh creates a new review from this retained delivery and mapping. Its complete preview reflects the application's current records.</p>
    <%= form_with url: {action: :refresh,id: id}, local: true do %>
      <%= hidden_field_tag :selection, operator_token({"original_review_id"=>id,"review_id"=>SecureRandom.uuid},"refresh") %>
      <%= submit_tag "Refresh from saved source" %>
    <% end %>
  </section>
  <section><h3>Selected application mapping</h3>
    <p><%= review.dig("summary","row_count") %> complete incoming/removal entries. The application rechecks this exact preview inside its import transaction.</p>
    <pre><%= JSON.pretty_generate(candidate["mapping"]) %></pre>
    <p class="mono">Preview <%= review.dig("summary","preview_sha256") %></p>
    <div class="actions"><%= link_to "Complete JSON", action: :download,id: id,name: "preview.json" %><%= link_to "Complete CSV", action: :download,id: id,name: "preview.csv" %><%= link_to "Mapping JSON", action: :download,id: id,name: "mapping.json" %></div>
  </section>
  <% if @detail["committed"] %>
    <% receipt = @detail.dig("committed","receipt") %>
    <section><h3>Committed edition <%= receipt["revision"] %></h3><p>Committed <%= receipt["committed_at"] %>. The original import operation and full source history are retained.</p><%= link_to "Download complete receipt",action: :download,id: id,name: "receipt.json" %></section>
  <% else %>
    <section><h3>Import the selected edition</h3><p>The application uses its normal model validations, callbacks and tenant scope. If records changed after this review, prepare a new review from the received delivery.</p>
      <%= form_with url: {action: :commit,id: id}, local: true do %>
        <%= hidden_field_tag :selection, operator_token({"review_id"=>id,"preview_sha256"=>review.dig("summary","preview_sha256")},"commit") %>
        <%= submit_tag(@detail["approved"] ? "Resume this import" : "Approve and import edition",class: "primary") %>
      <% end %>
    </section>
  <% end %>
<% else %>
  <section><h3>Preparing the complete source and preview</h3><p>This review retains the selected source and original request. Refresh for the current result. Resume continues its preparation after an interrupted job.</p>
    <%= button_to "Resume preparation", {action: :prepare,id: id}, method: :post %>
  </section>
<% end %>
<details><summary>Original review selection</summary><p>Review <span class="mono"><%= id %></span></p><p>Source manifest <span class="mono"><%= candidate["manifest_sha256"] %></span></p><p>Format <%= candidate["format"] %></p><p>Original operation <span class="mono"><%= chosen["operation_key"] %></span></p></details>
