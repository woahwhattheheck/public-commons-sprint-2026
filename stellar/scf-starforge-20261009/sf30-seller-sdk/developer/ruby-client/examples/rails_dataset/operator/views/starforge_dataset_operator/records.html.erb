<% id = @detail.dig("selection","id"); current = @data_catalog.fetch("current") %>
<div class="heading">
  <div><h2>Working records</h2><p><%= @detail.dig("selection","candidate","title") %></p></div>
  <%= link_to "Review overview",action: :show,id: id %>
</div>
<nav class="actions" aria-label="Dataset sections">
  <%= link_to "Edition changes",action: :changes,id: id %>
  <%= link_to "Original attachments",action: :attachments,id: id %>
  <%= link_to "Edition history",action: :history,id: id %>
</nav>

<section aria-labelledby="capture-heading">
  <div class="heading">
    <div><h3 id="capture-heading">Save the current working dataset</h3>
      <p>Save all records in this stream with their original source, imported values and current application values. Search, pages and downloads use the same saved dataset.</p>
    </div>
    <% if current["can_capture"] %>
      <%= form_with url: {action: :capture_data,id: id},local: true,id: "data-capture-form" do %>
        <%= hidden_field_tag :selection,operator_token({"review_id"=>id,"capture_id"=>SecureRandom.uuid,
          "capture_actor"=>@operator_actor,"expected_revision"=>current.fetch("revision"),
          "expected_receipt_sha256"=>current.fetch("receipt_sha256")},"data_capture") %>
        <%= submit_tag "Save current records",class: "primary" %>
      <% end %>
    <% end %>
  </div>
  <p class="small">Latest imported edition: <%= current["revision"] %></p>
  <% unless current["can_capture"] %>
    <p class="notice"><%= current["reason"] %>
      <% if current["current_review_id"] %><%= link_to "Open the latest edition review",action: :show,id: current["current_review_id"] %><% end %>
    </p>
  <% end %>
  <% pending = @data_catalog.fetch("pending"); pending = [@data_pending_selection] + pending.reject { |item| item["id"] == @data_pending_selection["id"] } if @data_pending_selection %>
  <% unless pending.empty? %>
    <h4>Captures in progress</h4>
    <% pending.each do |item| %>
      <% request = item.fetch("request") %>
      <div class="pending-capture">
        <div><strong><%= operator_data_label(item["state"]) %></strong>
          <p>Selected <%= operator_data_time(request["created_at"]) %> by <%= request["actor"] %> for edition <%= request["expected_revision"] %>.</p>
          <% if item["error"] %>
            <p class="notice" role="alert">This capture needs attention. Resolve the reported issue, then resume this saved operation.</p>
            <details><summary>Capture details</summary><pre><%= JSON.pretty_generate(item["error"]) %></pre></details>
          <% end %>
        </div>
        <div class="actions">
          <%= link_to "Refresh",action: :records,id: id,capture_id: item["id"] %>
          <%= form_with url: {action: :capture_data,id: id},local: true do %>
            <%= hidden_field_tag :selection,operator_token({"review_id"=>id,"capture_id"=>item["id"],
              "capture_actor"=>request.fetch("actor"),"expected_revision"=>request.fetch("expected_revision"),
              "expected_receipt_sha256"=>request.fetch("expected_receipt_sha256")},"data_capture") %>
            <%= submit_tag "Resume saved capture" %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</section>

<% unless @data_catalog.fetch("items").empty? %>
  <section aria-labelledby="saved-heading">
    <h3 id="saved-heading">Saved datasets</h3>
    <%= form_with url: {action: :records,id: id},method: :get,local: true,class: "actions" do %>
      <%= label_tag :capture_id,"Saved dataset" %>
      <%= select_tag :capture_id,options_for_select(@data_catalog.fetch("items").map { |capture|
        ["#{operator_data_time(capture["captured_at"] || capture["created_at"])} — edition #{capture["revision"]}, #{capture.dig("counts","total")} records",capture["id"]]
      },@data_capture && @data_capture["id"]) %>
      <%= submit_tag "Open dataset" %>
    <% end %>
    <% if @data_catalog["next_before"] %><%= link_to "Earlier saved datasets",action: :records,id: id,capture_before: @data_catalog["next_before"] %><% end %>
    <% if params[:capture_before].present? %><%= link_to "Latest saved datasets",action: :records,id: id %><% end %>
  </section>
<% end %>

<% if @data %>
  <% capture = @data_capture; query = @data_query; capture_id = capture.fetch("id") %>
  <section aria-labelledby="dataset-heading">
    <h3 id="dataset-heading">Records saved <%= operator_data_time(capture["captured_at"] || capture["created_at"]) %></h3>
    <p>Edition <%= capture["revision"] %>. These values stay fixed when the application changes. Save current records above to include later edits.</p>
    <div class="metrics record-metrics">
      <% [["total","All records"],["active","Present in source"],["removed","Removed from source"],["unchanged","Matches imported values"],["changed","Edited after import"],["missing","No current record"]].each do |key,label| %>
        <div><span><%= label %></span><strong><%= capture.dig("counts",key) %></strong></div>
      <% end %>
    </div>
    <% if capture["revision"] != current["revision"] %><p class="notice">The application now has edition <%= current["revision"] %>. This saved dataset retains edition <%= capture["revision"] %>.</p><% end %>
  </section>

  <section aria-labelledby="search-heading">
    <h3 id="search-heading">Search and filter records</h3>
    <%= form_with url: {action: :records,id: id},method: :get,local: true,id: "record-query-form" do %>
      <%= hidden_field_tag :capture_id,capture_id %>
      <div class="record-search">
        <%= label_tag "record-search","Search original source and working values" %>
        <%= search_field_tag "query[search]",query.fetch("search"),id: "record-search",maxlength: 4096 %>
      </div>
      <div class="record-filter-groups">
        <fieldset><legend>Source membership</legend>
          <%= hidden_field_tag "query[statuses][]","",id: nil %>
          <% %w[active removed].each do |state| %>
            <label class="check-label"><%= check_box_tag "query[statuses][]",state,query.fetch("statuses").include?(state),id: "membership-"+state %><span><%= operator_data_label(state) %></span></label>
          <% end %>
        </fieldset>
        <fieldset><legend>Working record</legend>
          <%= hidden_field_tag "query[target_states][]","",id: nil %>
          <% %w[unchanged changed missing].each do |state| %>
            <label class="check-label"><%= check_box_tag "query[target_states][]",state,query.fetch("target_states").include?(state),id: "working-"+state %><span><%= operator_data_label(state) %></span></label>
          <% end %>
        </fieldset>
      </div>
      <% options = [["Choose a column",""]] + @data.fetch("columns").map { |column| ["#{operator_data_column(column)} — #{operator_data_type(column["type"])}",column["key"]] } %>
      <% filters = query.fetch("filters").dup; filters << {} if filters.length < 32 %>
      <fieldset class="query-rules"><legend>Column filters</legend>
        <p class="small">Every selected filter must match. Leave the column blank to remove a filter. Apply the search to add another row. Enter exact numbers, true or false, dates as YYYY-MM-DD, or dates and times with their UTC offset.</p>
        <% filters.each_with_index do |filter,index| %>
          <div class="query-rule">
            <div><%= label_tag "filter-column-#{index}","Column #{index+1}" %><%= select_tag "query[filters][#{index}][column]",options_for_select(options,filter["column"]),id: "filter-column-#{index}" %></div>
            <div><%= label_tag "filter-operator-#{index}","Condition" %><%= select_tag "query[filters][#{index}][operator]",options_for_select([["Equals","eq"],["Does not equal","ne"],["Contains text","contains"],["Starts with text","starts_with"],["Greater than","gt"],["At least","gte"],["Less than","lt"],["At most","lte"],["Has no value","is_null"],["Has a value","not_null"]],filter.fetch("operator","eq")),id: "filter-operator-#{index}" %></div>
            <div><%= label_tag "filter-value-#{index}","Value" %><%= text_field_tag "query[filters][#{index}][value]",filter.key?("value") ? filter["value"].to_s : "",id: "filter-value-#{index}" %></div>
          </div>
        <% end %>
      </fieldset>
      <% sorts = query.fetch("sort").dup; sorts << {} if sorts.length < 8 %>
      <fieldset class="query-rules"><legend>Sort order</legend>
        <p class="small">Sort columns apply in this order. Record keys resolve equal values consistently.</p>
        <% sorts.each_with_index do |sort,index| %>
          <div class="query-rule">
            <div><%= label_tag "sort-column-#{index}","Sort column #{index+1}" %><%= select_tag "query[sort][#{index}][column]",options_for_select(options,sort["column"]),id: "sort-column-#{index}" %></div>
            <div><%= label_tag "sort-direction-#{index}","Direction" %><%= select_tag "query[sort][#{index}][direction]",options_for_select([["Ascending","asc"],["Descending","desc"]],sort.fetch("direction","asc")),id: "sort-direction-#{index}" %></div>
            <div><%= label_tag "sort-nulls-#{index}","Empty values" %><%= select_tag "query[sort][#{index}][nulls]",options_for_select([["Last","last"],["First","first"]],sort.fetch("nulls","last")),id: "sort-nulls-#{index}" %></div>
          </div>
        <% end %>
      </fieldset>
      <div class="actions"><%= submit_tag "Apply search and filters",class: "primary" %><%= link_to "Reset search",action: :records,id: id,capture_id: capture_id %></div>
    <% end %>
  </section>

  <section aria-labelledby="results-heading">
    <div class="heading">
      <div><h3 id="results-heading"><%= @data["total"] %> matching records</h3><p>Page <%= @data["page"] + 1 %> of <%= @data["pages"] %>. Downloads include every matching record in the selected order.</p></div>
      <div class="actions">
        <%= link_to "Download all matching records as CSV",action: :data_export,id: id,capture_id: capture_id,query_id: @data_query_id,format: "csv" %>
        <%= link_to "Download all matching records as JSON",action: :data_export,id: id,capture_id: capture_id,query_id: @data_query_id,format: "json" %>
      </div>
    </div>
    <% if @data["rows"].empty? %>
      <p class="empty">No records match these filters. Adjust the search or include other record states.</p>
    <% else %>
      <div class="scroll" role="region" tabindex="0" aria-label="Working record results">
        <table class="working-records">
          <caption class="visually-hidden">All selected columns from the saved working dataset</caption>
          <thead><tr>
            <% @data.fetch("columns").each do |column| %><th scope="col"><%= operator_data_column(column) %><br><span class="small"><%= operator_data_type(column["type"]) %></span></th><% end %>
            <th scope="col">Original files</th>
          </tr></thead>
          <tbody>
            <% @data["rows"].each do |row| %>
              <tr>
                <% @data.fetch("columns").each do |column| %>
                  <% key = column.fetch("key"); cell = row.fetch("cells") %>
                  <td class="record-cell <%= %w[integer decimal].include?(column["type"]) ? "number" : "" %>">
                    <% if key == "@key" %>
                      <%= link_to row.fetch("key_text"),action: :record,id: id,capture_id: capture_id,query_id: @data_query_id,page: @data["page"]+1,key_sha256: row["key_sha256"] %>
                    <% elsif %w[@status @target_state].include?(key) %>
                      <%= operator_data_label(operator_data_unpack(cell[key])) %>
                    <% elsif row["target_state"] == "missing" %>
                      <span class="small">No current record</span>
                    <% elsif cell.key?(key) %>
                      <%= operator_data_value(operator_data_unpack(cell[key])) %>
                    <% else %>
                      <span class="small">Not included</span>
                    <% end %>
                  </td>
                <% end %>
                <td><%= row.fetch("attachments").length %> <%= row.fetch("attachments").length == 1 ? "file" : "files" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
    <nav class="actions" aria-label="Record pages">
      <% if @data["page"] > 0 %><%= link_to "Previous page",action: :records,id: id,capture_id: capture_id,query_id: @data_query_id,page: @data["page"] %><% end %>
      <% if @data["page"]+1 < @data["pages"] %><%= link_to "Next page",action: :records,id: id,capture_id: capture_id,query_id: @data_query_id,page: @data["page"]+2 %><% end %>
      <%= form_with url: {action: :records,id: id},method: :get,local: true do %>
        <%= hidden_field_tag :capture_id,capture_id %><%= hidden_field_tag :query_id,@data_query_id %>
        <%= label_tag :page,"Page" %><%= number_field_tag :page,@data["page"]+1,min: 1,max: @data["pages"] %><%= submit_tag "Go to page" %>
      <% end %>
    </nav>
    <details><summary>Use this saved dataset for an application export</summary>
      <p>Copy this complete selection into the managed application's Working data selection field, then verify or export the stopped application. It identifies this saved dataset and its original edition review.</p>
      <%= label_tag "working-export-selection","Saved dataset selection" %>
      <%= text_area_tag "working_export_selection",JSON.pretty_generate({"reviewId"=>id,"captureId"=>capture_id,"expectedCaptureSha256"=>capture.fetch("sha256")}),id: "working-export-selection",readonly: true,rows: 7,class: "export-selection",spellcheck: false %>
    </details>
    <details><summary>Dataset and source details</summary>
      <dl class="record-details">
        <dt>Saved by</dt><dd><%= capture["actor"] %></dd>
        <dt>Stream</dt><dd class="mono"><%= capture["stream_id"] %></dd>
        <dt>Saved dataset</dt><dd class="mono"><%= capture["id"] %></dd>
        <dt>Dataset checksum</dt><dd class="mono"><%= capture["sha256"] %></dd>
        <dt>Source manifest checksum</dt><dd class="mono"><%= capture.dig("source","manifest_sha256") %></dd>
        <dt>Import receipt checksum</dt><dd class="mono"><%= capture["receipt_sha256"] %></dd>
      </dl>
    </details>
  </section>
<% elsif @data_catalog.fetch("items").empty? && @data_catalog.fetch("pending").empty? %>
  <p class="empty">Save current records to browse this stream, inspect its original source and export the working dataset.</p>
<% end %>
