<% id = @detail.dig("selection","id") %>
<div class="heading"><div><h2>Original source attachments</h2><p><%= @attachments["total"] %> retained files. Each download follows an original selected row and field reference.</p></div><%= link_to "Review overview",action: :show,id: id %></div>
<% @attachments["files"].each do |file| %>
<section>
  <h3><%= file["filename"] %></h3>
  <p><%= file["bytes"] %> bytes · <%= file["mime_type"] %></p><p class="mono"><%= file["sha256"] %></p>
  <details><summary>All original selected references (<%= file["references"].length %>)</summary>
    <div class="scroll"><table><thead><tr><th>Original record</th><th>Selected field</th><th>File position</th><th></th></tr></thead><tbody>
      <% file["references"].each do |reference| %><tr>
        <td class="mono"><%= reference["record_id"] %></td><td><%= reference["column"] %></td><td><%= reference["index"] %></td>
        <td><%= link_to "Download original file",action: :attachment,id: id,file: file["file"],record_id: reference["record_id"],column: reference["column"] %></td>
      </tr><% end %>
    </tbody></table></div>
  </details>
</section>
<% end %>
<% if @attachments["files"].empty? %><p class="empty">This delivery contains no retained attachment files.</p><% end %>
<nav class="actions" aria-label="Attachment pages">
<% if @attachments["offset"] > 0 %><%= link_to "Previous files",action: :attachments,id: id,offset: [0,@attachments["offset"] - Starforge::DatasetOperator::PAGE_SIZE].max %><% end %>
<% if @attachments["next_offset"] %><%= link_to "Next files",action: :attachments,id: id,offset: @attachments["next_offset"] %><% end %>
</nav>
