<% chosen = @detail.fetch("selection"); candidate = chosen.fetch("candidate"); id = chosen.fetch("id") %>
<div class="heading">
  <div><h2>Configure field mapping</h2><p><%= candidate["title"] %></p></div>
  <%= link_to "Review overview",action: :show,id: id %>
</div>
<% if @mapping_problem %><p class="notice" role="alert"><%= @mapping_problem %></p><% end %>

<% unless @mapping_context %>
  <section aria-labelledby="source-preparation-heading">
    <h3 id="source-preparation-heading">Read the complete original source</h3>
    <p>The source is copied into this review before field selection. Every source row is read to describe its actual value types and prepare the complete source browser.</p>
    <p class="notice" role="status"><%= operator_data_label(@detail.dig("state","phase")) %>
      <% if @detail.dig("state","message") %><br><%= @detail.dig("state","message") %><% end %>
    </p>
    <div class="actions">
      <%= link_to "Refresh source status",action: :mapping,id: id %>
      <%= form_with url: {action: :prepare_source,id: id},local: true,id: "source-prepare-form" do %>
        <%= hidden_field_tag :selection,operator_token({"review_id"=>id},"source_prepare") %>
        <%= submit_tag "Read or resume complete source",class: "primary" %>
      <% end %>
    </div>
  </section>
<% else %>
  <% context = @mapping_context; source = context.fetch("source"); target = context.fetch("target")
     key_mapping = target["key_mapping"]; form = @mapping_form || {}; fields = source.fetch("fields")
     locked_keys = key_mapping ? key_mapping.fetch("key_columns") : []
     can_choose_key = key_mapping || !target.fetch("unique_keys").empty? %>
  <nav class="actions" aria-label="Source and mapping sections">
    <%= link_to "Browse every source row",action: :source_rows,id: id %>
    <%= link_to "Original CSV",action: :source_export,id: id,format: "csv" %>
    <%= link_to "Original JSONL",action: :source_export,id: id,format: "jsonl" %>
    <%= link_to "Complete source handoff",action: :handoff,id: id %>
    <%= link_to "Selected mapping JSON",action: :mapping_export,id: id %>
  </nav>

  <section aria-labelledby="source-profile-heading">
    <h3 id="source-profile-heading">Complete source profile</h3>
    <p><%= source.fetch("row_count") %> original rows and <%= fields.length %> projected columns. These counts describe every retained row. Date-like text remains text until an application field supplies its conversion.</p>
    <div class="scroll" role="region" tabindex="0" aria-label="Complete source column profile">
      <table>
        <thead><tr><th scope="col">Source column</th><th scope="col">Observed values</th><th scope="col">Empty values</th><th scope="col">Missing values</th><th scope="col">Text length</th></tr></thead>
        <tbody>
          <% context.fetch("source_columns").each do |column| %>
            <tr>
              <th scope="row"><%= column.fetch("name") %></th>
              <td><%= operator_source_types(column) %></td>
              <td class="number"><%= column.fetch("null_count") %></td>
              <td class="number"><%= column.fetch("missing_count") %></td>
              <td><%= column["string_max_chars"] ? "#{column["string_min_chars"]}–#{column["string_max_chars"]} characters" : "No text values" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <%= form_with url: {action: :save_mapping,id: id},local: true,id: "mapping-form" do %>
    <%= hidden_field_tag :selection,operator_token({"original_review_id"=>id,
      "review_id"=>@mapping_review_id,"context_sha256"=>context.fetch("context_sha256")},"mapping_save") %>
    <section aria-labelledby="record-key-heading">
      <h3 id="record-key-heading">Record key</h3>
      <% if key_mapping %>
        <p>This stream uses the following original key. Its source fields and conversion options stay attached to the existing records.</p>
        <dl class="record-details">
          <% locked_keys.each do |name| %>
            <dt><%= operator_mapping_label(name) %></dt>
            <dd><%= key_mapping.dig("columns",name,"field") %> · <%= operator_data_type(key_mapping.dig("columns",name,"type")) %></dd>
          <% end %>
        </dl>
      <% elsif can_choose_key %>
        <p>Choose the application's existing unique key. Every selected key field needs a source column and a nonempty value in every row. Composite keys use all listed fields together.</p>
        <%= label_tag "mapping-key-index","Unique application key" %>
        <%= select_tag "mapping[key_index]",options_for_select(
          [["Choose the record key",""]] + target.fetch("unique_keys").map { |index|
            [index.fetch("columns").map { |name| operator_mapping_label(name) }.join(" + "),index.fetch("name")]
          },form["key_index"]),id: "mapping-key-index" %>
      <% else %>
        <p class="notice">This application has no available unique record key for import. Add the appropriate unique index to the original application schema, then reopen this mapping. The complete source remains available above.</p>
      <% end %>
    </section>

    <section aria-labelledby="field-selection-heading">
      <h3 id="field-selection-heading">Application fields</h3>
      <p>Choose a source column for each field managed by this dataset. Leave a field unselected to preserve application-owned values. The application supplies each field's type, size and precision.</p>
      <p class="small">An empty source value is explicit null. A missing source column is a separate condition. Record-key fields always require a value. Text conversion writes a number or yes/no value as its exact text.</p>
      <% target.fetch("columns").each_with_index do |column,index| %>
        <% name = column.fetch("name"); row = operator_mapping_row(form,name); field_id = "mapping-field-#{index}" %>
        <fieldset class="mapping-field">
          <legend><%= operator_mapping_label(name) %></legend>
          <p class="small mapping-field-description">
            <%= operator_data_type(column.fetch("type")) %> · <%= column["null"] ? "Empty values allowed" : "Value required" %>
            <% if column["type"] == "string" && column["limit"] %> · Up to <%= column["limit"] %> characters<% end %>
            <% if column["type"] == "decimal" && column["precision"] %> · <%= column["precision"] %> total digits<% end %>
            <% if column["type"] == "decimal" && !column["scale"].nil? %> · <%= column["scale"] %> decimal places<% end %>
            <% if column["type"] == "datetime" && !column["precision"].nil? %> · <%= column["precision"] %> fractional second digits<% end %>
            <% if column["default_present"] %> · Application default available<% end %>
          </p>
          <% if locked_keys.include?(name) %>
            <% spec = key_mapping.fetch("columns").fetch(name) %>
            <p>Original record key: <strong><%= spec.fetch("field") %></strong>. Every row requires this value.
              <% if spec.fetch("stringify",false) %>Numbers and yes/no values use their original text.<% end %>
            </p>
          <% else %>
            <%= hidden_field_tag "mapping[rows][#{index}][column]",name,id: nil %>
            <div class="mapping-field-controls">
              <div>
                <%= label_tag field_id,"Source column" %>
                <%= select_tag "mapping[rows][#{index}][field]",options_for_select(
                  [["Keep application values",""]] + fields.map { |field| [field,field] },row.fetch("field","")),
                  id: field_id %>
              </div>
              <div>
                <%= label_tag "#{field_id}-null","Empty source value" %>
                <%= select_tag "mapping[rows][#{index}][null]",options_for_select(
                  [["Assign empty value","assign"],["Keep current value","preserve"]],row.fetch("null","assign")),
                  id: "#{field_id}-null" %>
              </div>
              <div>
                <%= label_tag "#{field_id}-missing","Missing source column" %>
                <%= select_tag "mapping[rows][#{index}][missing]",options_for_select(
                  [["Require the source column","error"],["Keep current value","preserve"]],row.fetch("missing","error")),
                  id: "#{field_id}-missing" %>
              </div>
              <% if column["type"] == "string" %>
                <div>
                  <%= hidden_field_tag "mapping[rows][#{index}][stringify]","0",id: nil %>
                  <label class="check-label" for="<%= field_id %>-stringify">
                    <%= check_box_tag "mapping[rows][#{index}][stringify]","1",row["stringify"] == "1",id: "#{field_id}-stringify" %>
                    <span>Convert numbers and yes/no values to text</span>
                  </label>
                </div>
              <% else %>
                <%= hidden_field_tag "mapping[rows][#{index}][stringify]","0",id: nil %>
              <% end %>
            </div>
          <% end %>
        </fieldset>
      <% end %>
    </section>

    <section aria-labelledby="removal-heading">
      <h3 id="removal-heading">Records absent from a later source edition</h3>
      <p>The complete review identifies previously managed keys that are absent from this source. Choose whether their application values stay in place or a separate Boolean field marks them inactive.</p>
      <div class="mapping-field-controls">
        <div>
          <%= label_tag "mapping-removal","Absent-record behavior" %>
          <%= select_tag "mapping[removal]",options_for_select(
            [["Keep application values","retain"],["Mark an archive field inactive","archive"]],form.fetch("removal","retain")),
            id: "mapping-removal" %>
        </div>
        <div>
          <%= label_tag "mapping-archive-column","Boolean archive field" %>
          <%= select_tag "mapping[archive_column]",options_for_select(
            [["Choose if archiving",""]] + target.fetch("columns").select { |column| column["type"] == "boolean" }.map {
              |column| [operator_mapping_label(column["name"]),column["name"]]
            },form["archive_column"]),id: "mapping-archive-column" %>
        </div>
        <div>
          <%= label_tag "mapping-archive-active","Archive field values" %>
          <%= select_tag "mapping[archive_active]",options_for_select(
            [["Present: Yes; removed: No","true"],["Present: No; removed: Yes","false"]],
            form.fetch("archive_active","true")),id: "mapping-archive-active" %>
        </div>
      </div>
      <p class="small">Leave the archive field unselected in Application fields above. Yes writes true and No writes false. Choose the direction that matches this application's archive field. A returning key restores its present-record value.</p>
    </section>

    <section aria-labelledby="save-mapping-heading">
      <h3 id="save-mapping-heading">Prepare the complete mapping review</h3>
      <p>Saving retains this mapping in a new review of the same original source. The background job compares every row with the application's current records. Open that review to inspect the full changes and import the selected edition.</p>
      <% if can_choose_key %><%= submit_tag "Save mapping and prepare complete review",class: "primary" %><% end %>
    </section>
  <% end %>
  <details>
    <summary>Original source and application selection</summary>
    <dl class="record-details">
      <dt>Source review</dt><dd class="mono"><%= id %></dd>
      <dt>Application model</dt><dd><%= target["target_model"] %></dd>
      <dt>Current edition</dt><dd><%= target.dig("stream","revision") %></dd>
      <dt>Source manifest</dt><dd class="mono"><%= source["delivery_manifest_sha256"] %></dd>
      <dt>Complete dataset</dt><dd class="mono"><%= source["manifest_sha256"] %></dd>
      <dt>Mapping context</dt><dd class="mono"><%= context["context_sha256"] %></dd>
    </dl>
  </details>
<% end %>
