{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:starforge:groundwater:tethys-receiving-input:v1",
  "title": "Original Tethys receiving input",
  "description": "Populate from an actual completed groundwater workspace backup and original readbacks. Example numbers and IDs are not supplied acceptance data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation_id",
    "user",
    "slot",
    "archive",
    "expected",
    "report_receivings"
  ],
  "properties": {
    "schema": {
      "const": "groundwater.tethys-receiving-input.v1"
    },
    "operation_id": {
      "$ref": "#/$defs/slot"
    },
    "user": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "slot": {
      "$ref": "#/$defs/slot"
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "workspace_version",
        "project_id",
        "source_ids",
        "edition_ids",
        "runs",
        "reports",
        "operations"
      ],
      "properties": {
        "workspace_id": {
          "$ref": "#/$defs/id"
        },
        "workspace_version": {
          "type": "integer",
          "minimum": 0
        },
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "edition_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "result_sha256"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "result_sha256": {
                "$ref": "#/$defs/sha"
              }
            }
          }
        },
        "reports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "report_sha256",
              "archive_sha256",
              "archive_bytes"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "report_sha256": {
                "$ref": "#/$defs/sha"
              },
              "archive_sha256": {
                "$ref": "#/$defs/sha"
              },
              "archive_bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "request_sha256",
              "result_sha256"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "request_sha256": {
                "$ref": "#/$defs/sha"
              },
              "result_sha256": {
                "$ref": "#/$defs/sha"
              }
            }
          }
        }
      }
    },
    "report_receivings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "report_id",
          "name"
        ],
        "properties": {
          "report_id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "$ref": "#/$defs/slot"
          }
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "slot": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    }
  }
}
