{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original Tethys portal preparation and receiving",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation_id",
        "parent_operation_id",
        "source_capsule",
        "work_directory",
        "python_executable",
        "node_executable",
        "npm_executable",
        "playwright_directory",
        "chromium_executable",
        "port",
        "operator_username",
        "reader_username",
        "slot"
      ],
      "properties": {
        "schema": {
          "const": "groundwater.tethys-preparation-input.v1"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "parent_operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "source_capsule": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "work_directory": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "python_executable": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "node_executable": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "npm_executable": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "playwright_directory": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "chromium_executable": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "operator_username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "reader_username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "slot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation_id",
        "parent_operation_id",
        "source_capsule",
        "work_directory",
        "python_executable",
        "node_executable",
        "npm_executable",
        "playwright_directory",
        "chromium_executable",
        "port",
        "operator_username",
        "reader_username",
        "slot",
        "native_result",
        "backup"
      ],
      "properties": {
        "schema": {
          "const": "groundwater.tethys-native-input.v1"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "parent_operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "source_capsule": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "work_directory": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "python_executable": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "node_executable": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "npm_executable": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "playwright_directory": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "chromium_executable": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "operator_username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "reader_username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "slot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "native_result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/",
              "minLength": 2
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/",
              "minLength": 2
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  ]
}
