{
  "schema": "stellar-forge.paid-jobs.v1",
  "application": "./application.mjs",
  "publicOrigin": "https://lab-jobs.example",
  "serviceName": "Laboratory EDD Receiving",
  "environment": [
    "LAB_EDD_TEMP_ROOT",
    "LAB_EDD_PYTHON",
    "SF30_JOB_TEMP"
  ],
  "workerCount": 1,
  "maxPending": 8,
  "maxJobs": 1000,
  "memoryLimitMb": 768,
  "inputFileStorage": {
    "maxBytes": 536870912,
    "maxUploads": 128
  },
  "functions": {
    "laboratoryReview": {
      "path": "/laboratory-review",
      "description": "Review every original laboratory EDD row and qualifier, apply exact source-bound field decisions, compare reissued deliveries, and deliver native receiving files with a complete offline editor and original-source archive.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "equis-lab-3",
              "equis-lab-4",
              "geotech-dts8d"
            ]
          },
          "reviewName": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$",
            "minLength": 1,
            "maxLength": 96
          },
          "expectedSourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "encoding": {
            "type": "string",
            "enum": [
              "utf-8",
              "windows-1252"
            ]
          },
          "decisionFormat": {
            "type": "string",
            "enum": [
              "json",
              "csv",
              "tsv"
            ]
          },
          "tableScope": {
            "type": "string",
            "enum": [
              "issues",
              "all"
            ]
          },
          "tableFields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "maxItems": 512,
            "uniqueItems": true
          }
        },
        "required": [
          "profile",
          "reviewName"
        ],
        "additionalProperties": false
      },
      "example": {
        "profile": "equis-lab-4",
        "reviewName": "laboratory-delivery-01"
      },
      "inputFiles": {
        "slots": {
          "source": {
            "required": true,
            "description": "Complete original delivery ZIP containing the selected CSV family, or the original DTS workbook.",
            "mediaTypes": [
              "application/zip",
              "application/x-zip-compressed",
              "text/csv",
              "text/tab-separated-values",
              "text/plain",
              "application/vnd.ms-excel",
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
              "application/octet-stream"
            ],
            "maxBytes": 16777216
          },
          "baseline": {
            "required": false,
            "description": "Optional complete earlier delivery in the same selected source profile for duplicate-aware reissue comparison.",
            "mediaTypes": [
              "application/zip",
              "application/x-zip-compressed",
              "text/csv",
              "text/tab-separated-values",
              "text/plain",
              "application/vnd.ms-excel",
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
              "application/octet-stream"
            ],
            "maxBytes": 16777216
          },
          "decisions": {
            "required": false,
            "description": "Exact starforge.lab-edd-decisions.v1 JSON or full editable CSV/TSV table bound to this original source and profile.",
            "mediaTypes": [
              "application/json",
              "text/csv",
              "text/tab-separated-values",
              "text/plain"
            ],
            "maxBytes": 4194304
          }
        },
        "maxTotalBytes": 37748736
      },
      "payment": {
        "scheme": "exact",
        "network": "stellar:testnet",
        "asset": "UNVERIFIED_DEMO_ASSET",
        "payTo": "UNVERIFIED_DEMO_RECIPIENT",
        "amount": "10000",
        "maxTimeoutSeconds": 60
      },
      "timeoutMs": 600000,
      "maxInputBytes": 262144,
      "maxOutputBytes": 67108864,
      "output": {
        "format": "bytes",
        "contentType": "application/zip",
        "filename": "laboratory-edd-receiving.zip"
      }
    }
  },
  "intake": {
    "enabled": true,
    "functions": [
      "laboratoryReview"
    ]
  }
}
