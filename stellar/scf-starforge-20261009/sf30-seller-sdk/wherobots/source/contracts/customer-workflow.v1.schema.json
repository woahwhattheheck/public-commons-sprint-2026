{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed Wherobots customer workflow input",
  "description": "Input contract for the proposed integration. The original SDK/provider validates its native job fields; this document carries source, review and receiving context. Credential values are supplied separately by the selected private provider.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workflowId",
    "title",
    "projectOwner",
    "sourceCollections",
    "sourceFiles",
    "job",
    "outputs",
    "receiving",
    "operationAuthority"
  ],
  "properties": {
    "schema": {
      "const": "wherobots.customer-workflow.v1"
    },
    "workflowId": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "projectOwner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "sourceCollections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "sourceUrl",
          "edition",
          "querySourceId",
          "rights"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "stac",
              "registered-dataset",
              "s3-prefix"
            ]
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "edition": {
            "type": "string",
            "minLength": 1
          },
          "querySourceId": {
            "$ref": "#/$defs/id"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "rights": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string"
          }
        }
      }
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceFile"
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scriptSourceId",
        "sdkVersion",
        "region",
        "runtime",
        "timeoutSeconds",
        "args",
        "outputMode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 8,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_\\-.]+$"
        },
        "scriptSourceId": {
          "$ref": "#/$defs/id"
        },
        "sdkVersion": {
          "enum": [
            "0.4.0",
            "0.5.0"
          ]
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sparkConfigs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sourceType"
            ],
            "properties": {
              "sourceType": {
                "enum": [
                  "PYPI",
                  "FILE"
                ]
              },
              "libraryName": {
                "type": "string"
              },
              "libraryVersion": {
                "type": "string"
              },
              "sourceId": {
                "$ref": "#/$defs/id"
              },
              "s3Uri": {
                "type": "string",
                "pattern": "^s3://"
              }
            }
          }
        },
        "outputMode": {
          "enum": [
            "new-edition-prefix"
          ]
        },
        "existingOrchestrator": {
          "type": "string"
        },
        "credentialProfileRef": {
          "type": "string",
          "minLength": 1
        },
        "sdkClientChain": {
          "type": "string"
        },
        "awsAccountAlias": {
          "type": "string"
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "storage",
          "format",
          "maxObjects",
          "maxBytes"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "storage": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "integrationRef",
                  "s3Prefix",
                  "region"
                ],
                "properties": {
                  "kind": {
                    "const": "s3-integration"
                  },
                  "integrationRef": {
                    "type": "string",
                    "minLength": 1
                  },
                  "s3Prefix": {
                    "type": "string",
                    "pattern": "^s3://[^/]+/.+"
                  },
                  "region": {
                    "type": "string",
                    "minLength": 1
                  },
                  "access": {
                    "enum": [
                      "READ",
                      "READ_WRITE"
                    ]
                  },
                  "requesterPays": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "drive",
                  "path",
                  "region"
                ],
                "properties": {
                  "kind": {
                    "const": "files"
                  },
                  "drive": {
                    "const": "MY_FILES"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "region": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "format": {
            "enum": [
              "geoparquet",
              "geojson-sequence",
              "csv"
            ]
          },
          "primaryGeometry": {
            "type": [
              "string",
              "null"
            ]
          },
          "crs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "KNOWN",
                  "UNKNOWN",
                  "NOT_APPLICABLE"
                ]
              },
              "value": {
                "type": [
                  "object",
                  "string",
                  "null"
                ]
              },
              "axisOrder": {
                "type": "string"
              },
              "sourceRef": {
                "$ref": "#/$defs/id"
              }
            }
          },
          "maxObjects": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483648
          },
          "schemaSourceId": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "receiving": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "environment",
        "tool",
        "acceptanceOwner"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "acceptanceOwner": {
          "type": "string",
          "minLength": 1
        },
        "expectedComparison": {
          "type": "string"
        }
      }
    },
    "operationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "cloudRuntimePlan",
        "costOwner",
        "allowedSourceUse"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "cloudRuntimePlan": {
          "type": "string",
          "minLength": 1
        },
        "costOwner": {
          "type": "string",
          "minLength": 1
        },
        "allowedSourceUse": {
          "type": "string",
          "minLength": 1
        },
        "existingDeploymentRef": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "filename",
        "sha256",
        "bytes",
        "role"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "SCRIPT",
            "QUERY",
            "SOURCE_METADATA",
            "SOURCE_DATA",
            "DEPENDENCY",
            "OUTPUT_SCHEMA",
            "LICENSE",
            "REFERENCE"
          ]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "providerVersionId": {
          "type": "string"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
