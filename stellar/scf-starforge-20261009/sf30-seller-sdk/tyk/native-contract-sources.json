  "nativeContracts": {
    "gatewayInventory": {
      "method": "GET",
      "path": "/tyk/apis",
      "query": {
        "include_types": "mcp"
      },
      "returns": "APIDefinition[]; original active memory"
    },
    "dashboardInventory": {
      "method": "GET",
      "path": "/api/apis",
      "query": {
        "p": "all positive pages",
        "sort": "name"
      },
      "returns": "{apis:ApiDefinitionWrapper[],pages:number}"
    },
    "classicGateway": {
      "document": "APIDefinition",
      "create": "POST /tyk/apis",
      "update": "PUT /tyk/apis/{apiId}",
      "read": "GET /tyk/apis/{apiId}"
    },
    "classicDashboard": {
      "document": "ApiDefinitionWrapper",
      "create": "POST /api/apis",
      "update": "PUT /api/apis/{apiId}",
      "read": "GET /api/apis/{apiId}"
    },
    "oasGateway": {
      "create": "POST /tyk/apis/oas",
      "import": "POST /tyk/apis/oas/import",
      "update": "PUT /tyk/apis/oas/{apiId}",
      "read": "GET /tyk/apis/oas/{apiId}",
      "contentTypes": [
        "application/json"
      ]
    },
    "oasDashboard": {
      "create": "POST /api/apis/oas",
      "import": "POST /api/apis/oas/import",
      "update": "PUT /api/apis/oas/{apiId}",
      "read": "GET /api/apis/oas/{apiId}",
      "contentTypes": [
        "application/json",
        "application/x-yaml"
      ]
    },
    "migration": {
      "method": "POST",
      "path": "/api/apis/migrate",
      "requestFields": [
        "mode",
        "apiIDs",
        "abortOnFailure",
        "overrideStaged"
      ],
      "modes": [
        "dryRun",
        "stage",
        "promote",
        "direct"
      ],
      "responseFields": [
        "success.count",
        "success.apiIDs",
        "success.stagedAPIs",
        "success.definitions",
        "failure.count",
        "failure.errors",
        "skipped.count",
        "skipped.apis",
        "abortedOnFailure"
      ]
    },
    "reload": {
      "node": "GET /tyk/reload",
      "nodeQuery": [
        "block"
      ],
      "group": "GET /tyk/reload/group"
    },
    "responseIdentity": {
      "gateway": "key; status=ok; action=added|modified",
      "dashboard": "ID is public API ID; Meta may be database identity"
    },
    "versionQuery": [
      "base_api_id",
      "base_api_version_name",
      "new_version_name",
      "set_default"
    ],
    "oasImportQuery": [
      "upstreamURL",
      "listenPath",
      "customDomain",
      "allowList",
      "validateRequest",
      "mockResponse",
      "authentication"
    ],
    "dashboardTemplateQuery": "templateID"
  },
  "retrievedOn": "2026-10-12",
  "runtimeAuthority": {
    "gateway": "Original deployed Gateway and Redis; selected native API endpoints and explicit reload",
    "dashboard": "Original licensed Dashboard and its managed Gateway; native migration endpoint",
    "credentialStorage": "Existing named environment references; no credential bytes in source capture, plans or exported connection declarations",
    "readbackConfirmation": "Complete submitted native-definition correspondence; original acknowledgement and observed current configuration are retained separately."
  }
