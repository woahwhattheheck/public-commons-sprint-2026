{
  "schema": "stellar-forge.postgres-source.v1",
  "connectionStringEnv": "SF30_DATABASE_URL",
  "tls": "disable",
  "allowLocalDatabase": true,
  "maxConnections": 4,
  "maxPending": 32,
  "queries": {
    "catalog": {
      "sql": "SELECT id, region, label, price FROM sf30_example.catalog WHERE region = $1::text AND id > $2::bigint ORDER BY id",
      "parameters": [
        { "name": "region", "type": "string", "minLength": 1, "maxLength": 32, "enum": ["north", "south"] },
        { "name": "after_id", "type": "integer", "minimum": "0", "default": "0" }
      ],
      "columns": ["id", "region", "label", "price"],
      "maxRows": 100,
      "maxBytes": 524288,
      "timeoutMs": 3000
    }
  }
}
