{
  "schema": "stellar-forge.postgres-source.v1",
  "connectionEnv": "SF30_POSTGRES_URL",
  "tls": "verify-full",
  "maxConnections": 4,
  "maxPending": 32,
  "connectTimeoutMs": 5000,
  "lockTimeoutMs": 500,
  "queries": {
    "catalog": {
      "sql": "SELECT id, title, region, price_cents, updated_at FROM sf30_demo.products WHERE region = $1::text AND id > $2::bigint ORDER BY id",
      "parameterOrder": ["region", "after_id"],
      "parameters": {
        "region": { "type": "string", "minLength": 1, "maxLength": 64 },
        "after_id": { "type": "integer", "minimum": "0", "default": "0" }
      },
      "columns": ["id", "title", "region", "price_cents", "updated_at"],
      "maxRows": 100,
      "maxBytes": 524288,
      "timeoutMs": 1500
    }
  },
  "bindings": { "catalog": { "query": "catalog", "input": "query" } }
}
