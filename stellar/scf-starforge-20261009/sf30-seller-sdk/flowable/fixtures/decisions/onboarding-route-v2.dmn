<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/DMN/20151101" id="d76c_onboarding_route_definitions_v2" name="Onboarding review routing v2" namespace="https://tokenjunkielabs.com/flowable/decisions">
  <decision id="d76c_onboarding_route" name="Onboarding review routing">
    <decisionTable id="d76c_onboarding_route_table_v2" hitPolicy="FIRST">
      <input id="d76c_onboarding_route_input_0" label="workerType"><inputExpression id="d76c_onboarding_route_expression_0" typeRef="string"><text>workerType</text></inputExpression></input>
      <input id="d76c_onboarding_route_input_1" label="remote"><inputExpression id="d76c_onboarding_route_expression_1" typeRef="boolean"><text>remote</text></inputExpression></input>
      <output id="d76c_onboarding_route_output" name="reviewRoute" typeRef="string" label="Operator review route"/>
      <rule id="d76c_onboarding_route_v2_rule_0">
        <inputEntry id="d76c_onboarding_route_v2_entry_0_0"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="d76c_onboarding_route_v2_entry_0_1"><text><![CDATA[== true]]></text></inputEntry>
        <outputEntry id="d76c_onboarding_route_v2_result_0"><text><![CDATA["remote-onboarding"]]></text></outputEntry>
      </rule>
      <rule id="d76c_onboarding_route_v2_rule_1">
        <inputEntry id="d76c_onboarding_route_v2_entry_1_0"><text><![CDATA[== "contractor"]]></text></inputEntry>
        <inputEntry id="d76c_onboarding_route_v2_entry_1_1"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="d76c_onboarding_route_v2_result_1"><text><![CDATA["contractor-onboarding"]]></text></outputEntry>
      </rule>
      <rule id="d76c_onboarding_route_v2_rule_2">
        <inputEntry id="d76c_onboarding_route_v2_entry_2_0"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="d76c_onboarding_route_v2_entry_2_1"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="d76c_onboarding_route_v2_result_2"><text><![CDATA["standard-onboarding"]]></text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
