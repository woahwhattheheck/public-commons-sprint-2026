<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/DMN/20151101" id="d76c_grant_eligibility_definitions_v1" name="Grant intake review routing v1" namespace="https://tokenjunkielabs.com/flowable/decisions">
  <decision id="d76c_grant_eligibility" name="Grant intake review routing">
    <decisionTable id="d76c_grant_eligibility_table_v1" hitPolicy="FIRST">
      <input id="d76c_grant_eligibility_input_0" label="requestedAmount"><inputExpression id="d76c_grant_eligibility_expression_0" typeRef="number"><text>requestedAmount</text></inputExpression></input>
      <input id="d76c_grant_eligibility_input_1" label="recordNumber"><inputExpression id="d76c_grant_eligibility_expression_1" typeRef="number"><text>recordNumber</text></inputExpression></input>
      <output id="d76c_grant_eligibility_output" name="reviewRoute" typeRef="string" label="Operator review route"/>
      <rule id="d76c_grant_eligibility_v1_rule_0">
        <inputEntry id="d76c_grant_eligibility_v1_entry_0_0"><text><![CDATA[<= 10000]]></text></inputEntry>
        <inputEntry id="d76c_grant_eligibility_v1_entry_0_1"><text><![CDATA[> 0]]></text></inputEntry>
        <outputEntry id="d76c_grant_eligibility_v1_result_0"><text><![CDATA["standard-review"]]></text></outputEntry>
      </rule>
      <rule id="d76c_grant_eligibility_v1_rule_1">
        <inputEntry id="d76c_grant_eligibility_v1_entry_1_0"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="d76c_grant_eligibility_v1_entry_1_1"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="d76c_grant_eligibility_v1_result_1"><text><![CDATA["specialist-review"]]></text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
