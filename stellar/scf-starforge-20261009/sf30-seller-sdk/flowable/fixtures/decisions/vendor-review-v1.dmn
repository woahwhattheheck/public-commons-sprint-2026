<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/DMN/20151101" id="d76c_vendor_review_definitions_v1" name="Vendor review assignment v1" namespace="https://tokenjunkielabs.com/flowable/decisions">
  <decision id="d76c_vendor_review" name="Vendor review assignment">
    <decisionTable id="d76c_vendor_review_table_v1" hitPolicy="FIRST">
      <input id="d76c_vendor_review_input_0" label="screeningScore"><inputExpression id="d76c_vendor_review_expression_0" typeRef="number"><text>screeningScore</text></inputExpression></input>
      <output id="d76c_vendor_review_output" name="reviewRoute" typeRef="string" label="Operator review route"/>
      <rule id="d76c_vendor_review_v1_rule_0">
        <inputEntry id="d76c_vendor_review_v1_entry_0_0"><text><![CDATA[>= 70]]></text></inputEntry>
        <outputEntry id="d76c_vendor_review_v1_result_0"><text><![CDATA["routine-review"]]></text></outputEntry>
      </rule>
      <rule id="d76c_vendor_review_v1_rule_1">
        <inputEntry id="d76c_vendor_review_v1_entry_1_0"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="d76c_vendor_review_v1_result_1"><text><![CDATA["enhanced-review"]]></text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
