<?xml version="1.0" encoding="UTF-8"?>
<!-- MIT. Editable customer case source; Flowable 8.0.0 / CMMN 1.1. -->
<definitions xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/cmmn"
  xmlns:cmmndi="http://www.omg.org/spec/CMMN/20151109/CMMNDI" xmlns:dc="http://www.omg.org/spec/CMMN/20151109/DC"
  xmlns:di="http://www.omg.org/spec/CMMN/20151109/DI" targetNamespace="https://tokenjunkielabs.com/flowable/cases">
  <case id="tjlGrantDueDiligence" name="Grant due diligence" flowable:initiatorVariableName="initiator">
    <documentation>Review the applicant evidence, independently confirm the source record, resolve a funding exception when required and authorize the receiving handover. Edition 2 adds the conditional exception review before final handover.</documentation>
    <casePlanModel id="casePlanModel" name="Grant due diligence" autoComplete="true">
      <planItem id="evidenceReviewItem" name="Review grant evidence" definitionRef="evidenceReview">
        <itemControl><manualActivationRule/><requiredRule/></itemControl>
      </planItem>
      <planItem id="sourceConfirmationItem" name="Confirm independent grant sources" definitionRef="sourceConfirmation">
        <itemControl><requiredRule/></itemControl>
        <entryCriterion id="sourceConfirmationEntry" sentryRef="evidenceReviewed"/>
      </planItem>
      <planItem id="evidenceMilestoneItem" name="Grant evidence confirmed" definitionRef="evidenceMilestone">
        <itemControl><requiredRule/></itemControl>
        <entryCriterion id="evidenceMilestoneEntry" sentryRef="sourceConfirmed"/>
      </planItem>
      <planItem id="exceptionReviewItem" name="Review grant funding exception" definitionRef="exceptionReview">
        <itemControl><manualActivationRule/><requiredRule><condition><![CDATA[${exceptionRequired}]]></condition></requiredRule></itemControl>
        <entryCriterion id="exceptionReviewEntry" sentryRef="exceptionRequiredAfterConfirmation"/>
      </planItem>
      <planItem id="finalApprovalItem" name="Approve grant diligence handover" definitionRef="finalApproval">
        <itemControl><requiredRule/></itemControl>
        <entryCriterion id="finalApprovalEntry" sentryRef="noExceptionAfterConfirmation"/>
        <entryCriterion id="finalApprovalAfterException" sentryRef="exceptionReviewed"/>
      </planItem>
      <planItem id="readyMilestoneItem" name="Grant diligence ready" definitionRef="readyMilestone">
        <itemControl><requiredRule/></itemControl>
        <entryCriterion id="readyMilestoneEntry" sentryRef="handoverApproved"/>
      </planItem>
      <sentry id="evidenceReviewed">
        <planItemOnPart id="evidenceReviewedOn" sourceRef="evidenceReviewItem"><standardEvent>complete</standardEvent></planItemOnPart>
      </sentry>
      <sentry id="sourceConfirmed">
        <planItemOnPart id="sourceConfirmedOn" sourceRef="sourceConfirmationItem"><standardEvent>complete</standardEvent></planItemOnPart>
      </sentry>
      <sentry id="evidenceMilestoneOccurred">
        <planItemOnPart id="evidenceMilestoneOccurredOn" sourceRef="evidenceMilestoneItem"><standardEvent>occur</standardEvent></planItemOnPart>
      </sentry>
      <sentry id="exceptionRequiredAfterConfirmation">
        <planItemOnPart id="exceptionRequiredOn" sourceRef="evidenceMilestoneItem"><standardEvent>occur</standardEvent></planItemOnPart>
        <ifPart><condition><![CDATA[${exceptionRequired}]]></condition></ifPart>
      </sentry>
      <sentry id="noExceptionAfterConfirmation">
        <planItemOnPart id="noExceptionOn" sourceRef="evidenceMilestoneItem"><standardEvent>occur</standardEvent></planItemOnPart>
        <ifPart><condition><![CDATA[${!exceptionRequired}]]></condition></ifPart>
      </sentry>
      <sentry id="exceptionReviewed">
        <planItemOnPart id="exceptionReviewedOn" sourceRef="exceptionReviewItem"><standardEvent>complete</standardEvent></planItemOnPart>
      </sentry>
      <sentry id="handoverApproved">
        <planItemOnPart id="handoverApprovedOn" sourceRef="finalApprovalItem"><standardEvent>complete</standardEvent></planItemOnPart>
      </sentry>
      <humanTask id="evidenceReview" name="Review grant evidence"/>
      <task id="sourceConfirmation" name="Confirm independent grant sources" isBlocking="true"/>
      <milestone id="evidenceMilestone" name="Grant evidence confirmed"/>
      <humanTask id="exceptionReview" name="Review grant funding exception"/>
      <humanTask id="finalApproval" name="Approve grant diligence handover"/>
      <milestone id="readyMilestone" name="Grant diligence ready"/>
    </casePlanModel>
  </case>
  <cmmndi:CMMNDI>
    <cmmndi:CMMNDiagram id="diagram_tjlGrantDueDiligence_v2">
      <cmmndi:CMMNShape id="shape_casePlanModel" cmmnElementRef="casePlanModel"><dc:Bounds x="20" y="20" width="860" height="470"/></cmmndi:CMMNShape>
      <cmmndi:CMMNShape id="shape_evidenceReviewItem" cmmnElementRef="evidenceReviewItem"><dc:Bounds x="60" y="90" width="180" height="90"/></cmmndi:CMMNShape>
      <cmmndi:CMMNShape id="shape_sourceConfirmationItem" cmmnElementRef="sourceConfirmationItem"><dc:Bounds x="335" y="90" width="190" height="90"/></cmmndi:CMMNShape>
      <cmmndi:CMMNShape id="shape_evidenceMilestoneItem" cmmnElementRef="evidenceMilestoneItem"><dc:Bounds x="630" y="105" width="185" height="60"/></cmmndi:CMMNShape>
      <cmmndi:CMMNShape id="shape_exceptionReviewItem" cmmnElementRef="exceptionReviewItem"><dc:Bounds x="630" y="290" width="185" height="90"/></cmmndi:CMMNShape>
      <cmmndi:CMMNShape id="shape_finalApprovalItem" cmmnElementRef="finalApprovalItem"><dc:Bounds x="335" y="290" width="190" height="90"/></cmmndi:CMMNShape>
      <cmmndi:CMMNShape id="shape_readyMilestoneItem" cmmnElementRef="readyMilestoneItem"><dc:Bounds x="60" y="305" width="185" height="60"/></cmmndi:CMMNShape>
    </cmmndi:CMMNDiagram>
  </cmmndi:CMMNDI>
</definitions>
