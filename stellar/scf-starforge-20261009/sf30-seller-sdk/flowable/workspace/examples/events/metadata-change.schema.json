{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tjlabs:schema:metadata-change:1",
  "title": "Authored metadata-change integration example",
  "description": "Supplier-authored representative data payload; no Novatria proprietary API or payload is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assetId",
    "sourceRevision",
    "changeType",
    "classification",
    "exceptionRequired",
    "sourceUri"
  ],
  "properties": {
    "assetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]{0,18})$",
      "description": "Exact signed-64 range additionally checked by original typed mapper"
    },
    "changeType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "classification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "exceptionRequired": {
      "type": "boolean"
    },
    "sourceUri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  }
}
