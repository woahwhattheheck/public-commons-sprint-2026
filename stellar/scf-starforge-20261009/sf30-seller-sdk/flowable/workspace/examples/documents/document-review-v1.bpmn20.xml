<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="urn:stellar-forge:document-review">
  <process id="sf_document_review" name="Authored document review — edition 1" isExecutable="true">
    <documentation>Editable implementation example. Customer policy, task identities and approval conditions must be selected and reviewed for the actual engagement.</documentation>
    <startEvent id="start"/>
    <sequenceFlow id="toDocumentReview" sourceRef="start" targetRef="documentReview"/>
    <userTask id="documentReview" name="Review selected document version" flowable:assignee="${reviewer}"/>
    <sequenceFlow id="afterDocumentReview" sourceRef="documentReview" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
