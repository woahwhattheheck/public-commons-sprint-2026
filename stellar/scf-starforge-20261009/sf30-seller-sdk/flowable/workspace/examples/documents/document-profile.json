{
  "schema": "stellar-forge.alfresco-process-profile.v1",
  "namespace": "document-review-reference",
  "repositoryId": "authored-reference",
  "repositoryBaseUrl": "https://alfresco.example.invalid/alfresco/api/-default-/public/alfresco/versions/1",
  "mapping": {
    "schema": "commons.process-interface-mapping.v1",
    "id": "document-review",
    "sourceSystem": "Alfresco selected file version",
    "sourceVersion": "REST v1",
    "fields": [
      {
        "external": "title",
        "native": "documentTitle",
        "type": "string",
        "required": true,
        "meaning": "Title retained on the selected historical version."
      },
      {
        "external": "reviewer",
        "native": "reviewer",
        "type": "string",
        "required": true,
        "meaning": "Operator-selected native task identity; example only."
      },
      {
        "external": "amount",
        "native": "reviewAmount",
        "type": "double",
        "required": true,
        "meaning": "Exact decimal-text source amount, mapped within the original bounded native double contract."
      },
      {
        "external": "sequence",
        "native": "sourceSequence",
        "type": "long",
        "required": true,
        "meaning": "Exact signed-64 source sequence retained as decimal text before native serialization."
      }
    ]
  },
  "bindings": {
    "title": "/version/properties/cm:title",
    "reviewer": "/version/properties/example:reviewer",
    "amount": "/version/properties/example:amount",
    "sequence": "/version/properties/example:sequence"
  }
}
