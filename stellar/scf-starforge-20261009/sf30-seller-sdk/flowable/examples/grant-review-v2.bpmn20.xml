<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:flowable="http://flowable.org/bpmn" targetNamespace="https://tjlabs.dev/flowable/process-operations">
  <process id="sf_grant_review" name="Grant review v2" isExecutable="true">
    <startEvent id="start" name="Case received"/>
    <sequenceFlow id="start_to_intake" sourceRef="start" targetRef="intake"/>
    <userTask id="intake" name="Application intake"/>
    <sequenceFlow id="intake_to_review" sourceRef="intake" targetRef="review"/>
    <userTask id="review" name="Eligibility review"/>
    <sequenceFlow id="review_to_finalize" sourceRef="review" targetRef="finalize"/>
    <userTask id="finalize" name="Award setup"/>
    <sequenceFlow id="finalize_to_end" sourceRef="finalize" targetRef="end"/>
    <endEvent id="end" name="Case complete"/>
  </process>
</definitions>
