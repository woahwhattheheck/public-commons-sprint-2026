    "methods": {
      "describe": "Current public application/network/service/custody references and observed catalogue metadata.",
      "catalog": "All documented native actions plus original observed tool schemas once discovered.",
      "prepare": "Validate the complete original arguments and freeze the selected request before dispatch.",
      "perform": "Send the exact prepared request once and retain its original provider exchange and operation outcome.",
      "reconcile": "Recover an already retained exact-request result, resume its original provider stream, or read original target state.",
      "verifySession": "One ephemeral original SDK access token is sent to the original server verification endpoint.",
      "close": "Release host connections and private session state."
    },
    "request": {
      "schema": "stellar-forge.pollar-partner.native-request.v1",
      "id": "Independent original native request UUID",
      "identity": "SHA256 of canonical complete public request, selected connection, source schema and exact argument body.",
      "privateValues": "Transport inserts private server key or personal-access token from its selected custody reference."
    },
    "response": {
      "retained": "Original permitted provider bytes in bodyBase64 with byte length, body hash, HTTP status and permitted headers.",
      "streams": "Original JSON-RPC/SSE events, priming event cursors and complete matching responses are retained. A completed matching response remains authoritative after a later transport close error; GET recovery preserves its actual empty transport body.",
      "aggregates": "A tools catalogue or reconciliation assembled from original exchanges has status:null and explicitly identifies its original component pages/exchanges.",
      "oneTimeKeys": "create_api_key returns the complete original key response only in ephemeral. Durable records retain a redacted response plus the original body hash and byte length; any echoed transport credential or ephemeral verification token is redacted from durable provider bytes.",
      "precision": "Original response bytes are retained before projection. Invalid UTF-8 and unsafe integer numeric tokens are recorded without rounding; exact monetary strings remain unchanged."
    },
