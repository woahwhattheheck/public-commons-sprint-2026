  "original_source_discrepancies": [
    "Hosted OpenAPI loadtree query vs current reference",
    "Hosted OpenAPI listseries name vs current reference",
    "Hosted OpenAPI omits loadmeta and revision methods",
    "Hosted OpenAPI dictionary definitions are arrays although current controller uses dictionaries",
    "Hosted OpenAPI removeseries POST vs current GET n",
    "README .NET8 vs current csproj net9.0",
    "Prose contains loadvintagedates/completehistory shorthand; actual route names are loadvintagetimestamps/loadcompletehistory"
  ],
  "implementation_decisions": {
    "source_values": "retain exact original strings and source states; review consumer numeric/calendar representation",
