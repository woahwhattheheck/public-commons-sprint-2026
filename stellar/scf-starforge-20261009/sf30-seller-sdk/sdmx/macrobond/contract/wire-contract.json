  "methods": [
    {
      "method": "GET",
      "path": "/getcapabilities",
      "required": true,
      "query": [],
      "response": {
        "browse": "boolean",
        "search": "boolean",
        "editSeries": "boolean",
        "allowMultipleSeriesPerRequest": "boolean",
        "meta": "boolean",
        "revisions": "boolean",
        "revisionsRelease": "boolean",
        "revisionsCompleteHistory": "boolean"
      }
    },
    {
      "method": "GET",
      "path": "/loadseries",
      "required": true,
      "query": [
        {
          "name": "n",
          "required": true,
          "repeated": true,
          "type": "string"
        }
      ],
      "response": "ordered array of {data:{values,dates?,metaData}} or {error:string}"
    },
    {
      "method": "GET",
      "path": "/loadmeta",
      "capability": "meta",
      "query": [
        {
          "name": "n",
          "required": true,
          "repeated": true,
          "type": "string"
        }
      ],
      "response": "ordered array of {data:{metaData}} or {error:string}"
    },
    {
      "method": "GET",
      "path": "/searchseries",
      "capability": "search",
      "query": [
        {
          "name": "query",
          "required": true,
          "type": "string"
        }
      ],
      "response": "array of PascalCase metadata dictionaries with PrimName and Description"
    },
    {
      "method": "GET",
      "path": "/loadtree",
      "capability": "browse",
      "query": [
        {
          "name": "reference",
          "required": false,
          "type": "string"
        }
      ],
      "response": "array of nodes with Description and one of Children/ChildrenReference/SeriesReference"
    },
    {
      "method": "GET",
      "path": "/listseries",
      "capability": "browse",
      "query": [
        {
          "name": "reference",
          "required": true,
          "type": "string"
        }
      ],
      "response": "{aspects?:[{name,description?}],groups:[{name?,series:[{description?,indentation?,emphasized?,spaceAbove?,entityMeta:[metadata],names:[string]}]}]}"
    },
    {
      "method": "GET",
      "path": "/loadvintage",
      "capability": "revisions",
      "query": [
        {
          "name": "n",
          "required": true,
          "type": "string"
        },
        {
          "name": "timestamp",
          "required": true,
          "type": "ISO8601 instant"
        }
      ],
      "response": "series data object with RevisionSeriesType=vintage and applicable RevisionTimeStamp"
    },
    {
      "method": "GET",
      "path": "/loadvintagetimestamps",
      "capability": "revisions",
      "query": [
        {
          "name": "n",
          "required": true,
          "type": "string"
        }
      ],
      "response": "[{timeStamp:ISO8601,label?:string}]"
    },
    {
      "method": "GET",
      "path": "/loadcompletehistory",
      "capability": "revisionsCompleteHistory+revisions",
      "query": [
        {
          "name": "n",
          "required": true,
          "type": "string"
        }
      ],
      "response": "array of complete vintage series objects"
    },
    {
      "method": "GET",
      "path": "/loadrelease",
      "capability": "revisionsRelease+revisions",
      "query": [
        {
          "name": "n",
          "required": true,
          "type": "string"
        },
        {
          "name": "nthrelease",
          "required": true,
          "type": "integer>=0"
        }
      ],
      "response": "series data with RevisionSeriesType=nth and RevisionSeriesNth",
      "source": "official prose; absent from current sample controller"
    },
    {
      "method": "POST",
      "path": "/createseries",
      "capability": "editSeries",
      "query": [
        {
          "name": "lastModified",
          "required": false,
          "type": "ISO8601 instant"
        },
        {
          "name": "forceReplace",
          "required": false,
          "type": "boolean"
        }
      ],
      "body": "series data object",
      "response": "new modification timestamp; 404/409 have original existence/revision semantics"
    },
    {
      "method": "GET",
      "path": "/removeseries",
      "capability": "editSeries",
      "query": [
        {
          "name": "n",
          "required": true,
          "type": "string"
        }
      ],
      "response": "200 or404",
      "source": "current sample controller and official prose; hosted OpenAPI saysPOST/body name"
    }
  ],
