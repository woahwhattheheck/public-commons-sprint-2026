{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original managed Report Desk receiving",
  "type": "object",
  "required": [
    "schema",
    "operationId",
    "actor",
    "runtimeWorkspaceDirectory",
    "runtimeDirectory",
    "expectedSourceCommit",
    "deskDirectory",
    "expectedDeskId",
    "python",
    "outputDirectory",
    "originalOperationIds"
  ],
  "properties": {
    "schema": {
      "const": "stellar-forge.groundwater-report-managed-receiving.v1"
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "runtimeWorkspaceDirectory": {
      "type": "string"
    },
    "runtimeDirectory": {
      "type": "string"
    },
    "expectedSourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "deskDirectory": {
      "type": "string"
    },
    "expectedDeskId": {
      "type": "string",
      "format": "uuid"
    },
    "python": {
      "type": "string"
    },
    "outputDirectory": {
      "type": "string"
    },
    "originalOperationIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 200,
      "items": {
        "type": "string"
      }
    },
    "expectedLaunchSourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scientificWorkspace": {
      "type": "string"
    },
    "operationsUrlFile": {
      "type": "string"
    },
    "facilitator": {
      "type": "string"
    },
    "allowLocalFacilitator": {
      "type": "boolean"
    },
    "environmentFile": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "label": {
      "type": "string",
      "maxLength": 100
    },
    "waitMilliseconds": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 600000
    },
    "browser": {
      "type": "object",
      "required": [
        "package",
        "executable"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "executable": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
