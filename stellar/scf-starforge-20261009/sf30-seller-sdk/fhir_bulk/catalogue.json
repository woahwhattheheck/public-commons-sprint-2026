{
  "schema": "stellar-forge.fhir-bulk-catalogue.v1",
  "title": "FHIR Bulk Data workbench",
  "protocols": [
    {
      "value": "stu2",
      "label": "HL7 Bulk Data STU2 / FHIR R4",
      "source": "https://hl7.org/fhir/uv/bulkdata/STU2/export.html"
    },
    {
      "value": "stu3",
      "label": "HL7 Bulk Data STU3 / FHIR R4",
      "source": "https://hl7.org/fhir/uv/bulkdata/STU3/en/export.html"
    }
  ],
  "scopes": [
    {
      "value": "system",
      "label": "System export"
    },
    {
      "value": "patient",
      "label": "All patients"
    },
    {
      "value": "group",
      "label": "Selected native Group"
    }
  ],
  "methods": [
    "GET",
    "POST"
  ],
  "sourceOrigins": [
    {
      "value": "published_sample",
      "label": "Publisher's sample data"
    },
    {
      "value": "operator_source",
      "label": "Operator-selected source"
    }
  ],
  "connectionDefaults": {
    "protocol": "stu3",
    "authProfile": null,
    "origin": "operator_source",
    "publisher": "",
    "sourceUrl": "",
    "note": ""
  },
  "parameterDefaults": {
    "types": [],
    "since": null,
    "until": null,
    "elements": [],
    "typeFilters": [],
    "includeAssociatedData": [],
    "patients": [],
    "organizeOutputBy": null,
    "allowPartialManifests": false,
    "separateExportStatus": false,
    "handling": "strict"
  },
  "parameters": [
    {
      "name": "types",
      "label": "Resource types",
      "type": "string_list",
      "description": "Explicit exported types; an empty list requests the selected endpoint's full authorized scope."
    },
    {
      "name": "since",
      "label": "Modified after",
      "type": "instant",
      "description": "FHIR modification instant with timezone."
    },
    {
      "name": "until",
      "label": "Modified before",
      "type": "instant",
      "protocols": [
        "stu3"
      ]
    },
    {
      "name": "elements",
      "label": "Selected root elements",
      "type": "string_list"
    },
    {
      "name": "typeFilters",
      "label": "Native type filters",
      "type": "string_list",
      "description": "Complete ResourceType?query values. Repeated filters of one type use native OR semantics."
    },
    {
      "name": "includeAssociatedData",
      "label": "Associated data values",
      "type": "string_list"
    },
    {
      "name": "patients",
      "label": "Explicit Patient references",
      "type": "string_list",
      "methods": [
        "POST"
      ]
    },
    {
      "name": "organizeOutputBy",
      "label": "Organize output by resource",
      "type": "resource_type",
      "protocols": [
        "stu3"
      ]
    },
    {
      "name": "allowPartialManifests",
      "label": "Receive partial manifests",
      "type": "boolean",
      "protocols": [
        "stu3"
      ]
    },
    {
      "name": "separateExportStatus",
      "label": "Separate HTTP and export status",
      "type": "boolean",
      "protocols": [
        "stu3"
      ]
    },
    {
      "name": "handling",
      "label": "Parameter handling",
      "type": "enum",
      "choices": [
        "strict",
        "lenient"
      ]
    }
  ],
  "limits": {
    "maxBytes": 268435456,
    "maxFiles": 4096,
    "maxLineBytes": 16777216,
    "maxResourceRecords": 1000000,
    "maxColumns": 64,
    "maxFieldPaths": 8192,
    "maxSourcePacketBytes": 268435456
  },
  "projection": {
    "schema": "stellar-forge.fhir-bulk-mapping.v1",
    "sources": [
      "resource",
      "record"
    ],
    "types": [
      "string",
      "integer",
      "number",
      "boolean"
    ],
    "modes": [
      "single",
      "first",
      "last",
      "array",
      "join"
    ],
    "encodings": [
      "plain",
      "json"
    ],
    "missing": [
      "error",
      "empty",
      "default"
    ],
    "recordFields": [
      "resourceType",
      "id",
      "versionId",
      "lastUpdated",
      "fileId",
      "line",
      "recordId",
      "sourceId"
    ],
    "defaults": {
      "defaultLimit": 50,
      "maxLimit": 250,
      "maxBytes": 67108864,
      "maxRows": 250000,
      "maxCellChars": 65536,
      "allowEmpty": false
    },
    "pathSyntax": "Exact object-key tokens, explicit array indices and * for each array item."
  },
  "operationStates": [
    "prepared",
    "kickoff_unknown",
    "exporting",
    "waiting",
    "receiving",
    "complete",
    "failed",
    "cancelled",
    "cancel_unknown"
  ],
  "terminalStates": [
    "complete",
    "failed",
    "cancelled"
  ],
  "sourceKinds": [
    "output",
    "error",
    "deleted"
  ],
  "examples": [
    {
      "id": "smart-public-source",
      "label": "SMART public sample server",
      "connection": {
        "label": "SMART public sample FHIR",
        "baseUrl": "https://bulk-data.smarthealthit.org/fhir",
        "protocol": "stu3",
        "authProfile": null,
        "origin": "published_sample",
        "publisher": "SMART Health IT / Boston Children's Hospital",
        "sourceUrl": "https://docs.smarthealthit.org/cumulus/fetch/exporting.html",
        "note": "Original public SMART server. Retain the publisher's sample-data classification."
      }
    }
  ],
  "originalRuntime": {
    "sourceFormat": "../xml/workspace.py",
    "nativeEngine": "../xml/native.mjs",
    "seller": "../dataset-cli.mjs"
  },
  "apiVersion": 1,
  "recoveryActions": [
    {
      "name": "adopt-status",
      "label": "Receive original status URL",
      "fields": [
        {
          "name": "statusUrl",
          "type": "url",
          "required": true
        },
        {
          "name": "reason",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "receive-capture",
      "label": "Receive complete retained capture",
      "fields": [
        {
          "name": "sourceId",
          "type": "source_reference",
          "required": true
        },
        {
          "name": "reason",
          "type": "text",
          "required": true
        }
      ],
      "description": "Validate a saved complete original capture against its accepted operation, then retain the original source and finish that same operation."
    }
  ]
}
