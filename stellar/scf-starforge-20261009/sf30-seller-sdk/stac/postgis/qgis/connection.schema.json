{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Installed QGIS PostGIS connection references",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "service",
    "role"
  ],
  "properties": {
    "schema": {
      "const": "starforge.postgis-qgis-connection.v1"
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "service": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,160}$"
    },
    "authConfigId": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9]{7}$",
      "default": ""
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63
    },
    "sslMode": {
      "enum": [
        "verify-full",
        "verify-ca",
        "require",
        "prefer",
        "allow",
        "disable"
      ],
      "default": "verify-full"
    },
    "allowEditing": {
      "type": "boolean",
      "default": false
    }
  },
  "description": "Select an existing local libpq service and optional local QGIS authentication ID. The service supplies the actual database and role; these must match the accepted receipt. Credentials and authentication database files are never included."
}
