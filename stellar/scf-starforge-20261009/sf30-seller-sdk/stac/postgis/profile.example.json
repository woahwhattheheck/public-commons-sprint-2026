          "nullable": false,
          "codec": "native"
        },
        {
          "sourceName": "district",
          "name": "district",
          "type": "text",
          "nullable": false,
          "codec": "native"
        },
        {
          "sourceName": "assessed_value",
          "name": "assessed_value",
          "type": "numeric",
          "nullable": true,
          "codec": "native"
        }
      ],
      "geometry": {
        "sourceSrid": 4326,
        "targetSrid": 4326,
        "type": "MULTIPOLYGON",
