{
  "schema": "starforge.postgis-intake-profile.v1",
  "projectId": "demonstration-intake",
  "database": {
    "profileId": "selected-postgis-service",
    "name": "selected_database",
    "schema": "selected_schema",
    "primaryKeyMetadata": null
