          "name": "existing_qgis_editor",
          "permissions": [
            "select",
            "insert",
            "update",
            "delete"
          ],
          "scope": {
            "column": "district",
            "values": [
              "selected-district"
            ]
          }
        },
        {
          "name": "existing_geoserver_reader",
          "permissions": [
            "select"
          ],
          "scope": null
        }
      ]
    }
  ]
