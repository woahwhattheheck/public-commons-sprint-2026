{
  "$schema": "https://frictionlessdata.io/schemas/datapackage.json",
  "name": "elite-digital-agency-open-datasets",
  "title": "Elite Digital Agency Open Knowledge Datasets",
  "description": "First-party published pricing, service catalogue and AI-crawler policy for Elite Digital AI Solutions Ltd. Amounts are the prices shown on the website on the capture date — not market estimates.",
  "homepage": "https://elitedigitalagency.io/open-data/",
  "version": "1.0.0",
  "created": "2026-08-12",
  "licenses": [
    {
      "name": "CC-BY-4.0",
      "path": "https://creativecommons.org/licenses/by/4.0/",
      "title": "Creative Commons Attribution 4.0 International"
    }
  ],
  "contributors": [
    {
      "title": "Elite Digital AI Solutions Ltd",
      "role": "publisher",
      "path": "https://elitedigitalagency.io/"
    }
  ],
  "sources": [
    {
      "title": "Elite Digital published pricing",
      "path": "https://elitedigitalagency.io/pricing/"
    },
    {
      "title": "robots.txt AI crawler policy",
      "path": "https://elitedigitalagency.io/robots.txt"
    }
  ],
  "resources": [
    {
      "name": "published-pricing",
      "path": "published-pricing.csv",
      "title": "Published service prices",
      "description": "GBP amounts as displayed on Elite Digital Agency pages. charity_amount_gbp is blank when no separate charity rate is published for that row.",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          { "name": "name", "type": "string", "title": "Price key" },
          { "name": "path", "type": "string", "title": "Site path" },
          { "name": "title", "type": "string", "title": "Label" },
          { "name": "amount_gbp", "type": "number", "title": "Amount (GBP)" },
          { "name": "charity_amount_gbp", "type": "number", "title": "Charity amount (GBP)" },
          { "name": "period", "type": "string", "title": "Period" },
          { "name": "display", "type": "string", "title": "Display string" },
          { "name": "source_url", "type": "string", "title": "Source URL" },
          { "name": "capture_date", "type": "date", "title": "Capture date" }
        ]
      }
    },
    {
      "name": "services-catalogue",
      "path": "services-catalogue.csv",
      "title": "Service catalogue",
      "description": "Every service, consultancy and charity offering with its canonical URL.",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          { "name": "slug", "type": "string", "title": "Slug" },
          { "name": "title", "type": "string", "title": "Title" },
          { "name": "short", "type": "string", "title": "Short description" },
          { "name": "section", "type": "string", "title": "Section" },
          { "name": "url", "type": "string", "title": "Canonical URL" }
        ]
      }
    },
    {
      "name": "ai-crawler-policy",
      "path": "ai-crawler-policy.csv",
      "title": "AI crawler allow-list",
      "description": "Named user-agents permitted in robots.txt, each with its own Content-Signal line.",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          { "name": "user_agent", "type": "string", "title": "User-agent" },
          { "name": "purpose", "type": "string", "title": "Purpose" },
          { "name": "allowed", "type": "string", "title": "Allowed" },
          { "name": "content_signal", "type": "string", "title": "Content-Signal" },
          { "name": "source_url", "type": "string", "title": "Source URL" },
          { "name": "capture_date", "type": "date", "title": "Capture date" }
        ]
      }
    }
  ]
}
