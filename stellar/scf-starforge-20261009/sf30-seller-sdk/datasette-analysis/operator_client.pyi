from dataclasses import dataclass
from pathlib import Path
from typing import Any, Callable, Literal, Mapping

JSON = dict[str, Any]
Action = Literal["prepare", "compare", "export", "nld.prepare", "nld.execute",
                 "nld.report", "nld.pack", "nld.restore"]

class DatasetteClientError(RuntimeError):
    code: str
    status: int | None
    request_id: str | None
    def __init__(self, code: str, message: str, *, status: int | None = ...,
                 request_id: str | None = ...) -> None: ...

@dataclass(frozen=True)
class OperatorConnection:
    origin: str
    capability: str
    operation_id: str | None = ...
    workspace_id: str | None = ...
    @classmethod
    def from_url(cls, value: str, *, operation_id: str | None = ...,
                 workspace_id: str | None = ...) -> OperatorConnection: ...
    @classmethod
    def from_workspace(cls, workspace: str | Path) -> OperatorConnection: ...

class DatasetteOperatorClient:
    connection: OperatorConnection
    timeout: float
    def __init__(self, connection: OperatorConnection, *, timeout: float = ...) -> None: ...
    @classmethod
    def from_workspace(cls, workspace: str | Path, **options: Any) -> DatasetteOperatorClient: ...
    def status(self) -> JSON: ...
    def analysis_state(self) -> JSON: ...
    def saved_query(self, name: str) -> JSON: ...
    def save_query(self, name: str, fields: JSON, *, expected_revision: int) -> JSON: ...
    def start_query(self, fields: JSON, *, job_id: str) -> JSON: ...
    def analysis_job(self, job_id: str) -> JSON: ...
    def rows(self, *, edition_id: str | None = ..., offset: int = ..., limit: int = ...) -> JSON: ...
    def nld_status(self, *, project_id: str | None = ...) -> JSON: ...
    def nld_rows(self, *, project_id: str, definition_id: str | None = ..., run_id: str | None = ...,
                 kind: Literal["source", "review", "target"] = ..., offset: int = ..., limit: int = ...) -> JSON: ...
    def submit(self, action: Action, body: Mapping[str, Any], *, request_id: str) -> JSON: ...
    def request(self, request_id: str) -> JSON: ...
    def resume(self, request_id: str) -> JSON: ...
    def wait(self, request_id: str, *, timeout: float = ...,
             progress: Callable[[JSON], None] | None = ...) -> JSON: ...
    def intake(self, path: str | Path) -> JSON: ...
    def download(self, name: str, destination: str | Path, *,
                 edition_id: str | None = ..., export_id: str | None = ...,
                 expected_sha256: str | None = ...) -> JSON: ...
