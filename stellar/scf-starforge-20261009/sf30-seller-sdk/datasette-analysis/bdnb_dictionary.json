  "semantics": {
    "geometry": "Original publisher Lambert-93/EPSG:2154 coordinates; no silent conversion to longitude/latitude. contains_fictive_geom_groupe labels generated geometry. Opaque/invalid geometries stay visible as original source records.",
    "weights": "poids_s_* and poids_nb_loc_* denominators are address totals across all served groups, not totals across the selected group's addresses. Preserve raw exact values and publisher meaning.",
    "scope": "Source descriptor coverage and selected territory define observation scope. Missing crosswalk rows do not prove creation/deletion; unchanged identifiers normally do not appear in the passage table.",
    "operatingContext": "Kestra Ntico case study documents S3 ingestion and Docker/custom logic; deployed namespace, bucket, credentials and plugin/version must be operator supplied."
  }
