        sh:description "A liability statement about the dataset that may clarify limitations of responsibility, qualifications on the accuracy, reliability, and completeness of the data, or absence of endorsement by the data publisher or provider, among other considerations" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat-us:LiabilityStatement ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:license ;
        sh:name "license" ;
        sh:description "License that governs how the dataset can be used or reused" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:LicenseDocument ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat-us:metadataDistribution ;
        sh:name "metadata distribution" ;
        sh:description "Distribution of the original metadata document this dataset was derived from" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Distribution ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:modified ;
        sh:name "last modified" ;
        sh:description "Most recent date when the dataset's actual data changed, not just metadata" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path adms:identifier ;
        sh:name "other identifier" ;
        sh:description "Additional identifiers for the dataset besides the main identifier, such as a DOI or other persistent ID" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class adms:Identifier ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path foaf:page ;
        sh:name "documentation" ;
        sh:description "List of pages or documents about this dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class foaf:Document ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:provenance ;
        sh:name "provenance" ;
        sh:description "List of statements about the lineage of a Dataset, including any changes in its ownership or custody since its creation that may be significant for its authenticity, integrity, or interpretation" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:ProvenanceStatement ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:publisher ;
        sh:name "publisher" ;
        sh:description "Organization responsible for publishing and making the dataset available" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class foaf:Agent ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat-us:purpose ;
        sh:name "purpose" ;
        sh:description "The purpose of the dataset" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path prov:qualifiedAttribution ;
        sh:name "qualified attribution" ;
        sh:description "List of agents with specific responsibilities for the dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class prov:Attribution ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:qualifiedRelation ;
        sh:name "qualified relation" ;
        sh:description "Detailed relationship between the dataset and another resource, including the role of that relationship" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Relationship ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:relation ;
        sh:name "related resource" ;
        sh:description "List of links to related resources when the relationship is not otherwise specified" ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:rights ;
        sh:name "rights" ;
        sh:description "Rights statements not already covered by license or accessRights, such as copyright or policy restrictions" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:RightsStatement ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path adms:sample ;
        sh:name "sample" ;
        sh:description "List of sample distributions for the dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Distribution ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path skos:scopeNote ;
        sh:name "usage note" ;
        sh:description "usage note for the dataset" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:name "data source" ;
        sh:description "List of related Datasets from which the described Dataset is derived" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Dataset ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:spatial ;
        sh:name "spatial/geographic coverage" ;
        sh:description "A geographic region or regions that are covered by the Dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:Location ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:spatialResolutionInMeters ;
        sh:name "Spatial resolution (meters)" ;
        sh:description "Smallest spatial distance between data points, in meters, represented as a single value" ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path adms:status ;
        sh:name "lifecycle status" ;
        sh:description "Lifecycle status of the dataset, such as completed, deprecated, under development, or withdrawn" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:subject ;
        sh:name "subject" ;
        sh:description "List of primary subjects for the dataset, usually narrower than broad theme categories" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:temporal ;
        sh:name "temporal coverage" ;
        sh:description "Time periods covered by the dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:PeriodOfTime ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:temporalResolution ;
        sh:name "temporal resolution" ;
        sh:description "Smallest time interval between data points, using xsd:duration format (for example, P1D)" ;
        sh:datatype xsd:duration ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:theme ;
        sh:name "theme/category" ;
        sh:description "List of themes or categories for the dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:title ;
        sh:name "title" ;
        sh:description "Human-readable title of the dataset" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcat-us:useRestriction ;
        sh:name "use restriction" ;
        sh:description "List of use restrictions related to the dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat-us:UseRestriction ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:version ;
        sh:name "version" ;
        sh:description "The version indicator (name or identifier) of a resource" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path adms:versionNotes ;
        sh:name "version notes" ;
        sh:description "Notes describing how this version differs from earlier versions of the dataset" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:name "was generated by" ;
        sh:description "List of activities that generated, or provide the business context for the creation of the dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
