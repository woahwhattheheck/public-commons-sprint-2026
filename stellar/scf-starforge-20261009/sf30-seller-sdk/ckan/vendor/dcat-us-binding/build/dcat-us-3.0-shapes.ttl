@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix cnt: <http://www.w3.org/2011/content#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcat-us: <http://resources.data.gov/ontology/dcat-us#> .
@prefix dcat-us-shp: <http://resources.data.gov/shapes/dcat-us#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sdmx-attribute: <http://purl.org/linked-data/sdmx/2009/attribute#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shp: <http://resources.data.gov/shapes/dcat-us#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<http://resources.data.gov/shapes/dcat-us>
    a <http://www.w3.org/2002/07/owl#Ontology> ;
    <http://purl.org/dc/terms/title> "DCAT-US 3.0 generated SHACL shapes" ;
    <http://purl.org/dc/terms/description> "Generated from the DCAT-US 3.0 JSON Schema definitions. Do not edit by hand: edit the schema and regenerate." .

shp:AccessRestrictionShape
    a sh:NodeShape ;
    sh:targetClass dcat-us:AccessRestriction ;
    sh:name "AccessRestriction" ;
    sh:description "Rules or indicators that describe who can access a resource" ;
    sh:property [
        sh:path dcat-us:restrictionNote ;
        sh:name "restriction note" ;
        sh:description "A note related to the access restriction" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat-us:restrictionStatus ;
        sh:name "restriction status" ;
        sh:description "The indication of whether or not there are access restrictions on the item, consider using a controlled vocabulary such as https://www.archives.gov/research/catalog/lcdrg/authority-lists/access-restriction-status" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcat-us:specificRestriction ;
        sh:name "specific restriction" ;
        sh:description "Authority, code list entry, or policy reference that defines the specific access restriction; consider using a controlled vocabulary such as the NARA https://www.archives.gov/research/catalog/lcdrg/authority-lists/specific-access-restriction" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] .

shp:ActivityShape
    a sh:NodeShape ;
    sh:targetClass prov:Activity ;
    sh:name "Activity" ;
    sh:description "An activity related to creating, changing, or using a resource" ;
    sh:property [
        sh:path dcterms:type ;
        sh:name "category" ;
        sh:description "List of categories for the Activity" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:name "label" ;
        sh:description "A human-readable label for the activity" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

shp:AddressShape
    a sh:NodeShape ;
    sh:targetClass locn:Address ;
    sh:name "Address" ;
    sh:description "A single physical address" ;
    sh:property [
        sh:path vcard:country-name ;
        sh:name "country" ;
        sh:description "The country of the Address" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path vcard:locality ;
        sh:name "locality" ;
        sh:description "The city of the Address" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path vcard:postal-code ;
        sh:name "postal code" ;
        sh:description "The postal code of the Address" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path vcard:region ;
        sh:name "administrative area" ;
        sh:description "The administrative area of the Address. Depending on the country, this corresponds to a province, a county, a region, or a state" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path vcard:street-address ;
        sh:name "street address" ;
        sh:description "The street name and civic number of an Address" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] .

shp:AgentShape
    a sh:NodeShape ;
    sh:targetClass foaf:Agent ;
    sh:name "Agent" ;
    sh:description "A person, organization, software agent, or other entity involved with a resource" ;
    sh:property [
        sh:path foaf:name ;
        sh:name "name" ;
        sh:description "The name of the agent" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

shp:AttributionShape
    a sh:NodeShape ;
    sh:targetClass prov:Attribution ;
    sh:name "Attribution" ;
    sh:description "A responsibility that an agent has for a resource" ;
    sh:property [
        sh:path prov:agent ;
        sh:name "agent" ;
        sh:description "The agent that plays a role in the resource" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class foaf:Agent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcat:hadRole ;
        sh:name "role" ;
        sh:description "The function of an entity or agent with respect to another entity or resource" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Role ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

shp:CUIRestrictionShape
    a sh:NodeShape ;
    sh:targetClass dcat-us:CuiRestriction ;
    sh:name "CUIRestriction" ;
    sh:description "Information describing Controlled Unclassified Information (CUI) restrictions for a resource" ;
    sh:property [
        sh:path dcat-us:cuiBannerMarking ;
        sh:name "CUI banner marking" ;
        sh:description "CUI (Controlled Unclassified Information) banner marking is required for any unclassified information that is deemed sensitive and requires protection; see information at https://www.archives.gov/cui/registry/category-marking-list" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcat-us:designationIndicator ;
        sh:name "CUI designation indicator" ;
        sh:description "Agency that designated the information as CUI; include at least \"Controlled by:\" and, when possible, contact information" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcat-us:requiredIndicatorPerAuthority ;
        sh:name "required indicator per authority" ;
        sh:description "List of free-text required indicators from the applicable authority (for example, category descriptions or distribution statements)" ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
    ] .

shp:CatalogShape
    a sh:NodeShape ;
    sh:targetClass dcat:Catalog ;
    sh:name "DCAT-US 3 Catalog" ;
    sh:description "A curated collection of metadata about datasets, data services, or other resources" ;
    sh:property [
        sh:path dcterms:accessRights ;
        sh:name "access rights" ;
        sh:description "Information about whether the catalog is publicly accessible, restricted, or not public" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:RightsStatement ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:catalog ;
        sh:name "Related catalogs" ;
        sh:description "List of related catalogs that are useful in the context of this catalog" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Catalog ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:type ;
        sh:name "category" ;
        sh:description "List of high-level categories for the catalog" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:conformsTo ;
        sh:name "schema version" ;
        sh:description "Standard, schema, profile, or model that this catalog follows" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:Standard ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:contactPoint ;
        sh:name "Contact points" ;
        sh:description "Contact information people can use to ask questions or send feedback about the catalog" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class vcard:Kind ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:creator ;
        sh:name "creator" ;
        sh:description "Person or organization responsible for creating the catalog metadata" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:Agent ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:dataset ;
        sh:name "dataset" ;
        sh:description "List of datasets included in the catalog. Use this together with service so the catalog is not empty." ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Dataset ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:name "description" ;
        sh:description "Plain-language summary of the catalog" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:hasPart ;
        sh:name "has part" ;
        sh:description "List of catalogs that are contained within this catalog" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Catalog ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path foaf:homepage ;
        sh:name "homepage" ;
        sh:description "Main public web page for the catalog, usually an HTML page" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class foaf:Document ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:name "identifier" ;
        sh:description "Main unique identifier for the catalog, such as a URI or another persistent identifier" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:issued ;
        sh:name "release date" ;
        sh:description "Date when the catalog was formally issued, such as its initial publication date" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:keyword ;
        sh:name "keyword/tag" ;
        sh:description "List of keywords or tags describing the catalog" ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:language ;
        sh:name "language" ;
        sh:description "Language codes used for catalog metadata text (such as titles and descriptions), using ISO 639-1 codes like en or es" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:LinguisticSystem ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:license ;
        sh:name "license" ;
        sh:description "License that governs how the catalog can be used or reused" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:LicenseDocument ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:modified ;
        sh:name "update/modification date" ;
        sh:description "Most recent date when the catalog content changed, not just catalog-record metadata" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:publisher ;
        sh:name "publisher" ;
        sh:description "Person or organization responsible for publishing and making the catalog available" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class foaf:Agent ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path prov:qualifiedAttribution ;
        sh:name "qualified attribution" ;
        sh:description "List of agents with specific responsibilities for the catalog" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class prov:Attribution ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:record ;
        sh:name "catalog record" ;
        sh:description "A catalog record describing how a single resource (such as a dataset or data service) is registered in the catalog" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:CatalogRecord ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:rights ;
        sh:name "rights" ;
        sh:description "Rights statements about the catalog that are not already covered by license or accessRights, such as copyright or policy restrictions" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:RightsStatement ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:rightsHolder ;
        sh:name "rights holder" ;
        sh:description "Organizations that hold rights in the catalog" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class org:Organization ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:service ;
        sh:name "service" ;
        sh:description "List of data services included in the catalog. Use this together with dataset so the catalog is not empty." ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:DataService ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:spatial ;
        sh:name "spatial/geographic coverage" ;
        sh:description "Geographic area covered by the catalog" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:Location ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:subject ;
        sh:name "subject" ;
        sh:description "List of subjects of the catalog" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:temporal ;
        sh:name "temporal coverage" ;
        sh:description "Time periods covered by the catalog" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:PeriodOfTime ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:theme ;
        sh:name "theme/category" ;
        sh:description "List of themes or categories for the catalog. A catalog can have more than one theme." ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:themeTaxonomy ;
        sh:name "themes" ;
        sh:description "Controlled vocabulary or taxonomy used to classify catalog resources, such as datasets and services" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:ConceptScheme ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:title ;
        sh:name "title" ;
        sh:description "Human-readable title of the catalog" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] .

shp:CatalogRecordShape
    a sh:NodeShape ;
    sh:targetClass dcat:CatalogRecord ;
    sh:name "CatalogRecord" ;
    sh:description "A record in a catalog, describing the registration of a single resource" ;
    sh:property [
        sh:path dcterms:conformsTo ;
        sh:name "application profile" ;
        sh:description "An Application Profile that the Catalog Record's metadata conforms to" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:Standard ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:name "Descriptions" ;
        sh:description "A list of free-text accounts of the catalog record" ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:issued ;
        sh:name "listing date" ;
        sh:description "List of dates on which the catalog record was included in the catalog" ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:language ;
        sh:name "language" ;
        sh:description "Language code used in catalog record metadata text, using ISO 639-1 values such as en or es, full list can be seen at https://id.loc.gov/vocabulary/iso639-1.html" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:LinguisticSystem ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:modified ;
        sh:name "update/modification date" ;
        sh:description "The most recent date on which the catalog record was changed or modified" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path foaf:primaryTopic ;
        sh:name "primary topic" ;
        sh:description "A link to the Dataset, Data service or Catalog described in the Catalog Record" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Resource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:name "source metadata" ;
        sh:description "The original metadata that was used in creating metadata for the items in the catalog record, either a URL referencing the source metadata or a string of the source metadata itself" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Resource ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path adms:status ;
        sh:name "change type" ;
        sh:description "The status of the catalog record in the context of editorial flow of the dataset and data service descriptions" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:title ;
        sh:name "title" ;
        sh:description "A name given to the Catalog Record" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] .

shp:ChecksumShape
    a sh:NodeShape ;
    sh:targetClass spdx:Checksum ;
    sh:name "Checksum" ;
    sh:description "A mechanism that can be used to verify that the contents of a distribution have not changed" ;
    sh:property [
        sh:path spdx:algorithm ;
        sh:name "algorithm" ;
        sh:description "The algorithm used to produce the checksum" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class spdx:ChecksumAlgorithm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path spdx:checksumValue ;
        sh:name "checksum value" ;
        sh:description "A lower case hexadecimal encoded digest value produced using a specific algorithm" ;
        sh:datatype xsd:hexBinary ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

shp:ConceptSchemeShape
    a sh:NodeShape ;
    sh:targetClass skos:ConceptScheme ;
    sh:name "ConceptScheme" ;
    sh:description "A controlled vocabulary or other list of approved terms for a concept" ;
    sh:property [
        sh:path dcterms:created ;
        sh:name "creation date" ;
        sh:description "The date on which the Concept Scheme was first created" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:name "description" ;
        sh:description "A description of the concept scheme" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:issued ;
        sh:name "publication date" ;
        sh:description "The date of formal issuance (e.g., publication) of the concept scheme" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:modified ;
        sh:name "update/modification date" ;
        sh:description "The most recent date at which the concept scheme was changed or modified" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:title ;
        sh:name "title" ;
        sh:description "The title of the concept scheme" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcat:version ;
        sh:name "version info" ;
        sh:description "A version number or other version designation of the concept scheme" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] .

shp:DataServiceShape
    a sh:NodeShape ;
    sh:targetClass dcat:DataService ;
    sh:name "DataService" ;
    sh:description "A service that provides access to data or data processing functions" ;
    sh:property [
        sh:path dcat-us:accessRestriction ;
        sh:name "access restriction" ;
        sh:description "List of access restrictions related to the data service" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat-us:AccessRestriction ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:accessRights ;
        sh:name "access rights" ;
        sh:description "Information about whether the data service is publicly accessible, restricted, or not public" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:RightsStatement ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:type ;
        sh:name "category" ;
        sh:description "List of high-level categories for the data service" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:conformsTo ;
        sh:name "conforms to" ;
        sh:description "List of general standards or specifications that the Data Service endpoints implement" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:Standard ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:contactPoint ;
        sh:name "contact point" ;
        sh:description "Contact information for questions about the Data Service. Include an email address that is continuously monitored" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class vcard:Kind ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcterms:created ;
        sh:name "creation date" ;
        sh:description "The date on which the Data Service was first created" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:creator ;
        sh:name "creator" ;
        sh:description "List of agents primarily responsible for producing the Data Service" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class foaf:Agent ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat-us:cuiRestriction ;
        sh:name "CUI restriction" ;
        sh:description "Controlled Unclassified Information restriction related to the data service" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat-us:CuiRestriction ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:name "description" ;
        sh:description "Plain-language summary of the data service" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:endpointDescription ;
        sh:name "endpoint description" ;
        sh:description "List of endpoint descriptions with operations and parameters (for example, OpenAPI or similar service documentation)" ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:endpointURL ;
        sh:name "endpoint URL" ;
        sh:description "A list of root locations or primary endpoints of the service (a Web-resolvable IRI)" ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dqv:hasQualityMeasurement ;
        sh:name "quality measurement" ;
        sh:description "Quality measurements for the data service (for example, availability, response time, or reliability)" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dqv:QualityMeasurement ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:name "identifier" ;
        sh:description "The unique identifier for the Data Service, e.g. the URI or other unique identifier in the context of the Catalog" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:keyword ;
        sh:name "keyword/tag" ;
        sh:description "List of keywords or tags describing the data service" ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:language ;
        sh:name "language" ;
        sh:description "ISO 639-1 language code values supported by the data service, such as en or es, full list can be seen at https://id.loc.gov/vocabulary/iso639-1.html" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:LinguisticSystem ;
