        sh:severity sh:Warning ;
    ] .

shp:DatasetSeriesShape
    a sh:NodeShape ;
    sh:targetClass dcat:DatasetSeries ;
    sh:name "DatasetSeries" ;
    sh:description "A group of related datasets that are published separately" ;
    sh:property [
        sh:path dcterms:accrualPeriodicity ;
        sh:name "frequency" ;
        sh:description "The frequency at which the Dataset Series is updated. This is the series update frequency, not necessarily each dataset's frequency" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:Frequency ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:contactPoint ;
        sh:name "contact point" ;
        sh:description "List of contacts people can use to ask questions or send feedback about the dataset series" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class vcard:Kind ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:name "description" ;
        sh:description "Plain-language summary of the dataset series" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcat:first ;
        sh:name "first" ;
        sh:description "The first dataset in an ordered dataset series" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Dataset ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:issued ;
        sh:name "release date" ;
        sh:description "Date when the Dataset Series was formally established or published, not the release date of the oldest dataset in the series" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:last ;
        sh:name "last" ;
        sh:description "The last dataset in an ordered dataset series" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Dataset ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:modified ;
        sh:name "update/modification date" ;
        sh:description "Most recent date when the Dataset Series changed, not the modified date of the newest dataset in the series" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:publisher ;
        sh:name "publisher" ;
        sh:description "Organization responsible for maintaining the Dataset Series as a coherent series; this may differ from publishers of individual datasets" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class foaf:Agent ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:seriesMember ;
        sh:name "series member" ;
        sh:description "List of members of the Dataset Series" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Dataset ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:spatial ;
        sh:name "spatial/geographic coverage" ;
        sh:description "A geographic region that is covered by the Dataset Series" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:Location ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:temporal ;
        sh:name "temporal coverage" ;
        sh:description "Time periods covered by the dataset series" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:PeriodOfTime ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:title ;
        sh:name "title" ;
        sh:description "Human-readable title of the dataset series" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

shp:DistributionShape
    a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    sh:name "Distribution" ;
    sh:description "A specific representation of a dataset, such as a file, feed, or API response" ;
    sh:property [
        sh:path dcat-us:accessRestriction ;
        sh:name "access restriction" ;
        sh:description "List of access restrictions related to the distribution" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat-us:AccessRestriction ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:accessRights ;
        sh:name "access rights" ;
        sh:description "Information about whether the distribution is publicly accessible, restricted, or not public" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:RightsStatement ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:accessService ;
        sh:name "access service" ;
        sh:description "A data service that gives access to the distribution of the dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:DataService ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:accessURL ;
        sh:name "access URL" ;
        sh:description "URL for indirect access to the Distribution (for example, a landing page, API docs, or request form), not a direct file download" ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:byteSize ;
        sh:name "byte size" ;
        sh:description "The size of a Distribution in bytes" ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path cnt:characterEncoding ;
        sh:name "character encoding" ;
        sh:description "List of character encodings used in the Distribution, using IANA character set names (for example, UTF-8)" ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path spdx:checksum ;
        sh:name "checksum" ;
        sh:description "Checksum used to verify that the downloadable file content has not changed" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class spdx:Checksum ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:compressFormat ;
        sh:name "compression format" ;
        sh:description "The format of the file in which the data is contained in a compressed form, e.g. to reduce the size of the downloadable file" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:MediaType ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:conformsTo ;
        sh:name "linked schemas" ;
        sh:description "List of standards, schemas, or reference systems the Distribution follows (prefer stable URIs when available)" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:Standard ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat-us:cuiRestriction ;
        sh:name "CUI restriction" ;
        sh:description "Controlled Unclassified Information restriction related to the distribution" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat-us:CuiRestriction ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat-us:describedBy ;
        sh:name "data dictionary" ;
        sh:description "A distribution containing the Data Dictionary for this distribution" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Distribution ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:name "description" ;
        sh:description "Plain-language summary of the distribution" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:downloadURL ;
        sh:name "download URL" ;
        sh:description "Direct URL to a downloadable file for the Distribution; use accessURL for indirect access" ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:format ;
        sh:name "format" ;
        sh:description "A human-readable description of the file format of the Distribution that provides useful information that might not be apparent from mediaType" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:MediaType ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dqv:hasQualityMeasurement ;
        sh:name "quality measurement" ;
        sh:description "Quality measurements for the distribution (for example, completeness, accuracy, or timeliness)" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dqv:QualityMeasurement ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:name "identifier" ;
        sh:description "The unique identifier for the Distribution (e.g. DOI, ISBN)" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path schema:image ;
        sh:name "image" ;
        sh:description "A link to a thumbnail picture illustrating the content of the distribution" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class schema:ImageObject ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:issued ;
        sh:name "release date" ;
        sh:description "The date of formal issuance (e.g., publication) of the Distribution" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:language ;
        sh:name "language" ;
        sh:description "ISO 639-1 language code values used in the distribution metadata text, such as en or es, full list can be seen at https://id.loc.gov/vocabulary/iso639-1.html" ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:license ;
        sh:name "license" ;
        sh:description "License that governs how the distribution can be used or reused" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:LicenseDocument ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:mediaType ;
        sh:name "media type" ;
        sh:description "MIME type of the Distribution (for example, text/csv or application/json), from the IANA media types registry: https://www.iana.org/assignments/media-types/media-types.xhtml" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:MediaType ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:modified ;
        sh:name "last modified" ;
        sh:description "The most recent date on which the Distribution was changed or modified" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:packageFormat ;
        sh:name "packaging format" ;
        sh:description "The format of the file in which one or more data files are grouped together, e.g. to enable a set of related files to be downloaded together" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:MediaType ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path foaf:page ;
        sh:name "documentation" ;
        sh:description "A page or document about this Distribution" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class foaf:Document ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path adms:representationTechnique ;
        sh:name "representation technique" ;
        sh:description "Method or schema used to structure the distribution content (for example, CSV convention, XML schema, or spatial representation type)" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:rights ;
        sh:name "rights" ;
        sh:description "Rights statements not already covered by license or accessRights, such as copyright or policy restrictions" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:RightsStatement ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:spatialResolutionInMeters ;
        sh:name "Spatial resolution (meters)" ;
        sh:description "The minimum spatial separation resolvable in a dataset distribution, measured in meters" ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path adms:status ;
        sh:name "lifecycle status" ;
        sh:description "The status of the distribution in the context of maturity lifecycle" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:temporalResolution ;
        sh:name "termporal resolution" ;
        sh:description "The minimum time period resolvable in the dataset distribution" ;
        sh:datatype xsd:duration ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:title ;
        sh:name "title" ;
        sh:description "Human-readable title of the distribution" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat-us:useRestriction ;
        sh:name "use restriction" ;
        sh:description "List of use restrictions related to the distribution" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat-us:UseRestriction ;
        sh:severity sh:Warning ;
    ] .

shp:DocumentShape
    a sh:NodeShape ;
    sh:targetClass foaf:Document ;
    sh:name "Document" ;
    sh:description "A publication or other document related to a resource" ;
    sh:property [
        sh:path dcterms:abstract ;
        sh:name "abstract" ;
        sh:description "Text abstract of the Document" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:bibliographicCitation ;
        sh:name "bibliographic citation" ;
        sh:description "Bibliographic citation as text" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:name "conforms to" ;
        sh:description "List of standards or specifications the document follows" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:Standard ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:creator ;
        sh:name "author" ;
        sh:description "The individual(s) responsible for creating the Document" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class org:Organization ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:name "description" ;
        sh:description "Plain-language summary of the document" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:name "identifier" ;
        sh:description "The unique identifier for the Document (e.g. DOI, ISBN)" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:issued ;
        sh:name "publication date" ;
        sh:description "Publication date of the Document" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:mediaType ;
        sh:name "media type" ;
        sh:description "The file format of the Document as defined in the official register of media types managed by IANA: https://www.iana.org/assignments/media-types/media-types.xhtml" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:MediaType ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dc:publisher ;
        sh:name "publisher" ;
        sh:description "The organization(s) that published the Document" ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:title ;
        sh:name "title" ;
        sh:description "The title of the Document" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

shp:KindShape
    a sh:NodeShape ;
    sh:targetClass vcard:Kind ;
    sh:name "Kind" ;
    sh:description "Contact information for an individual or entity" ;
    sh:property [
        sh:path vcard:address ;
        sh:name "address" ;
        sh:description "The address of the contact" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class vcard:Address ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path vcard:family-name ;
        sh:name "family name" ;
        sh:description "The family name of the contact" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path vcard:fn ;
        sh:name "formatted name" ;
        sh:description "The formatted text of the name of the contact" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path vcard:given-name ;
        sh:name "given name" ;
        sh:description "The given name of the contact" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path vcard:hasEmail ;
        sh:name "Email" ;
        sh:description "Email address for the contact in mailto: format (for example, mailto:support@example.gov)" ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path vcard:organization-name ;
        sh:name "organization name" ;
        sh:description "The name of the organization to contact" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path vcard:tel ;
        sh:name "telephone" ;
        sh:description "The telephone number for the contact" ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path vcard:title ;
        sh:name "position title" ;
        sh:description "The position role of the person to contact" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] .

shp:LocationShape
    a sh:NodeShape ;
    sh:targetClass dcterms:Location ;
    sh:name "Location" ;
    sh:description "A named place or geographic area" ;
    sh:property [
        sh:path dcat:bbox ;
        sh:name "bounding box" ;
        sh:description "Bounding box for the location, described in WKT, GeoJSON, or GML format" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:centroid ;
        sh:name "centroid" ;
        sh:description "The geographic center (centroid) of a location described in WKT, GeoJSON, or GML format" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path locn:geometry ;
        sh:name "geometry" ;
        sh:description "Associates a location with a corresponding geometry described in WKT, GeoJSON, or GML format" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class locn:Geometry ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:name "identifier" ;
        sh:description "The unique geographic identifier for the Location, e.g., the URI or other unique identifier in the context of the relevant gazetteer" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:name "gazetteer" ;
        sh:description "The gazetteer to which the location belongs" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:ConceptScheme ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] .

shp:MetricShape
    a sh:NodeShape ;
    sh:targetClass dqv:Metric ;
    sh:name "Metric" ;
    sh:description "A standard used to measure one aspect of data quality" ;
    sh:property [
        sh:path skos:definition ;
        sh:name "definition" ;
        sh:description "Definition of the metric." ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dqv:expectedDataType ;
        sh:name "expected datatype" ;
        sh:description "Represents the expected data type for the metric's observed value (e.g., xsd:boolean, xsd:double etc...)" ;
        sh:datatype xsd:anySimpleType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dqv:inDimension ;
        sh:name "in dimension" ;
        sh:description "Represents the dimensions a quality metric, certificate and annotation allow a measurement of." ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dqv:Dimension ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

shp:OrganizationShape
    a sh:NodeShape ;
    sh:targetClass org:Organization ;
    sh:name "Organization" ;
    sh:description "An organization involved with a resource, including parent or child organizations" ;
    sh:property [
        sh:path skos:altLabel ;
        sh:name "alternative label" ;
        sh:description "alternative name (trading name, colloquial name) for an organization" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path foaf:name ;
        sh:name "name" ;
        sh:description "The full name of the Organization" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path skos:notation ;
        sh:name "notation" ;
        sh:description "List of abbreviations or codes from code lists for an organization (e.g. DOI, DOD)" ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:name "preferred label" ;
        sh:description "Preferred or legal name of the organization" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path org:subOrganizationOf ;
        sh:name "suborganization of" ;
        sh:description "Represents hierarchical containment of Organizations or OrganizationalUnits; indicates an Organization which contains this Organization" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class org:Organization ;
        sh:severity sh:Warning ;
    ] .

shp:PeriodOfTimeShape
    a sh:NodeShape ;
    sh:targetClass dcterms:PeriodOfTime ;
    sh:name "PeriodOfTime" ;
    sh:description "Information about a specific time period with a start- and/or end-time" ;
    sh:property [
        sh:path dcat:endDate ;
        sh:name "end date" ;
        sh:description "The end date of the period of time" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:startDate ;
        sh:name "start date" ;
        sh:description "The start date of the period of time" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] .

shp:QualityMeasurementShape
    a sh:NodeShape ;
    sh:targetClass dqv:QualityMeasurement ;
    sh:name "QualityMeasurement" ;
    sh:description "A measurement of a resource against a specific quality metric" ;
    sh:property [
        sh:path dqv:isMeasurementOf ;
        sh:name "is measurement of" ;
        sh:description "The metric being observed" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dqv:Metric ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path sdmx-attribute:unitMeasure ;
        sh:name "unit of measure" ;
        sh:description "Unit of measure associated with the value" ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dqv:value ;
        sh:name "value" ;
        sh:description "The value computed by metric" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

shp:RelationshipShape
    a sh:NodeShape ;
    sh:targetClass dcat:Relationship ;
    sh:name "Relationship" ;
    sh:description "Additional information about how one resource is related to another" ;
    sh:property [
        sh:path dcat:hadRole ;
        sh:name "role" ;
        sh:description "The function of an entity or agent with respect to a dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Role ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcterms:relation ;
        sh:name "relation" ;
        sh:description "The entity related to the dataset. This string should unambiguously identify the related resource using an appropriate identifier." ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

shp:StandardShape
    a sh:NodeShape ;
    sh:targetClass dcterms:Standard ;
    sh:name "Standard" ;
    sh:description "A standard or specification that another resource conforms to" ;
    sh:property [
        sh:path dcterms:created ;
        sh:name "creation date" ;
        sh:description "The date on which the Standard has been first created" ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:name "description" ;
        sh:description "Plain-language summary of the standard" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:name "identifier" ;
        sh:description "The unique identifier for the Standard, e.g. the URI or other unique identifier in the context of the Catalog" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:name "in scheme" ;
        sh:description "The reference register to which the Standard belongs" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:ConceptScheme ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:issued ;
        sh:name "issued" ;
        sh:description "The date of formal issuance (e.g., publication) of the Standard" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:modified ;
        sh:name "last modified" ;
        sh:description "The most recent date on which the Standard was changed or modified" ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:title ;
        sh:name "title" ;
        sh:description "Human-readable title of the standard" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] .

shp:UseRestrictionShape
    a sh:NodeShape ;
    sh:targetClass dcat-us:UseRestriction ;
    sh:name "UseRestriction" ;
    sh:description "Rules or legal limits on how a resource may be used" ;
    sh:property [
        sh:path dcat-us:restrictionNote ;
        sh:name "restriction note" ;
        sh:description "Significant information pertaining to the use or reproduction of the data" ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat-us:restrictionStatus ;
        sh:name "restriction status" ;
        sh:description "Indication of whether or not there are use restrictions on the archival materials, consider using a controlled vocabulary such as https://www.archives.gov/research/catalog/lcdrg/authority-lists/use-restriction-status" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcat-us:specificRestriction ;
        sh:name "specific restriction" ;
        sh:description "Authority, code list entry, or policy reference that defines the specific use restriction; consider using a controlled vocabulary such as the NARA https://www.archives.gov/research/catalog/lcdrg/authority-lists/specific-use-restriction" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] .

