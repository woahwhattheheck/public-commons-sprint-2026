shp:DatasetShape
    a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:name "Dataset" ;
    sh:description "A collection of data published or curated by one provider" ;
    sh:property [
        sh:path dcat-us:accessRestriction ;
        sh:name "access restriction" ;
        sh:description "List of access restrictions related to the dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat-us:AccessRestriction ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:accessRights ;
        sh:name "access rights" ;
        sh:description "Information about whether the dataset is publicly accessible, restricted, or not public" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:RightsStatement ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:accrualPeriodicity ;
        sh:name "frequency" ;
        sh:description "The frequency at which the Dataset is updated" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:Frequency ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:type ;
        sh:name "category" ;
        sh:description "List of high-level categories for the dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class skos:Concept ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:conformsTo ;
        sh:name "conforms to" ;
        sh:description "List of standards, schemas, or profiles the dataset follows" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:Standard ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:contactPoint ;
        sh:name "contact point" ;
        sh:description "A contact point for questions about the Dataset (single contact or list). Include an email address that is continuously monitored" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class vcard:Kind ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcterms:contributor ;
        sh:name "contributor" ;
        sh:description "List of agents contributing to the Dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class foaf:Agent ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:creator ;
        sh:name "creator" ;
        sh:description "Person or organization responsible for creating the dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class foaf:Agent ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat-us:cuiRestriction ;
        sh:name "CUI restriction" ;
        sh:description "Controlled Unclassified Information restriction related to the dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat-us:CuiRestriction ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat-us:describedBy ;
        sh:name "data dictionary" ;
        sh:description "A distribution describing the Data Dictionary for this dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Distribution ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:name "description" ;
        sh:description "Plain-language summary of the dataset" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcat:distribution ;
        sh:name "dataset distribution" ;
        sh:description "List of available distributions for the dataset. This can be omitted when no distribution is available yet." ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcat:Distribution ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dqv:hasQualityMeasurement ;
        sh:name "quality measurement" ;
        sh:description "List of quality measurements for the dataset (for example, completeness, accuracy, or timeliness) beyond spatial or temporal resolution" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dqv:QualityMeasurement ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:hasVersion ;
        sh:name "has version" ;
        sh:description "List of related Datasets that are a version, edition, or adaptation of the described Dataset" ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:name "identifier" ;
        sh:description "The unique identifier for the Dataset, e.g. the URI or other unique identifier in the context of the Catalog" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path schema:image ;
        sh:name "image" ;
        sh:description "Thumbnail image illustrating the dataset, especially useful for visual data such as maps, photos, or video" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:isReferencedBy ;
        sh:name "is referenced by" ;
        sh:description "List of links to related resources, such as publications, that reference, cite, or otherwise point to the Dataset" ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:issued ;
        sh:name "release date" ;
        sh:description "Date when the dataset was first published. If the exact publication date is unknown, use the date it was first referenced in the catalog." ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:keyword ;
        sh:name "keyword/tag" ;
        sh:description "List of keywords or tags describing the dataset" ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat:landingPage ;
        sh:name "landing page" ;
        sh:description "A web page from the original data provider that gives access to the Dataset, its Distributions, and related information" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class foaf:Document ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:language ;
        sh:name "language" ;
        sh:description "ISO 639-1 language code values used in the dataset text or metadata, such as en or es, full list can be seen at https://id.loc.gov/vocabulary/iso639-1.html" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class dcterms:LinguisticSystem ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcat-us:liabilityStatement ;
