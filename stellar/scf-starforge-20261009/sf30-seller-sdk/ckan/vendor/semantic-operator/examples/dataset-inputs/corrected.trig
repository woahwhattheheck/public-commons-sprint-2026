# Authored development derivation; not an SAIC ontology or observed operation.
# Corrected authored edition: move computedOn and a ground conformance triple;
# change the explicit decimal lexeme and the empty IRI graph name.
# Vocabulary and example identifiers follow the unchanged retained W3C
# reference/w3c/examples/conformance-standards.trig. These statements are ours.
@prefix : <https://dcat.example.org/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Dataset a dcat:Dataset ;
  dct:title "Authored retained-example derivation"@en ;
  prov:wasUsedBy _:activity .
_:activity a prov:Activity ; prov:generated :testResult .

:testResult {
  :Dataset dqv:hasQualityMeasurement _:measurement ;
    dqv:hasQualityAnnotation _:annotation ;
    :reviewedBy _:activity .
  _:measurement a dqv:QualityMeasurement ; dqv:value "075.0"^^xsd:decimal ; dqv:computedOn :Dataset .
  _:annotation a dqv:QualityAnnotation .
  :Dataset dct:conformsTo :conformanceTest .
}
:qualityDetails {
  _:measurement dqv:isMeasurementOf :levelOfComplianceToDWBP .
  _:annotation rdfs:label "Awaiting explanation"@en .
  :Dataset :sharesBlankGraph _:named .
}
_:named { _:activity :basis :Dataset . }
:emptyReviewed {}
_:isolated {}
