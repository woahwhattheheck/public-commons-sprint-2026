{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original Carbon customer workspaces",
  "type": "object",
  "required": [
    "schema",
    "workspaces"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "stellar-forge.carbon-customer-connection.v1"
    },
    "workspaces": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "directory",
          "workspaceId"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "stellarcarbon",
              "givecredit"
            ]
          },
          "label": {
            "type": "string"
          },
          "directory": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "mode": {
            "enum": [
              "managed",
              "owned"
            ],
            "default": "managed"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "files": {
            "type": "object",
            "maxProperties": 256,
            "additionalProperties": {
              "type": "string"
            }
          },
          "accountingDirectory": {
            "type": "string"
          },
          "accountingWorkspaceId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "accountingSourcesSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "destinations": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
