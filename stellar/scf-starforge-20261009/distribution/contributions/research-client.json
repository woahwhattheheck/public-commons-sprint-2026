  "commandDescriptions": {
    "research-client": "Operate the Research listener, source and eligibility reviews, study extraction, evidence tables, appraisals, customer updates, Documents/Pipelines, and complete receiving",
    "research-crossref-documents": "Import original Crossref metadata files with exact documentary provenance into a Research edition",
    "research-citation-workflow": "Run original citation review, browser draft recovery, revision reports and complete portable reopening",
    "research-citation-python-receive": "Receive a saved citation review through Python, full revision reports, Analysis/workbook and complete customer reopening",
    "research-europe-pmc": "Operate saved literature queries, original Europe PMC pages, edition comparison, record review and complete dossier/workspace receiving",
    "research-template-exchange": "Map a customer workbook to a reviewed publication, receive returned edits and recover the original reviewer draft.",
    "research-study-protocol": "Capture the registered study protocol, receive it into the existing Research question, and preserve the complete selected engine for customer delivery.",
    "research-protocol-review": "Inspect the original registered protocol, retain the complete question preview and recover its exact SourceBundle request on the existing Research workspace.",
    "research-ris": "Review original RIS sources, recover saved requests and export complete source editions through the existing Research listener.",
    "research-ris-receiving": "Run the selected complete RIS browser, Merchant and cold receiving operation with its exact original source and request identities."
  },
