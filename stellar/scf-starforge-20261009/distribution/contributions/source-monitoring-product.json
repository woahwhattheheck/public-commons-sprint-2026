      "types": "./source/products/source-monitoring/agent-client.d.mts",
      "import": "./source/products/source-monitoring/agent-client.mjs"
    },
    "./source-monitoring/customer-setup": {
      "types": "./source/products/source-monitoring/customer-setup.d.mts",
      "import": "./source/products/source-monitoring/customer-setup.mjs"
    },
    "./source-monitoring/receiving/customer-agent": {
      "types": "./source/products/source-monitoring/receiving/customer-agent.d.mts",
