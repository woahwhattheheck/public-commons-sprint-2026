{
  "schema": "stellar-forge.merchant-distribution-contribution.v1",
  "id": "source-tables",
  "description": "Prepare original tables, retain reviewed cell corrections and row exclusions, compare editions and deliver merchant workspaces",
  "supportFiles": [
    "stellar-forge/developer-site/dist/source-table-workspace.mjs",
    "stellar-forge/developer-site/dist/source-table-cli.mjs",
    "stellar-forge/developer-site/dist/source-tables.html",
    "stellar-forge/developer-site/dist/source-tables.css",
    "stellar-forge/developer-site/dist/source-tables.mjs",
    "stellar-forge/developer-site/dist/source-table-workspace.d.mts",
    "stellar-forge/developer-site/SOURCE_TABLES.md",
    "stellar-forge/developer-site/serve.mjs",
    "stellar-forge/developer-site/browser-assets.json",
    "stellar-forge/developer-site/source-table-application.mjs",
    "products/source-tables/OPERATING.md",
    "stellar-forge/developer-site/dist/source-document-tables.mjs",
    "stellar-forge/developer-site/dist/source-document-tables.d.mts",
    "stellar-forge/developer-site/examples/document-tables/wago221-document-source.json",
    "stellar-forge/developer-site/examples/document-tables/wago221-table-selections.json",
    "stellar-forge/developer-site/examples/document-tables/receive-wago221.mjs",
    "stellar-forge/developer-site/dist/source-table-intake.mjs",
    "stellar-forge/developer-site/dist/source-table-intake.d.mts",
    "stellar-forge/developer-site/dist/source-table-corrections.mjs",
    "stellar-forge/developer-site/dist/source-delimited.mjs",
    "products/source-tables/PACKAGE_README.md"
  ],
  "commands": {
    "source-tables": "stellar-forge/developer-site/dist/source-table-cli.mjs"
  },
  "commandDescriptions": {
    "source-tables": "Import delimited text or explicitly selected document tables, review mappings, compare retained editions, reopen projects and export native merchant workspaces; serve opens the local workbench; records/correct/corrections retain explicit source decisions"
  },
  "exports": {
    "./source-tables": {
      "types": "./source/stellar-forge/developer-site/dist/source-table-workspace.d.mts",
      "default": "./source/stellar-forge/developer-site/dist/source-table-workspace.mjs"
    },
    "./source-document-tables": {
      "types": "./source/stellar-forge/developer-site/dist/source-document-tables.d.mts",
      "default": "./source/stellar-forge/developer-site/dist/source-document-tables.mjs"
    },
    "./source-table-intake": {
      "types": "./source/stellar-forge/developer-site/dist/source-table-intake.d.mts",
      "default": "./source/stellar-forge/developer-site/dist/source-table-intake.mjs"
    }
  },
  "browserAssets": [
    {
      "server": "stellar-forge/developer-site/serve.mjs",
      "manifest": "stellar-forge/developer-site/browser-assets.json"
    }
  ],
  "applicationProviders": {
    "source-tables": "stellar-forge/developer-site/source-table-application.mjs"
  }
}
