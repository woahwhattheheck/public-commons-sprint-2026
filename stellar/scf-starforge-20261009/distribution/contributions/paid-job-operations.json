    "jobs-merchant-receive": "stellar/scf-starforge-20261009/sf30-seller-sdk/jobs/managed/receiving.mjs"
  },
  "commandDescriptions": {
    "jobs-resolution": "Triage paid-job issues, recover delivery, record adjustments and export resolution records",
    "jobs-buyer-resolution": "Inspect, refresh, receive and export support for the original retained customer job",
    "jobs-merchant-receive": "Receive the original merchant through Applications and reopen its completed jobs"
