    },
    "./seller/jobs/resolution": {
      "types": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/jobs/resolution/index.d.mts",
      "import": "./source/stellar/scf-starforge-20261009/sf30-seller-sdk/jobs/resolution/index.mjs"
    },
    "./buyer/job-workspace/resolution": {
      "types": "./source/stellar/scf-starforge-20261009/sf88-operator-buyer-cli/job-workspace/resolution/index.d.mts",
