{
  "schema": "stellar-forge.merchant-distribution-contribution.v1",
  "id": "paid-job-operations",
  "description": "Operate the original paid-job merchant through Applications, receive input files and resolve retained customer jobs.",
  "commands": {
    "jobs-resolution": "stellar/scf-starforge-20261009/sf30-seller-sdk/jobs/resolution/cli.mjs",
