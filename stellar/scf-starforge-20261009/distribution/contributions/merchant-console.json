    "stellar-forge/mcp-merchant-operator/console/APPLICATIONS.md",
    "stellar-forge/mcp-merchant-operator/console/WORKFLOW_SERIES.md",
    "stellar-forge/mcp-merchant-operator/console/workflow-series-client.d.mts",
    "stellar-forge/mcp-merchant-operator/console/workflow-series-handover.d.mts",
    "stellar-forge/mcp-merchant-operator/console/WORKFLOW_REPORTS.md",
    "stellar-forge/mcp-merchant-operator/console/workflow-report-client.d.mts",
    "stellar-forge/mcp-merchant-operator/console/WORKFLOW_INSTALLATIONS.md",
