{
  "schema": "stellar-forge.merchant-distribution-contribution.v1",
  "id": "merchant-console",
  "description": "Saved merchant operator requests, native returns and complete customer receiving",
  "commands": {
    "merchant-console-application-receive": "stellar-forge/mcp-merchant-operator/receiving/console-applications.mjs",
    "merchant-workflow-series": "stellar-forge/mcp-merchant-operator/console/workflow-series-cli.mjs",
