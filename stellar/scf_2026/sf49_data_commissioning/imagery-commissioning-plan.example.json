{
  "title": "Customer imagery deployment access",
  "approvalId": "eoapi-policy-approval-REPLACE_WITH_SAVED_APPROVAL",
  "target": "deployment",
  "minimumIntervalMs": 1000,
  "cases": [
    {
      "id": "public-root",
      "title": "Approved public catalog root",
      "principal": "anonymous",
      "request": {
        "url": "https://catalog.example.invalid/stac",
        "method": "GET",
        "headers": {
          "accept": "application/json"
        }
      },
      "expect": {
        "statuses": [
          200
        ],
        "documentType": "Catalog"
      }
    },
    {
      "id": "anonymous-search",
      "title": "Anonymous access to the private collection",
      "principal": "anonymous",
      "request": {
        "url": "https://catalog.example.invalid/stac/search",
        "method": "POST",
        "headers": {
          "accept": "application/geo+json, application/json",
          "content-type": "application/json"
        },
        "body": {
          "collections": [
            "REPLACE_WITH_REVIEWED_COLLECTION"
          ],
          "limit": 10
        }
      },
      "expect": {
        "statuses": [
          401
        ]
      }
    },
    {
      "id": "customer-reader-search",
      "title": "Approved reader collection selection",
      "principal": "customerReader",
      "request": {
        "url": "https://catalog.example.invalid/stac/search",
        "method": "POST",
        "headers": {
          "accept": "application/geo+json, application/json",
          "content-type": "application/json"
        },
        "body": {
          "collections": [
            "REPLACE_WITH_REVIEWED_COLLECTION"
          ],
          "bbox": [
            -97.85,
            30.15,
            -97.55,
            30.45
          ],
          "datetime": "2026-09-01T00:00:00Z/2026-09-30T23:59:59Z",
          "limit": 10
        }
      },
      "expect": {
        "statuses": [
          200
        ],
        "documentType": "FeatureCollection",
        "allowedCollections": [
          "REPLACE_WITH_REVIEWED_COLLECTION"
        ]
      }
    }
  ]
}
