{
  "schema": "munibilling-native-file-contracts/v1",
  "captured_on": "2026-10-11",
  "contract_kind": "Published configurable import/export field dictionary; not a tenant-specific import template or provider API.",
  "type_policy": "Field names and SQL types retain the provider spelling. Nullability, required fields, enum values, relationships and date serialization are unspecified unless separately stated. Preserve decimal values and external account identifiers as text during transfer.",
  "native_source_notes": [
    "The Customer and Bills native HTML each end their published table in a partial type-only row; these unresolved fields are excluded rather than assigned a name.",
    "The customer overview declares account_number but its captured detailed table does not provide that field type.",
    "Payments publishes both rate_mulitiplier and rate_multiplier; retain both distinct native spellings.",
    "Payments start_reading/end_reading/consumption types are decimal(16,2), whereas meter readings use decimal(16,6).",
    "Bills flat_fee is published as tinyint(1); do not substitute a monetary amount type."
  ],
  "exclude_from_operational_presets": [
    "encrypted_password",
    "reset_password_token",
    "unlock_token",
    "confirmation_token",
    "authentication_token",
    "current_sign_in_ip",
    "last_sign_in_ip"
  ],
