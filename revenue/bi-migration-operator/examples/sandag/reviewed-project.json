      ],
      "measures": [
        {
          "name": "Detailed Group A",
          "dax_expression": "VAR HasRegion = CONTAINS(VALUES('Jurisdictions'[Jurisdiction ID]), 'Jurisdictions'[Jurisdiction ID], \"san-diego-region\")\nVAR HasSheriff = CONTAINS(VALUES('Jurisdictions'[Jurisdiction ID]), 'Jurisdictions'[Jurisdiction ID], \"sheriff-total\")\nVAR SelectedUnits = FILTER('Jurisdictions', 'Jurisdictions'[Jurisdiction ID] <> \"san-diego-region\" && (NOT HasSheriff || NOT 'Jurisdictions'[Is Sheriff Component]))\nRETURN IF(HasRegion, CALCULATE(SUM('OffenseCells'[Value]), REMOVEFILTERS('Jurisdictions'), 'OffenseCells'[Regional Group Component] = TRUE(), 'OffenseCells'[Group] = \"A\"), CALCULATE(SUM('OffenseCells'[Value]), KEEPFILTERS(SelectedUnits), 'OffenseCells'[Offense Level] = \"group_total\", 'OffenseCells'[Group] = \"A\"))",
          "format_string": "#,0"
        },
        {
          "name": "Detailed minus Published A",
          "dax_expression": "IF(NOT ISBLANK([Detailed Group A]) && NOT ISBLANK([Published Group A]), [Detailed Group A] - [Published Group A])",
          "format_string": "#,0"
        },
        {
          "name": "Detailed Group B",
          "dax_expression": "VAR HasRegion = CONTAINS(VALUES('Jurisdictions'[Jurisdiction ID]), 'Jurisdictions'[Jurisdiction ID], \"san-diego-region\")\nVAR HasSheriff = CONTAINS(VALUES('Jurisdictions'[Jurisdiction ID]), 'Jurisdictions'[Jurisdiction ID], \"sheriff-total\")\nVAR SelectedUnits = FILTER('Jurisdictions', 'Jurisdictions'[Jurisdiction ID] <> \"san-diego-region\" && (NOT HasSheriff || NOT 'Jurisdictions'[Is Sheriff Component]))\nRETURN IF(HasRegion, CALCULATE(SUM('OffenseCells'[Value]), REMOVEFILTERS('Jurisdictions'), 'OffenseCells'[Regional Group Component] = TRUE(), 'OffenseCells'[Group] = \"B\"), CALCULATE(SUM('OffenseCells'[Value]), KEEPFILTERS(SelectedUnits), 'OffenseCells'[Offense Level] = \"group_total\", 'OffenseCells'[Group] = \"B\"))",
          "format_string": "#,0"
        },
        {
          "name": "Reported source cells",
          "dax_expression": "CALCULATE(COUNTROWS('OffenseCells'), KEEPFILTERS('OffenseCells'[Value State] = \"reported\"))",
          "format_string": "#,0"
        },
        {
          "name": "Other source states",
          "dax_expression": "CALCULATE(COUNTROWS('OffenseCells'), KEEPFILTERS('OffenseCells'[Value State] <> \"reported\"))",
          "format_string": "#,0"
        }
      ]
    },
