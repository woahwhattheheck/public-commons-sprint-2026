    {
      "id": "shared-sql",
      "label": "Reporting by report runs",
      "match": {
        "service": "Microsoft.Sql"
      },
      "method": "usage",
      "metric": "runs",
      "usage_key": "/subscriptions/example-subscription/resourceGroups/example-bi/providers/Microsoft.Sql/servers/shared"
    },
    {
      "id": "shared-storage",
      "label": "Storage by retained GB-months",
      "match": {
        "service": "Microsoft.Storage"
      },
      "method": "usage",
      "metric": "gb_months",
      "usage_key": "report-storage"
    },
    {
      "id": "shared-support",
      "label": "Shared support by agreed weight",
      "match": {
        "service": "Support"
      },
      "method": "fixed",
      "shares": [
        {
          "agency_id": "billing-example-agency-01",
